{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mythcanvas.local/schemas/norse/m01/artwork.schema.json",
  "title":"MythCanvas M01 Per-Card Artwork Data",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","cardId","categoryCode","mythologyCode","seriesCode","seriesLabel","styleCode","styleName","cardNumber","type","slug","titleZh","titleEn","description","roleInSeries","storyIds","sourceRefs","visualThesis","prompt","output","qa"],
  "properties":{
    "schemaVersion":{"type":"string","const":"4.0"},"cardId":{"type":"integer","minimum":1003010001,"maximum":1003019950},"categoryCode":{"type":"integer","const":10},"mythologyCode":{"type":"integer","const":3},"seriesCode":{"type":"integer","const":1},"seriesLabel":{"type":"string","const":"M01"},"styleCode":{"type":"integer","minimum":0,"maximum":99},"styleName":{"type":"string","minLength":1},"cardNumber":{"type":"integer","minimum":1,"maximum":50},"type":{"type":"string","enum":["character","scene","story","mythic-object","ensemble"]},"slug":{"type":"string","minLength":1},"titleZh":{"type":"string","minLength":1},"titleEn":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"fullDescription":{"type":"string"},"roleInSeries":{"type":"string","minLength":1},"storyIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"characterIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"worldIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"sceneIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"objectIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "sourceRefs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["sourceId","locator"],"properties":{"sourceId":{"type":"string"},"locator":{"type":"string"},"note":{"type":"string"}}}},
    "seriesNarrative":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["seriesTitle","seriesSummary","chapter","chapterTitle","sequence","keyMoment","narrative","previousCardId","nextCardId"],"properties":{"seriesTitle":{"type":"string"},"seriesSummary":{"type":"string"},"chapter":{"type":"integer"},"chapterTitle":{"type":"string"},"sequence":{"type":"integer","minimum":1,"maximum":19},"keyMoment":{"type":"string"},"narrative":{"type":"string"},"previousCardId":{"type":["integer","null"]},"nextCardId":{"type":["integer","null"]}}}]},
    "visualThesis":{"type":"string","minLength":1},
    "canon":{"type":"object","additionalProperties":false,"required":["sourceBoundFacts","interpretationNotes","worldState","identityAnchors","mustKeep","mustAvoid","differentiation"],"properties":{"sourceBoundFacts":{"type":"array","items":{"type":"string"}},"interpretationNotes":{"type":"array","items":{"type":"string"}},"worldState":{"type":"string"},"identityAnchors":{"type":"array","items":{"type":"string"}},"mustKeep":{"type":"array","items":{"type":"string"}},"mustAvoid":{"type":"array","items":{"type":"string"}},"differentiation":{"type":"object","additionalProperties":false,"required":["fromCardIds","instructions"],"properties":{"fromCardIds":{"type":"array","items":{"type":"integer"}},"instructions":{"type":"array","items":{"type":"string"}}}}}},
    "visual":{"type":"object","additionalProperties":false,"required":["mood","palette","materials","detailHierarchy","subjectSeparation"],"properties":{"mood":{"type":"array","items":{"type":"string"}},"palette":{"type":"array","items":{"type":"string"}},"materials":{"type":"array","items":{"type":"string"}},"detailHierarchy":{"type":"string"},"subjectSeparation":{"type":"string"}}},
    "composition":{"type":"object","additionalProperties":true,"properties":{"orientation":{"type":"string","enum":["portrait","landscape"]},"subjectAnchor":{"type":"object"},"criticalIdentityZone":{"type":"object"},"cropSafe":{"type":"object"}}},
    "prompt":{"type":"object","additionalProperties":false,"required":["draft","final","negative"],"properties":{"draft":{"type":"string","minLength":1},"final":{"type":["string","null"]},"negative":{"type":"array","items":{"type":"string"}},"notes":{"type":"string"}}},
    "references":{"type":"object","additionalProperties":true,"properties":{"cardIds":{"type":"array","items":{"type":"integer"}},"characterCanonIds":{"type":"array","items":{"type":"string"}},"notes":{"type":"string"}}},
    "generation":{"type":"object","additionalProperties":false,"properties":{"status":{"type":"string","enum":["planned","generated","approved","rejected","superseded"]},"attempt":{"type":"integer","minimum":0},"approvedAt":{"type":["string","null"]},"referenceImageFile":{"type":["string","null"]},"notes":{"type":"string"}}},
    "output":{"type":"object","additionalProperties":false,"required":["fileName","width","height","format"],"properties":{"fileName":{"type":"string"},"width":{"type":"integer"},"height":{"type":"integer"},"format":{"type":"string","enum":["png","jpg","jpeg","webp"]}}},
    "qa":{"type":"object","additionalProperties":false,"required":["status","reviewNotes"],"properties":{"status":{"type":"string","enum":["planned","prompt-ready","review","approved","rejected","superseded"]},"reviewNotes":{"type":"array","items":{"type":"string"}}}},
    "preGenerationChecks":{"type":"array","items":{"type":"string"}}

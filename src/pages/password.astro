---
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeRedirect } from '../lib/auth/redirect';

export const prerender = false;
const redirectTarget = safeRedirect(Astro.url.searchParams.get('redirect'));
---

<BaseLayout
  title="设置密码 · 绘神宇宙"
  description="通过邮箱验证码设置或重置 MythCanvas 账号密码。"
  fullBleed
  immersiveHeader
  hideFooter
  image="/bg.png"
>
  <section class="auth-page-shell" data-redirect={redirectTarget} aria-labelledby="password-title">
    <div class="auth-page-backdrop" aria-hidden="true">
      <img class="auth-page-backdrop-light" src="/bg.png" alt="" width="2560" height="1440" fetchpriority="high" />
      <img class="auth-page-backdrop-dark" src="/bg-dark.png" alt="" width="2560" height="1440" />
    </div>
    <div class="auth-page-veil" aria-hidden="true"></div>

    <div class="auth-page-stage">
      <div class="auth-page-content">
        <div class="auth-page-panel">
          <span class="auth-page-kicker">MYTHCANVAS · 账号安全</span>
          <h1 id="password-title">重置密码</h1>
          <p class="auth-page-lede">验证邮箱后设置新密码，之后可直接使用邮箱和密码登录。</p>

          <form class="auth-form" data-password-form>
            <label class="field">
              <span class="field-label">注册邮箱</span>
              <input type="email" name="email" inputmode="email" autocomplete="email" required placeholder="你的邮箱地址" aria-label="注册邮箱" />
            </label>
            <label class="field">
              <span class="field-label">新密码</span>
              <input type="password" name="password" autocomplete="new-password" minlength="8" required placeholder="至少 8 位密码" aria-label="新密码" />
            </label>
            <label class="field">
              <span class="field-label">确认新密码</span>
              <input type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required placeholder="再次输入新密码" aria-label="确认新密码" />
            </label>
            <div class="code-row">
              <label class="field">
                <span class="field-label">邮箱验证码</span>
                <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required placeholder="6 位数字" aria-label="邮箱验证码" />
              </label>
              <button class="auth-code-button" type="button" data-send-code>发送验证码</button>
            </div>
            <p class="auth-note">验证码 10 分钟内有效，发送后 60 秒可再次获取。</p>
            <button class="auth-submit" type="submit" data-submit>保存新密码</button>
            <div class="auth-links auth-links--single">
              <a href={`/login/?redirect=${encodeURIComponent(redirectTarget)}`}>返回登录</a>
            </div>
          </form>
          <div class="auth-status" data-status role="alert" aria-live="assertive" hidden></div>
        </div>
      </div>
      <div class="auth-page-visual-space" aria-hidden="true"></div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector('[data-redirect]');
  const form = document.querySelector('[data-password-form]') as HTMLFormElement | null;
  const statusEl = root?.querySelector('[data-status]') as HTMLElement | null;
  const sendButton = form?.querySelector('[data-send-code]') as HTMLButtonElement | null;
  const redirectTarget = root?.getAttribute('data-redirect') ?? '/my/';
  let nonceId = '';
  let cooldownTimer: number | undefined;

  sendButton?.addEventListener('click', async () => {
    if (!form || !sendButton) return;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;
    const confirmPassword = (form.elements.namedItem('confirmPassword') as HTMLInputElement).value;
    setStatus('正在发送验证码…', '');
    sendButton.disabled = true;
    try {
      const response = await fetch('/api/auth/password', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'request', email, password, confirmPassword }),
      });
      const data = await response.json();
      if (!response.ok) {
        setStatus(data?.error?.message ?? '验证码发送失败，请重试。', 'error');
        if (data?.error?.retryAfterSeconds) startCooldown(data.error.retryAfterSeconds);
        else sendButton.disabled = false;
        return;
      }
      if (data.nonceId) nonceId = data.nonceId;
      const devCode = data.devFallback?.otp;
      if (devCode) (form.elements.namedItem('code') as HTMLInputElement).value = devCode;
      setStatus(devCode ? `开发模式验证码：${devCode}` : data.message, 'ok');
      startCooldown(data.resendAfterSeconds ?? 60);
      (form.elements.namedItem('code') as HTMLInputElement).focus();
    } catch {
      setStatus('网络异常，请重试。', 'error');
      sendButton.disabled = false;
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = form.querySelector('[data-submit]') as HTMLButtonElement;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;
    const confirmPassword = (form.elements.namedItem('confirmPassword') as HTMLInputElement).value;
    const code = (form.elements.namedItem('code') as HTMLInputElement).value.trim();
    if (!nonceId) {
      setStatus('请先发送邮箱验证码。', 'error');
      return;
    }
    submit.disabled = true;
    setStatus('正在保存密码…', '');
    try {
      const response = await fetch('/api/auth/password', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'reset', email, password, confirmPassword, code, nonceId, redirect: redirectTarget }),
      });
      const data = await response.json();
      if (!response.ok) {
        setStatus(data?.error?.message ?? '密码保存失败，请重试。', 'error');
        return;
      }
      setStatus(data.message ?? '密码已保存，正在进入…', 'ok');
      window.location.href = data.redirect || redirectTarget;
    } catch {
      setStatus('网络异常，请重试。', 'error');
    } finally {
      submit.disabled = false;
    }
  });

  function startCooldown(seconds: number) {
    if (!sendButton) return;
    if (cooldownTimer) window.clearInterval(cooldownTimer);
    let remaining = Math.max(1, Math.ceil(seconds));
    sendButton.disabled = true;
    sendButton.textContent = `重新发送（${remaining}s）`;
    cooldownTimer = window.setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        window.clearInterval(cooldownTimer);
        cooldownTimer = undefined;
        sendButton.disabled = false;
        sendButton.textContent = '重新发送验证码';
      } else sendButton.textContent = `重新发送（${remaining}s）`;
    }, 1000);
  }

  function setStatus(message: string, kind: 'ok' | 'error' | '') {
    if (!statusEl) return;
    statusEl.hidden = !message;
    statusEl.dataset.kind = kind;
    statusEl.textContent = message ?? '';
  }
</script>

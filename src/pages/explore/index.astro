---
import { MoonStar } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkCard from '../../components/artwork/ArtworkCard.astro';
import {
  getArtworks,
  getMythologies,
  getRealms,
  getStyles,
} from '../../lib/content/repositories';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;

// —— 从 URL query 读取初始筛选状态（R9：URL 可分享、可刷新、SEO 可见）
const params = Astro.url.searchParams;
const initialMythology = params.get('mythology') ?? 'all';
const initialType = params.get('type') ?? 'all';
const initialStyle = (params.get('style') ?? 'all').replace('+', ' ');
const initialSearch = params.get('q') ?? '';

const [approvedArtworks, mythologies, styles, mythologiesById, realmsById] = await Promise.all([
  getArtworks(db),
  getMythologies(db),
  getStyles(db),
  getMythologies(db).then((list) => new Map(list.map((item) => [item.id, item]))),
  getRealms(db).then((list) => new Map(list.map((item) => [item.id, item]))),
]);
const contentTypes = [
  { id: 'all', name: '全部' },
  { id: 'realm', name: '神域' },
  { id: 'character', name: '角色' },
  { id: 'scene', name: '场景' },
  { id: 'creature', name: '神兽' },
];
---

<BaseLayout
  title="探索"
  description="探索 MythCanvas 的神话视觉作品，按文明、内容类型和画风发现神域、角色与场景。"
>
  <section class="explore-hero">
    <div class="container-wide">
      <span class="eyebrow">Explore MythCanvas</span>
      <div class="explore-title-row">
        <div>
          <h1>探索</h1>
          <p>探索神话世界，发现角色、神域与视觉作品。</p>
        </div>
        <div class="explore-seal" aria-hidden="true"><span>神</span></div>
      </div>
    </div>
  </section>

  <section class="explore-content section-compact">
    <div class="container-wide">
      <div class="filter-panel surface" data-explore-filters>
        <div class="filter-search" id="search">
          <span class="small-caps">Find a myth</span>
          <input type="search" placeholder="搜索作品标题…" aria-label="搜索作品标题" data-search-input value={initialSearch} />
        </div>
        <div class="filter-row">
          <span class="filter-label">文明</span>
          <div class="filter-scroll" role="group" aria-label="按神话文明筛选">
            <button class:list={{ chip: true, 'is-active': initialMythology === 'all' }} type="button" data-filter="mythology" data-value="all" aria-pressed={initialMythology === 'all'}>全部</button>
            {mythologies.map((mythology) => (
              <button class:list={{ chip: true, 'is-active': initialMythology === mythology.id }} type="button" data-filter="mythology" data-value={mythology.id} aria-pressed={initialMythology === mythology.id}>{mythology.name}</button>
            ))}
          </div>
        </div>

        <div class="filter-row">
          <span class="filter-label">内容</span>
          <div class="filter-scroll" role="group" aria-label="按内容类型筛选">
            {contentTypes.map((type) => (
              <button class:list={{ chip: true, 'is-active': initialType === type.id }} type="button" data-filter="type" data-value={type.id} aria-pressed={initialType === type.id}>{type.name}</button>
            ))}
          </div>
        </div>

        <div class="filter-row">
          <span class="filter-label">画风</span>
          <div class="filter-scroll" role="group" aria-label="按视觉风格筛选">
            <button class:list={{ chip: true, 'is-active': initialStyle === 'all' }} type="button" data-filter="style" data-value="all" aria-pressed={initialStyle === 'all'}>全部</button>
            {styles.map((style) => (
              <button class:list={{ chip: true, 'is-active': initialStyle === style.id || initialStyle === style.slug }} type="button" data-filter="style" data-value={style.id} aria-pressed={initialStyle === style.id || initialStyle === style.slug}>{style.name}</button>
            ))}
          </div>
        </div>
      </div>

      <div class="results-head">
        <div>
          <span class="small-caps">Curated Visuals</span>
          <h2>精选作品</h2>
        </div>
        <p><strong data-result-count>{approvedArtworks.length}</strong> 件作品</p>
      </div>

      <div class="artwork-grid" data-artwork-grid>
        {approvedArtworks.map((artwork) => (
          <ArtworkCard
            artwork={artwork}
            mythologyName={mythologiesById.get(artwork.mythologyId)?.name}
            realmName={artwork.realmId ? realmsById.get(artwork.realmId)?.name : undefined}
          />
        ))}
      </div>

      <div class="empty-state surface" data-empty-state hidden>
        <span aria-hidden="true"><MoonStar size={36} strokeWidth={1.5} /></span>
        <h3>这个神境还没有作品</h3>
        <p>换一个文明、内容类型或画风继续探索。</p>
        <button class="btn btn-secondary" type="button" data-reset-filters>重置筛选</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-explore-filters]');
    const grid = document.querySelector('[data-artwork-grid]');
    if (!root || !grid) return;

    const urlParams = new URLSearchParams(window.location.search);
    const initialSearch = urlParams.get('q') ?? '';
    const state = {
      mythology: urlParams.get('mythology') || 'all',
      type: urlParams.get('type') || 'all',
      style: decodeURIComponent(urlParams.get('style') || 'all'),
      search: initialSearch.toLowerCase(),
    };

    const cards = Array.from(grid.querySelectorAll('[data-artwork-card]'));
    const count = document.querySelector('[data-result-count]');
    const empty = document.querySelector('[data-empty-state]');
    const searchInput = root.querySelector('[data-search-input]');
    if (searchInput instanceof HTMLInputElement) searchInput.value = initialSearch;

    const syncURL = () => {
      const query = new URLSearchParams();
      if (state.mythology !== 'all') query.set('mythology', state.mythology);
      if (state.type !== 'all') query.set('type', state.type);
      if (state.style !== 'all') query.set('style', state.style);
      if (state.search) query.set('q', state.search);
      const qs = query.toString();
      window.history.replaceState(null, '', qs ? `/explore/?${qs}` : '/explore/');
    };

    const apply = () => {
      let visible = 0;
      cards.forEach((card) => {
        const matches =
          (state.mythology === 'all' || card.dataset.mythology === state.mythology) &&
          (state.type === 'all' || card.dataset.type === state.type) &&
          (state.style === 'all' || card.dataset.style === state.style) &&
          (!state.search || (card.textContent || '').toLowerCase().includes(state.search));
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
      syncURL();
    };

    root.querySelectorAll('[data-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.filter;
        const value = button.dataset.value;
        if (!key || !value || !(key in state)) return;
        state[key] = key === 'style' ? decodeURIComponent(value) : value;
        root.querySelectorAll(`[data-filter="${key}"]`).forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        apply();
      });
    });

    root.querySelector('[data-search-input]')?.addEventListener('input', (event) => {
      state.search = event.target instanceof HTMLInputElement ? event.target.value.trim().toLowerCase() : '';
      apply();
    });

    document.querySelector('[data-reset-filters]')?.addEventListener('click', () => {
      Object.keys(state).forEach((key) => {
        state[key] = key === 'search' ? '' : 'all';
        root.querySelectorAll(`[data-filter="${key}"]`).forEach((item) => {
          const active = item.dataset.value === 'all';
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
      });
      const sInput = root.querySelector('[data-search-input]');
      if (sInput instanceof HTMLInputElement) sInput.value = '';
      apply();
    });

    apply();

    // —— 埋点：内容点击（M11）——
    const tracker = async (name, targetId) => {
      try {
        await fetch('/api/events', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name, targetId, page: location.pathname }),
          keepalive: true,
        });
      } catch { /* ignore */ }
    };
    grid.querySelectorAll('[data-artwork-card]').forEach((card) => {
      card.addEventListener('click', () => {
        void tracker('artwork_click', card.dataset.mythology || undefined);
      });
    });
  })();
</script>

<style>
  .explore-hero { position: relative; overflow: hidden; padding-block: 2rem 1.3rem; border-bottom: 1px solid var(--border); }
  .explore-hero::after { content: ''; position: absolute; width: min(520px, 48vw); aspect-ratio: 1; right: -15%; top: -220%; border: 1px solid var(--border); border-radius: 50%; box-shadow: 0 0 0 56px color-mix(in srgb, var(--accent) 4%, transparent), 0 0 0 112px color-mix(in srgb, var(--jade) 3%, transparent); pointer-events: none; }
  .explore-title-row { position: relative; z-index: 1; display: flex; align-items: end; justify-content: space-between; gap: var(--space-10); }
  .explore-title-row > div:first-child { max-width: 760px; }
  h1 { margin: 0; font-size: clamp(2.4rem, 4vw, 3.5rem); }
  .explore-title-row p { max-width: 42rem; margin: .45rem 0 0; color: var(--text-secondary); font-size: .85rem; }
  .explore-seal { display: none; }
  .filter-panel { display: grid; gap: .55rem; padding: 1rem 0 0; border-radius: 0; background: transparent; border: 0; box-shadow: none; backdrop-filter: none; }
  .filter-search { display: grid; grid-template-columns: 1fr minmax(260px, 340px); align-items: center; gap: var(--space-4); padding-bottom: .8rem; border-bottom: 1px solid var(--border); }
  .filter-search input { min-height: 38px; padding: .55rem .75rem; border: 1px solid var(--border); border-radius: 5px; color: var(--text-primary); background: var(--surface); outline: none; }
  .filter-search input:focus { border-color: var(--border-strong); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 16%, transparent); }
  .filter-row { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: .75rem; align-items: center; }
  .filter-label { color: var(--text-muted); font-size: 0.7rem; font-weight: 700; }
  .filter-scroll { display: flex; gap: var(--space-2); min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .filter-scroll::-webkit-scrollbar { display: none; }
  button.chip { cursor: pointer; }
  .results-head { display: flex; align-items: end; justify-content: space-between; margin: 2rem 0 1rem; }
  .results-head h2 { margin: var(--space-1) 0 0; font-size: clamp(1.6rem, 2.4vw, 2.2rem); }
  .results-head p { margin: 0; color: var(--text-muted); font-size: 0.82rem; }
  .results-head strong { color: var(--accent-strong); font-size: 1rem; }
  .artwork-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .artwork-grid :global(.image-wrap) { aspect-ratio: 16 / 10; border-radius: 8px 8px 0 0; box-shadow: none; }
  .artwork-grid :global(.copy) { margin-top: -1px; padding: .65rem .7rem .75rem; border: 1px solid var(--border); border-top: 0; border-radius: 0 0 8px 8px; background: var(--surface); }
  .artwork-grid :global(.copy h3) { font-size: .86rem; }
  .empty-state { margin-top: var(--space-8); padding: var(--space-16) var(--space-6); border-radius: var(--radius-lg); text-align: center; }
  .empty-state > span { display: block; margin-bottom: var(--space-3); color: var(--accent); font-size: 2.4rem; }
  .empty-state h3 { margin-bottom: var(--space-2); }
  .empty-state p { color: var(--text-secondary); }
  @media (max-width: 980px) { .artwork-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .explore-title-row { align-items: start; } .explore-seal { width: 72px; height: 72px; font-size: 1.5rem; } .filter-search { grid-template-columns: 1fr; gap: var(--space-2); } .filter-row { grid-template-columns: 1fr; gap: var(--space-2); } .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .explore-seal { display: none; } }
</style>

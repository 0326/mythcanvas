---
import {
  ArrowDownWideNarrow,
  Brush,
  Globe2,
  MonitorSmartphone,
  MoonStar,
  Search,
  Shapes,
  X,
} from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExploreArtworkCard from '../../components/artwork/ExploreArtworkCard.astro';
import {
  getArtworks,
  getMythologies,
  getWorlds,
  getStyles,
  getCharacters,
} from '../../lib/content/repositories';
import type { ArtworkDevice, ArtworkSort } from '../../lib/content/repositories';
import type { ArtworkType } from '../../lib/content/types';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const params = Astro.url.searchParams;

const contentTypes = [
  { id: 'all', name: '全部类型' },
  { id: 'world', name: '神域' },
  { id: 'character', name: '神灵' },
  { id: 'scene', name: '场景' },
  { id: 'creature', name: '神兽' },
  { id: 'architecture', name: '建筑' },
] as const;

const sortOptions: { id: ArtworkSort; name: string }[] = [
  { id: 'recommended', name: '推荐优先' },
  { id: 'latest', name: '最新发布' },
  { id: 'popular', name: '热门优先' },
];

const deviceOptions = [
  { id: 'all', name: '全部设备' },
  { id: 'desktop', name: '桌面壁纸' },
  { id: 'mobile', name: '手机壁纸' },
] as const;

const initialMythology = params.get('mythology') ?? 'all';
const requestedType = params.get('type') ?? 'all';
const initialType = contentTypes.some((item) => item.id === requestedType) ? requestedType : 'all';
const initialStyle = params.get('style') ?? 'all';
const requestedDevice = params.get('device') ?? 'all';
const initialDevice = deviceOptions.some((item) => item.id === requestedDevice) ? requestedDevice : 'all';
const requestedSort = params.get('sort') as ArtworkSort | null;
const initialSort: ArtworkSort = sortOptions.some((item) => item.id === requestedSort) ? requestedSort! : 'recommended';
const initialSearch = params.get('q')?.trim() ?? '';

const [mythologies, styles, worlds, characters] = await Promise.all([
  getMythologies(db),
  getStyles(db),
  getWorlds(db),
  getCharacters(db),
]);

const approvedArtworks = await getArtworks(db, {
  mythologyId: initialMythology === 'all' ? undefined : initialMythology,
  type: initialType === 'all' ? undefined : initialType as ArtworkType,
  styleId: initialStyle === 'all' ? undefined : initialStyle,
  search: initialSearch || undefined,
  device: initialDevice === 'all' ? undefined : initialDevice as ArtworkDevice,
  sort: initialSort,
  limit: 100,
});

const mythologiesById = new Map(mythologies.map((item) => [item.id, item]));
const worldsById = new Map(worlds.map((item) => [item.id, item]));
const charactersById = new Map(characters.map((item) => [item.id, item]));
const artworkCharacterName = (artwork: (typeof approvedArtworks)[number]) =>
  artwork.characterIds?.map((id) => charactersById.get(id)?.name).find((name): name is string => Boolean(name));

// 宽幅精选卡只能使用 PC 壁纸；手机壁纸保留原比例进入下方竖向画廊，避免被宽卡裁掉人物头部。
const isDesktopArtwork = (artwork: (typeof approvedArtworks)[number]) => artwork.image.width >= artwork.image.height;
const featuredCandidates = initialDevice === 'mobile'
  ? []
  : approvedArtworks.filter(isDesktopArtwork);
const featuredPrimary = featuredCandidates[0];
const featuredSecondary = featuredCandidates[1];
const featuredTertiary = featuredCandidates[2];
const featuredIds = new Set(
  [featuredPrimary, featuredSecondary, featuredTertiary]
    .filter((artwork): artwork is (typeof approvedArtworks)[number] => Boolean(artwork))
    .map((artwork) => artwork.id),
);
const hasFeaturedMosaic = featuredIds.size === 3;
const galleryArtworks = hasFeaturedMosaic
  ? approvedArtworks.filter((artwork) => !featuredIds.has(artwork.id))
  : approvedArtworks;

const sortPresentation: Record<ArtworkSort, { heading: string; description: string }> = {
  recommended: {
    heading: '更多神话作品',
    description: '从不同文明与画风中继续发现值得停留的作品。',
  },
  latest: {
    heading: '最新作品',
    description: '按发布时间浏览最近加入 MythCanvas 的视觉作品。',
  },
  popular: {
    heading: '热门作品',
    description: '优先展示收藏与下载反馈更高的神话视觉。',
  },
};

const hasActiveFilters = initialMythology !== 'all'
  || initialType !== 'all'
  || initialStyle !== 'all'
  || initialDevice !== 'all'
  || initialSort !== 'recommended'
  || Boolean(initialSearch);
---

<BaseLayout
  title="探索神境"
  description="探索 MythCanvas 的神话视觉作品，按文明、内容类型、画风、设备与热度发现诸神和传说中的世界。"
>
  <div class="explore-shell">
    <section class="explore-intro">
      <div class="container-wide explore-intro-grid">
        <div class="intro-copy">
          <span class="eyebrow">Explore MythCanvas</span>
          <h1>探索神境</h1>
          <p>跨越文明，发现诸神与传说中的世界。</p>
        </div>
      </div>
    </section>

    <section class="explore-filter-section collection-filter-section" aria-label="探索筛选与搜索">
      <div class="container-wide">
        <div class="filter-bar collection-filter-toolbar" data-explore-controls aria-label="探索筛选与排序">
          <label class="filter-control">
            <Globe2 size={17} strokeWidth={1.65} aria-hidden="true" />
            <span class="control-name">文明</span>
            <select data-query-control data-param="mythology" aria-label="按文明筛选">
              <option value="all" selected={initialMythology === 'all'}>全部文明</option>
              {mythologies.map((mythology) => (
                <option value={mythology.id} selected={initialMythology === mythology.id}>{mythology.name}</option>
              ))}
            </select>
          </label>

          <label class="filter-control">
            <Shapes size={17} strokeWidth={1.65} aria-hidden="true" />
            <span class="control-name">类型</span>
            <select data-query-control data-param="type" aria-label="按内容类型筛选">
              {contentTypes.map((type) => (
                <option value={type.id} selected={initialType === type.id}>{type.name}</option>
              ))}
            </select>
          </label>

          <label class="filter-control">
            <Brush size={17} strokeWidth={1.65} aria-hidden="true" />
            <span class="control-name">画风</span>
            <select data-query-control data-param="style" aria-label="按画风筛选">
              <option value="all" selected={initialStyle === 'all'}>全部画风</option>
              {styles.map((style) => (
                <option value={style.id} selected={initialStyle === style.id || initialStyle === style.slug}>{style.name}</option>
              ))}
            </select>
          </label>

          <label class="filter-control">
            <MonitorSmartphone size={17} strokeWidth={1.65} aria-hidden="true" />
            <span class="control-name">设备</span>
            <select data-query-control data-param="device" aria-label="按设备比例筛选">
              {deviceOptions.map((device) => (
                <option value={device.id} selected={initialDevice === device.id}>{device.name}</option>
              ))}
            </select>
          </label>

          <label class="filter-control filter-control--sort">
            <ArrowDownWideNarrow size={17} strokeWidth={1.65} aria-hidden="true" />
            <span class="control-name">排序</span>
            <select data-query-control data-param="sort" aria-label="作品排序">
              {sortOptions.map((sort) => (
                <option value={sort.id} selected={initialSort === sort.id}>{sort.name}</option>
              ))}
            </select>
          </label>

          <div class="filter-meta">
            <span><strong>{approvedArtworks.length}</strong> 件作品</span>
            {hasActiveFilters && (
              <a class="reset-link" href="/explore/">
                <X size={14} strokeWidth={1.8} aria-hidden="true" />
                清除
              </a>
            )}
          </div>

          <form class="collection-filter-search explore-filter-search" data-search-form role="search">
            <Search class="search-icon" size={16} strokeWidth={1.7} aria-hidden="true" />
            <input
              type="search"
              value={initialSearch}
              placeholder="搜索神话、神灵、神域…"
              aria-label="搜索神话视觉作品"
              data-search-input
            />
            <button class="sr-only" type="submit">搜索</button>
          </form>
        </div>
      </div>
    </section>

    <section class="explore-content">
      <div class="container-wide">
        {hasFeaturedMosaic && featuredPrimary && featuredSecondary && featuredTertiary && (
          <section class="featured-mosaic" aria-label="当前排序精选作品">
            <div class="featured-primary">
              <ExploreArtworkCard
                artwork={featuredPrimary}
                characterName={artworkCharacterName(featuredPrimary)}
                mythologyName={mythologiesById.get(featuredPrimary.mythologyId)?.name}
                worldName={featuredPrimary.worldId ? worldsById.get(featuredPrimary.worldId)?.name : undefined}
                variant="hero"
              />
            </div>
            <div class="featured-side">
              <ExploreArtworkCard
                artwork={featuredSecondary}
                characterName={artworkCharacterName(featuredSecondary)}
                mythologyName={mythologiesById.get(featuredSecondary.mythologyId)?.name}
                worldName={featuredSecondary.worldId ? worldsById.get(featuredSecondary.worldId)?.name : undefined}
                variant="side"
              />
              <ExploreArtworkCard
                artwork={featuredTertiary}
                characterName={artworkCharacterName(featuredTertiary)}
                mythologyName={mythologiesById.get(featuredTertiary.mythologyId)?.name}
                worldName={featuredTertiary.worldId ? worldsById.get(featuredTertiary.worldId)?.name : undefined}
                variant="side"
              />
            </div>
          </section>
        )}

        {approvedArtworks.length > 0 && galleryArtworks.length > 0 && (
          <section class="gallery-section" aria-labelledby="gallery-heading">
            <div class="gallery-heading">
              <div>
                <h2 id="gallery-heading">{sortPresentation[initialSort].heading}</h2>
                <p>{sortPresentation[initialSort].description}</p>
              </div>
            </div>

            <div class="artwork-masonry" data-artwork-grid>
              {galleryArtworks.map((artwork) => (
                <ExploreArtworkCard
                  artwork={artwork}
                  characterName={artworkCharacterName(artwork)}
                  mythologyName={mythologiesById.get(artwork.mythologyId)?.name}
                  worldName={artwork.worldId ? worldsById.get(artwork.worldId)?.name : undefined}
                />
              ))}
            </div>
          </section>
        )}

        {approvedArtworks.length === 0 && (
          <div class="empty-state surface">
            <span aria-hidden="true"><MoonStar size={34} strokeWidth={1.5} /></span>
            <h2>这个神境还没有作品</h2>
            <p>换一个文明、内容类型、画风或设备继续探索。</p>
            <a class="btn btn-secondary" href="/explore/">重置全部条件</a>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const updateQuery = (key, value) => {
      const url = new URL(window.location.href);
      const isDefault = value === 'all' || (key === 'sort' && value === 'recommended');
      if (isDefault || !value) url.searchParams.delete(key);
      else url.searchParams.set(key, value);
      window.location.assign(`${url.pathname}${url.search}`);
    };

    document.querySelectorAll('[data-query-control]').forEach((control) => {
      control.addEventListener('change', () => {
        if (!(control instanceof HTMLSelectElement)) return;
        const key = control.dataset.param;
        if (!key) return;
        updateQuery(key, control.value);
      });
    });

    const searchForm = document.querySelector('[data-search-form]');
    const searchInput = document.querySelector('[data-search-input]');
    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(searchInput instanceof HTMLInputElement)) return;
      updateQuery('q', searchInput.value.trim());
    });

    const tracker = async (name, targetId) => {
      try {
        await fetch('/api/events', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name, targetId, page: location.pathname }),
          keepalive: true,
        });
      } catch { /* analytics is non-blocking */ }
    };

    document.querySelectorAll('[data-artwork-card]').forEach((card) => {
      card.addEventListener('click', () => {
        void tracker('artwork_click', card.dataset.artworkId || undefined);
      });
    });
  })();
</script>

<style>
  .explore-shell {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    overflow: hidden;
    background: color-mix(in srgb, var(--bg-primary) 94%, var(--surface));
  }

  .explore-intro {
    position: relative;
    padding-block: clamp(2.75rem, 5vw, 4.75rem) clamp(1.75rem, 3vw, 2.75rem);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
  }

  .explore-intro::after {
    content: '';
    position: absolute;
    top: -120px;
    right: -70px;
    width: min(520px, 45vw);
    aspect-ratio: 1.3;
    opacity: .42;
    background:
      radial-gradient(circle at 68% 48%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 4%),
      radial-gradient(ellipse at center, transparent 0 53%, color-mix(in srgb, var(--accent) 17%, transparent) 53.4% 53.8%, transparent 54.2%),
      radial-gradient(ellipse at center, transparent 0 68%, color-mix(in srgb, var(--jade) 10%, transparent) 68.4% 68.8%, transparent 69.2%);
    transform: rotate(-8deg);
    pointer-events: none;
  }

  .explore-intro-grid {
    position: relative;
    z-index: 1;
    display: block;
  }

  .intro-copy h1 {
    margin: 0;
    font-size: clamp(2.7rem, 5vw, 4.35rem);
    line-height: 1.02;
    letter-spacing: -.035em;
  }

  .intro-copy p {
    margin: .72rem 0 0;
    color: var(--text-secondary);
    font-family: var(--font-literary);
    font-size: clamp(.95rem, 1.4vw, 1.12rem);
    letter-spacing: .035em;
  }

  .explore-content {
    padding-block: 0 4rem;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    min-height: 42px;
    padding-block: .1rem;
  }

  .explore-filter-search { margin-left: 0; }

  .filter-control {
    display: grid;
    grid-template-columns: auto auto minmax(0, auto);
    align-items: center;
    gap: .42rem;
    min-width: 0;
    padding: .48rem .72rem;
    color: var(--accent-strong);
    border-right: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
  }

  .filter-control--sort {
    border-right: 0;
  }

  .control-name {
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: .78rem;
    font-weight: 680;
  }

  .filter-control select {
    max-width: 118px;
    padding: .18rem 1.05rem .18rem .08rem;
    border: 0;
    outline: 0;
    color: var(--text-secondary);
    background: transparent;
    font-family: var(--font-ui);
    font-size: .76rem;
    cursor: pointer;
  }

  .filter-meta {
    display: flex;
    align-items: center;
    gap: .8rem;
    margin-left: auto;
    padding-inline: .7rem;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: .72rem;
    white-space: nowrap;
  }

  .filter-meta strong {
    color: var(--accent-strong);
    font-size: .86rem;
  }

  .reset-link {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    color: var(--text-secondary);
  }

  .featured-mosaic {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, .95fr);
    gap: .7rem;
    height: clamp(410px, 45vw, 560px);
    margin-top: .8rem;
  }

  .featured-primary,
  .featured-side,
  .featured-side > * {
    min-width: 0;
    min-height: 0;
  }

  .featured-side {
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: .7rem;
  }

  .gallery-section {
    padding-top: clamp(2rem, 4vw, 3.2rem);
  }

  .gallery-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .gallery-heading h2 {
    margin: 0;
    font-size: clamp(1.65rem, 2.5vw, 2.25rem);
  }

  .gallery-heading p {
    max-width: 38rem;
    margin: .42rem 0 0;
    color: var(--text-muted);
    font-size: .8rem;
  }

  .artwork-masonry {
    columns: 4 230px;
    column-gap: .8rem;
  }

  .artwork-masonry :global(.explore-artwork-card) {
    margin-bottom: .8rem;
  }

  .empty-state {
    margin-top: 1rem;
    padding: clamp(4rem, 9vw, 7rem) 1.5rem;
    border-radius: 12px;
    text-align: center;
  }

  .empty-state > span {
    display: grid;
    width: fit-content;
    margin: 0 auto 1rem;
    color: var(--accent);
  }

  .empty-state h2 {
    margin: 0;
    font-size: 1.65rem;
  }

  .empty-state p {
    margin: .55rem 0 1.25rem;
    color: var(--text-secondary);
  }

  @media (max-width: 1080px) {
    .filter-meta {
      position: sticky;
      right: 0;
      background: color-mix(in srgb, var(--surface) 94%, transparent);
    }

    .featured-mosaic {
      grid-template-columns: minmax(0, 1.25fr) minmax(280px, .9fr);
    }
  }

  @media (max-width: 820px) {
    .featured-mosaic {
      grid-template-columns: 1fr;
      height: auto;
    }

    .featured-primary {
      min-height: 360px;
    }

    .featured-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
    }

    .featured-side > * {
      min-height: 210px;
    }

    .artwork-masonry {
      columns: 3 190px;
    }
  }

  @media (max-width: 560px) {
    .explore-intro {
      padding-block: 2.15rem 1.6rem;
    }

    .intro-copy h1 {
      font-size: 2.7rem;
    }

    .filter-control {
      padding-inline: .6rem;
    }

    .control-name {
      display: none;
    }

    .filter-meta > span {
      display: none;
    }

    .featured-primary {
      min-height: 300px;
    }

    .featured-side {
      grid-template-columns: 1fr;
    }

    .featured-side > * {
      min-height: 205px;
    }

    .artwork-masonry {
      columns: 2 140px;
      column-gap: .65rem;
    }

    .artwork-masonry :global(.explore-artwork-card) {
      margin-bottom: .65rem;
    }
  }
</style>

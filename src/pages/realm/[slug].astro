---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterCard from '../../components/character/CharacterCard.astro';
import ArtworkCard from '../../components/artwork/ArtworkCard.astro';
import {
  getArtworksForRealm,
  getCharactersForRealm,
  getMythologyById,
  getRealmBySlug,
  getStyles,
} from '../../lib/content/repositories';
import { SITE_TITLE } from '../../consts';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const { slug } = Astro.params;
const realm = await getRealmBySlug(db, slug ?? '');
if (!realm) return Astro.redirect('/404');
const [mythology, relatedCharacters, relatedArtworks, styles] = await Promise.all([
  getMythologyById(db, realm.mythologyId),
  getCharactersForRealm(db, realm.id),
  getArtworksForRealm(db, realm.id),
  getStyles(db),
]);
---

<BaseLayout
  title={realm.name}
  description={`${realm.name} · ${realm.nameEn}：${realm.summary}`}
  image={realm.heroImage.src}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'Place',
        name: realm.name,
        alternateName: realm.nameEn,
        description: realm.summary,
        image: new URL(realm.heroImage.src, Astro.site).toString(),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).toString() },
          { '@type': 'ListItem', position: 2, name: '神域', item: new URL('/realm/', Astro.site).toString() },
          { '@type': 'ListItem', position: 3, name: realm.name },
        ],
      },
    ])} />
  </Fragment>
  <section class="realm-hero">
    <img src={realm.heroImage.src} alt={realm.heroImage.alt} width={realm.heroImage.width} height={realm.heroImage.height} fetchpriority="high" />
    <div class="realm-hero-overlay"></div>
    <div class="container-wide realm-hero-copy">
      <a class="back-link" href={mythology ? `/mythology/${mythology.slug}/` : '/explore/'}>← {mythology?.name ?? '返回探索'}</a>
      <span class="eyebrow">Realm · {realm.nameEn}</span>
      <h1>{realm.name}</h1>
      <p>{realm.summary}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#variants">探索视觉形态</a>
        <a class="btn btn-secondary" href="#recreate">重新绘制</a>
      </div>
    </div>
  </section>

  <section class="section-compact">
    <div class="container-wide realm-overview">
      <div class="overview-copy">
        <span class="eyebrow">Canonical Design</span>
        <h2>这个世界必须保留什么</h2>
        <p>Style Variant 可以改变时代、材质与画法，但核心地标、空间逻辑和神话符号需要持续可识别。</p>
      </div>
      <div class="anchor-list surface">
        {realm.canonicalDesign.anchors.map((anchor, index) => (
          <div class="anchor-item"><span>{String(index + 1).padStart(2, '0')}</span><strong>{anchor}</strong></div>
        ))}
        {realm.canonicalDesign.signatureMaterials && (
          <div class="materials"><span>标志材质</span><p>{realm.canonicalDesign.signatureMaterials.join(' · ')}</p></div>
        )}
      </div>
    </div>
  </section>

  <section class="section-compact section-tint" id="variants">
    <div class="container-wide">
      <div class="section-heading">
        <div><span class="eyebrow">Style Variants</span><h2>同一个神域，多种视觉形态</h2><p>画风是视觉表达，不是网站主题。</p></div>
      </div>
      <div class="variant-grid">
        {styles.map((style, index) => (
          <article class="variant-card surface">
            <div class:list={{ 'variant-orb': true, [`tone-${(index % 4) + 1}`]: true }} aria-hidden="true"><span>◇</span></div>
            <div><span class="small-caps">Variant {String(index + 1).padStart(2, '0')}</span><h3>{style.name}</h3></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {relatedCharacters.length > 0 && (
    <section class="section-compact">
      <div class="container-wide">
        <div class="section-heading"><div><span class="eyebrow">Characters</span><h2>神域中的角色</h2></div></div>
        <div class="character-grid">{relatedCharacters.map((character) => <CharacterCard character={character} />)}</div>
      </div>
    </section>
  )}

  <section class="section-compact">
    <div class="container-wide">
      <div class="section-heading"><div><span class="eyebrow">Wallpapers</span><h2>神域壁纸</h2></div></div>
      <div class="artwork-grid">
        {relatedArtworks.map((artwork) => <ArtworkCard artwork={artwork} mythologyName={mythology?.name} realmName={realm.name} />)}
      </div>
    </div>
  </section>

  <section class="section-compact" id="recreate">
    <div class="container-wide">
      <div class="recreate surface">
        <div><span class="eyebrow">AI Recreate</span><h2>重新绘制 {realm.name}</h2><p>保留 {realm.canonicalDesign.anchors.slice(0, 2).join('、')} 等身份锚点，再选择新的画风、场景氛围和设备构图。</p></div>
        <a class="btn btn-primary" href="/create/">开始绘神</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .realm-hero { position: relative; width: min(var(--container-wide), calc(100% - 40px)); margin: 2rem auto 0; display: grid; grid-template-columns: .82fr 1.18fr; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-sm); }
  .realm-hero > img { grid-column: 2; grid-row: 1; width: 100%; height: 100%; min-height: 440px; object-fit: cover; }
  .realm-hero-overlay { display: none; }
  .realm-hero-copy { grid-column: 1; grid-row: 1; z-index: 1; display: flex; flex-direction: column; justify-content: center; width: auto; padding: clamp(1.5rem, 4vw, 3.5rem); }
  .back-link { display: inline-block; margin-bottom: 2rem; color: var(--text-secondary); font-size: .76rem; }
  .realm-hero-copy h1 { margin: 0; }
  .realm-hero-copy > p { max-width: 28rem; margin: var(--space-5) 0 0; color: var(--text-secondary); font-size: .88rem; line-height: 1.8; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7, 1.75rem); }
  .realm-overview { display: grid; grid-template-columns: .85fr 1.15fr; gap: var(--space-10); align-items: start; }
  .overview-copy p { max-width: 34rem; color: var(--text-secondary); }
  .anchor-list { padding: var(--space-6); border-radius: var(--radius-lg); }
  .anchor-item { display: grid; grid-template-columns: 44px 1fr; gap: var(--space-4); align-items: center; padding-block: var(--space-4); border-bottom: 1px solid var(--border); }
  .anchor-item:first-child { padding-top: 0; }
  .anchor-item span { color: var(--accent); font-family: Georgia, serif; font-size: .78rem; }
  .anchor-item strong { font-size: .95rem; }
  .materials { margin-top: var(--space-5); }
  .materials span { color: var(--text-muted); font-size: .74rem; }
  .materials p { margin: var(--space-2) 0 0; color: var(--text-secondary); }
  .section-tint { border-block: 1px solid var(--border); background: color-mix(in srgb, var(--bg-secondary) 66%, transparent); }
  .variant-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .variant-card { display: grid; grid-template-columns: 92px 1fr; gap: var(--space-4); align-items: center; padding: var(--space-4); border-radius: var(--radius-lg); }
  .variant-orb { display: grid; width: 92px; aspect-ratio: 1; place-items: center; border: 1px solid var(--border); border-radius: 50%; color: var(--text-inverse); font-size: 1.4rem; }
  .tone-1 { background: linear-gradient(145deg, var(--cloud-blue), var(--accent)); }
  .tone-2 { background: linear-gradient(145deg, var(--jade), var(--accent-strong)); }
  .tone-3 { background: linear-gradient(145deg, #405b78, #a68853); }
  .tone-4 { background: linear-gradient(145deg, #67556d, #8aa2c1); }
  .variant-card h3 { margin: var(--space-1) 0 0; font-size: 1.2rem; }
  .character-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .artwork-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
  .recreate { display: flex; align-items: end; justify-content: space-between; gap: var(--space-10); padding: clamp(2rem, 5vw, 4rem); border-radius: var(--radius-xl); }
  .recreate h2 { margin-bottom: var(--space-3); }
  .recreate p { max-width: 44rem; margin: 0; color: var(--text-secondary); }
  @media (max-width: 900px) { .realm-overview { grid-template-columns: 1fr; } .variant-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) { .realm-hero { width: min(100% - 28px, var(--container)); grid-template-columns: 1fr; } .realm-hero > img { grid-column: 1; grid-row: 2; min-height: 330px; } .realm-hero-copy { grid-column: 1; grid-row: 1; } .variant-grid, .character-grid { grid-template-columns: 1fr; } .recreate { align-items: start; flex-direction: column; } }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RealmCard from '../../components/realm/RealmCard.astro';
import { getRealms } from '../../lib/content/repositories';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const realms = await getRealms(db);
---

<BaseLayout title="神域" description="探索 MythCanvas 中的神域与世界地标。">
  <section class="collection-hero">
    <div class="container-wide">
      <span class="eyebrow">Realms · Enter a World</span>
      <h1>进入神域</h1>
      <p>不只是浏览标签。进入一个神域，沿着地标、角色与不同视觉形态继续探索。</p>
    </div>
  </section>
  <section class="section-compact">
    <div class="container-wide realm-grid">
      {realms.map((realm) => <RealmCard realm={realm} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .collection-hero { padding-block: clamp(4rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--border); background: radial-gradient(circle at 82% 20%, var(--hero-ambient), transparent 28%); }
  h1 { margin: 0; font-size: clamp(3rem, 6vw, 5.4rem); }
  .collection-hero p { max-width: 42rem; margin: var(--space-5) 0 0; color: var(--text-secondary); }
  .realm-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  @media (max-width: 800px) { .realm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .realm-grid { grid-template-columns: 1fr; } }
</style>

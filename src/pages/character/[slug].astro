---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterHero from '../../components/character/CharacterHero.astro';
import CharacterInterpretationSelector from '../../components/character/CharacterInterpretationSelector.astro';
import CharacterVariantSelector from '../../components/character/CharacterVariantSelector.astro';
import CharacterStyleSelector from '../../components/character/CharacterStyleSelector.astro';
import CharacterArtworkGrid, {
  type ArtworkCard,
  type DeviceFilter,
  type WallpaperDevice,
} from '../../components/character/CharacterArtworkGrid.astro';
import CharacterDNA from '../../components/character/CharacterDNA.astro';
import RelatedCharacters from '../../components/character/RelatedCharacters.astro';
import WorldCard from '../../components/world/WorldCard.astro';
import {
  getArtworksForCharacter,
  getCharacterBySlug,
  getCharacterInterpretations,
  getCharacterNames,
  getCharacters,
  getCharacterVariants,
  getMythologies,
  getMythologyById,
  getWorlds,
} from '../../lib/content/repositories';
import {
  getCharacterStyle,
  normalizeCharacterStyleId,
  type CharacterStyleId,
} from '../../lib/content/character-styles';
import type { Artwork, ImageAsset, World } from '../../lib/content/types';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const { slug } = Astro.params;
const character = await getCharacterBySlug(db, slug ?? '');
if (!character) return Astro.redirect('/404');

const [mythology, relatedArtworks, worlds, variants, interpretations, names, allCharacters, allMythologies] = await Promise.all([
  getMythologyById(db, character.mythologyId),
  getArtworksForCharacter(db, character.id),
  getWorlds(db),
  getCharacterVariants(db, character.id),
  getCharacterInterpretations(db, character.id),
  getCharacterNames(db, character.id),
  getCharacters(db),
  getMythologies(db, { published: 'all' }),
]);

const mythologyById = new Map(allMythologies.map((item) => [item.id, item]));

const worldsById = new Map(worlds.map((item) => [item.id, item]));
const characterWorlds = character.worldIds
  .map((id) => worldsById.get(id))
  .filter((item): item is World => item != null);

const sameWorld = characterWorlds.length > 0
  ? allCharacters.filter((c) => c.id !== character.id && c.worldIds.some((w) => character.worldIds.includes(w)))
  : [];
const sameMythology = allCharacters.filter(
  (c) => c.id !== character.id && c.mythologyId === character.mythologyId && !sameWorld.includes(c),
);
const fallback = allCharacters.filter(
  (c) => c.id !== character.id && !sameWorld.includes(c) && !sameMythology.includes(c),
);
const relatedCharacters = [...sameWorld, ...sameMythology, ...fallback].slice(0, 6);

const requestedStyle = normalizeCharacterStyleId(Astro.url.searchParams.get('style'));
const selectedStyle: CharacterStyleId = requestedStyle ?? 'canonical';
const selectedVariantSlug = Astro.url.searchParams.get('variant') ?? '';
const requestedInterpretationSlug = Astro.url.searchParams.get('interpretation') ?? '';
const selectedInterpretation = interpretations.find((item) => item.slug === requestedInterpretationSlug);
const selectedInterpretationSlug = selectedInterpretation?.slug ?? '';
const availableVariants = variants.filter(
  (variant) => !variant.interpretationId || variant.interpretationId === selectedInterpretation?.id,
);
const requestedDevice = Astro.url.searchParams.get('device');
const selectedDevice: DeviceFilter = requestedDevice === 'pc' ? 'pc' : requestedDevice === 'mobile' ? 'mobile' : 'all';
const selectedStyleDefinition = getCharacterStyle(selectedStyle);

const fallbackImage: ImageAsset = {
  src: '/art/chinese-celestial.svg',
  alt: '云海之上的东方神境',
  width: 1600,
  height: 900,
};

const heroImage =
  character.portrait ??
  relatedArtworks.find((artwork) => artwork.image.width >= artwork.image.height)?.image ??
  characterWorlds[0]?.heroImage ??
  mythology?.heroImage ??
  fallbackImage;

const artworkDevice = (artwork: Artwork): WallpaperDevice =>
  artwork.image.width >= artwork.image.height ? 'pc' : 'mobile';

const artworkCards: ArtworkCard[] = relatedArtworks.map((artwork) => {
  const normalizedStyle = normalizeCharacterStyleId(artwork.styleId) ?? 'canonical';
  const style = getCharacterStyle(normalizedStyle);
  return {
    id: artwork.id,
    styleId: normalizedStyle,
    device: artworkDevice(artwork),
    title: artwork.title,
    styleName: style.name,
    styleNameEn: style.nameEn,
    image: artwork.image,
    href: `/wallpaper/${artwork.slug}/`,
  };
});

const buildCreateHref = (
  styleId: CharacterStyleId = selectedStyle,
  variantSlug: string = selectedVariantSlug,
  device: WallpaperDevice = selectedDevice === 'all' ? 'pc' : selectedDevice,
  interpretationSlug: string = selectedInterpretationSlug,
) => {
  const params = new URLSearchParams();
  params.set('character', character.slug);
  if (interpretationSlug) params.set('interpretation', interpretationSlug);
  if (variantSlug) params.set('variant', variantSlug);
  params.set('style', styleId);
  params.set('output', device === 'mobile' ? 'mobile-wallpaper' : 'desktop-wallpaper');
  return `/create/?${params.toString()}`;
};
---

<BaseLayout
  title={`${character.name} · ${character.nameEn}`}
  description={`${character.name} · ${character.nameEn}：${character.summary}`}
  image={heroImage.src}
  fullBleed
  immersiveHeader
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: character.name,
        alternateName: [character.nameEn, ...names.map((name) => name.name)],
        description: character.summary,
        image: heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).toString() },
          { '@type': 'ListItem', position: 2, name: '神灵', item: new URL('/character/', Astro.site).toString() },
          { '@type': 'ListItem', position: 3, name: character.name },
        ],
      },
    ])} />
  </Fragment>

  <div
    class="character-page"
    data-character-page
    data-character-slug={character.slug}
    data-selected-style={selectedStyle}
    data-selected-variant={selectedVariantSlug}
    data-selected-interpretation={selectedInterpretationSlug}
    data-selected-device={selectedDevice}
  >
    <CharacterHero character={character} mythology={mythology} heroImage={heroImage} createHref={buildCreateHref()} />

    <section class="forms-section" id="forms" aria-labelledby="forms-title">
      <div class="container-wide">
        <div class="forms-heading">
          <span class="eyebrow">Visual Forms · 神灵形态</span>
          <h2 id="forms-title">选择形态与画风</h2>
          <p>先选择有来源的传统版本，再选择持续形态与艺术风格；各层信息不会被静默混写。</p>
        </div>

        {interpretations.length > 0 && (
          <div class="forms-layer" id="interpretations">
            <h3 class="layer-label">传统版本与来源</h3>
            <CharacterInterpretationSelector
              character={character}
              interpretations={interpretations}
              names={names}
              selectedInterpretationSlug={selectedInterpretationSlug}
              selectedVariantSlug={selectedVariantSlug}
              selectedStyleId={selectedStyle}
            />
          </div>
        )}

        <div class="forms-layer">
          <h3 class="layer-label">神灵形态</h3>
          <CharacterVariantSelector
            character={character}
            variants={availableVariants}
            selectedInterpretationSlug={selectedInterpretationSlug}
            selectedVariantSlug={selectedVariantSlug}
            selectedStyleId={selectedStyle}
          />
        </div>

        <div class="forms-layer">
          <h3 class="layer-label">艺术风格</h3>
          <CharacterStyleSelector
            character={character}
            selectedStyleId={selectedStyle}
            selectedInterpretationSlug={selectedInterpretationSlug}
            selectedVariantSlug={selectedVariantSlug}
          />
          <p class="layer-description" data-selected-style-description>{selectedStyleDefinition.description}</p>
        </div>

        <div class="forms-cta">
          <a class="btn btn-primary" href={buildCreateHref()} data-create-cta>
            绘制「<span data-selected-style-name>{selectedStyleDefinition.name}</span>」版{character.name}
          </a>
          <a class="forms-scroll-link" href="#wallpapers">查看下方作品 ↓</a>
        </div>
      </div>
    </section>

    <section class="wallpapers-section" id="wallpapers" aria-labelledby="wallpapers-title">
      <div class="container-wide">
        <div class="wallpapers-heading">
          <div>
            <span class="eyebrow">Character Artworks</span>
            <h2 id="wallpapers-title"><span>{character.name}</span> · <span data-wallpaper-style-name>{selectedStyleDefinition.name}</span> 作品</h2>
          </div>
          <a class="back-to-forms" href="#forms">返回形态选择 ↑</a>
        </div>

        <CharacterArtworkGrid
          character={character}
          artworkCards={artworkCards}
          selectedStyle={selectedStyle}
          selectedStyleName={selectedStyleDefinition.name}
          selectedDevice={selectedDevice}
          selectedInterpretationSlug={selectedInterpretationSlug}
          selectedVariantSlug={selectedVariantSlug}
          emptyCreateHref={buildCreateHref()}
        />
      </div>
    </section>

    <CharacterDNA character={character} mythology={mythology} worlds={characterWorlds} />

    {characterWorlds.length > 0 && (
      <section class="related-section section-compact" aria-labelledby="world-title">
        <div class="container-wide">
          <div class="section-heading">
            <div><span class="eyebrow">Related World</span><h2 id="world-title">所在神域</h2></div>
          </div>
          <div class="world-grid">{characterWorlds.map((world) => <WorldCard world={world} />)}</div>
        </div>
      </section>
    )}

    <RelatedCharacters characters={relatedCharacters} mythologyById={mythologyById} />

    <section class="recreate-section section-compact" id="recreate">
      <div class="container-wide recreate surface">
        <div>
          <span class="eyebrow">AI Recreate</span>
          <h2>绘制我的 {character.name}</h2>
          <p>保留角色核心身份，选择形态、艺术风格和 PC / Mobile 构图，生成属于你的神话壁纸。</p>
        </div>
        <a class="btn btn-primary" href={buildCreateHref()} data-recreate-cta>开始绘神</a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector('[data-character-page]');
  if (page) {
    const characterSlug = page.getAttribute('data-character-slug') ?? '';
    const wallpaperGrid = page.querySelector('[data-wallpaper-grid]');
    const wallpaperCards = Array.from(page?.querySelectorAll('[data-wallpaper-card]') ?? []);
    const variantLinks = Array.from(page?.querySelectorAll('[data-variant-filter]') ?? []);
    const styleLinks = Array.from(page?.querySelectorAll('[data-style-filter]') ?? []);
    const deviceLinks = Array.from(page?.querySelectorAll('[data-device-filter]') ?? []);
    const createCtas = Array.from(page?.querySelectorAll('[data-create-cta], [data-recreate-cta], [data-empty-create]') ?? []);
    const styleNameDisplays = Array.from(page?.querySelectorAll('[data-selected-style-name], [data-wallpaper-style-name]') ?? []);
    const styleDescription = page?.querySelector('[data-selected-style-description]');
    const emptyState = page?.querySelector('[data-wallpaper-empty]');
    const emptyStyleName = emptyState?.querySelector('[data-empty-style-name]');
    const wallpapersSection = page?.querySelector('#wallpapers');

    const styleLabels = new Map<string, string>();
    const styleDescriptions = new Map<string, string>();
    styleLinks.forEach((link) => {
      const id = link.getAttribute('data-style-filter');
      const label = link.getAttribute('data-style-label');
      if (id && label) styleLabels.set(id, label);
      const description = link.getAttribute('data-style-description');
      if (id && description) styleDescriptions.set(id, description);
    });

    const setUrlState = (variant: string, style: string, device: string) => {
      const url = new URL(window.location.href);
      if (variant) url.searchParams.set('variant', variant);
      else url.searchParams.delete('variant');
      if (style && style !== 'canonical') url.searchParams.set('style', style);
      else url.searchParams.delete('style');
      if (device && device !== 'all') url.searchParams.set('device', device);
      else url.searchParams.delete('device');
      window.history.replaceState({}, '', url);
    };

    const buildCreateHref = (style: string, variant: string, device: string) => {
      const params = new URLSearchParams();
      params.set('character', characterSlug);
      if (variant) params.set('variant', variant);
      params.set('style', style);
      const outputDevice = device === 'mobile' ? 'mobile' : 'pc';
      params.set('output', outputDevice === 'mobile' ? 'mobile-wallpaper' : 'desktop-wallpaper');
      return `/create/?${params.toString()}`;
    };

    const applyState = (variant: string, style: string, device: string) => {
      if (!page) return;
      page.dataset.selectedStyle = style;
      page.dataset.selectedVariant = variant;
      page.dataset.selectedDevice = device;
      if (wallpaperGrid) wallpaperGrid.dataset.activeDevice = device;

      wallpaperCards.forEach((card) => {
        const cardStyle = card.getAttribute('data-style') ?? '';
        const cardDevice = card.getAttribute('data-device') ?? '';
        const matchesStyle = cardStyle === style;
        const matchesDevice = device === 'all' || cardDevice === device;
        card.hidden = !(matchesStyle && matchesDevice);
      });

      variantLinks.forEach((link) => {
        const active = (link.getAttribute('data-variant-filter') ?? '') === variant;
        link.classList.toggle('is-active', active);
        link.setAttribute('aria-current', String(active));
      });
      styleLinks.forEach((link) => {
        const active = link.getAttribute('data-style-filter') === style;
        link.classList.toggle('is-active', active);
        link.setAttribute('aria-current', String(active));
      });
      deviceLinks.forEach((link) => {
        const active = link.getAttribute('data-device-filter') === device;
        link.classList.toggle('is-active', active);
        link.setAttribute('aria-current', String(active));
      });

      const label = styleLabels.get(style) ?? style;
      styleNameDisplays.forEach((el) => { el.textContent = label; });
      if (styleDescription) styleDescription.textContent = styleDescriptions[style] ?? '';

      const hasVisible = wallpaperCards.some((card) => !card.hidden);
      if (emptyState) {
        emptyState.hidden = hasVisible;
        if (emptyStyleName) emptyStyleName.textContent = label;
      }
      createCtas.forEach((cta) => cta.setAttribute('href', buildCreateHref(style, variant, device)));

      setUrlState(variant, style, device);
    };

    variantLinks.forEach((link) => link.addEventListener('click', (event) => {
      event.preventDefault();
      const variant = link.getAttribute('data-variant-filter') ?? '';
      const style = page?.dataset.selectedStyle ?? 'canonical';
      const device = page?.dataset.selectedDevice ?? 'all';
      applyState(variant, style, device);
    }));

    styleLinks.forEach((link) => link.addEventListener('click', (event) => {
      event.preventDefault();
      const style = link.getAttribute('data-style-filter') ?? 'canonical';
      const variant = page?.dataset.selectedVariant ?? '';
      const device = page?.dataset.selectedDevice ?? 'all';
      applyState(variant, style, device);
      wallpapersSection?.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start',
      });
    }));

    deviceLinks.forEach((link) => link.addEventListener('click', (event) => {
      event.preventDefault();
      const device = link.getAttribute('data-device-filter') ?? 'all';
      const style = page?.dataset.selectedStyle ?? 'canonical';
      const variant = page?.dataset.selectedVariant ?? '';
      applyState(variant, style, device);
    }));
  }
</script>

<style>
  .character-page { background: var(--bg-primary); }

  .forms-section {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-secondary) 60%, transparent);
  }
  .forms-heading { max-width: 46rem; margin-bottom: 2.5rem; }
  .forms-heading h2 { margin: 0.4rem 0 0; font-size: clamp(2rem, 3.5vw, 3rem); }
  .forms-heading p { margin: 0.8rem 0 0; color: var(--text-secondary); }
  .forms-layer { margin-top: 2.2rem; }
  .forms-layer:first-of-type { margin-top: 0; }
  .layer-label { margin: 0 0 1rem; color: var(--text-primary); font-size: 1.05rem; font-weight: 600; }
  .layer-description { margin: 0.9rem 0 0; max-width: 42rem; color: var(--text-secondary); font-size: 0.85rem; }
  .forms-cta { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-top: 2.5rem; }
  .forms-scroll-link { color: var(--text-secondary); font-size: 0.82rem; transition: color var(--transition-fast); }
  .forms-scroll-link:hover { color: var(--text-primary); }

  .wallpapers-section {
    min-height: 100svh;
    padding-block: clamp(4rem, 8vh, 7rem);
    background: radial-gradient(circle at 14% 8%, color-mix(in srgb, var(--hero-ambient) 84%, transparent), transparent 28%), var(--page-glow);
  }
  .wallpapers-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-8); margin-bottom: 1.8rem; }
  .wallpapers-heading h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.8rem); }
  .back-to-forms { color: var(--text-secondary); font-size: 0.82rem; white-space: nowrap; transition: color var(--transition-fast); }
  .back-to-forms:hover { color: var(--text-primary); }

  .related-section { background: var(--bg-primary); }
  .world-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }

  .recreate { display: flex; align-items: end; justify-content: space-between; gap: var(--space-10); padding: clamp(2rem, 5vw, 4rem); border-radius: var(--radius-xl); }
  .recreate p { max-width: 42rem; margin: 0; color: var(--text-secondary); }

  @media (max-width: 900px) {
    .world-grid { grid-template-columns: 1fr; }
  }
</style>

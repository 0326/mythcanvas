---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkCard from '../../components/artwork/ArtworkCard.astro';
import RealmCard from '../../components/realm/RealmCard.astro';
import { characters, styles } from '../../data/seed';
import {
  getArtworksForCharacter,
  getMythologyById,
  getRealmById,
} from '../../lib/content/queries';
import type { Character } from '../../lib/content/types';

export function getStaticPaths() {
  return characters.map((character) => ({
    params: { slug: character.slug },
    props: { character },
  }));
}

interface Props {
  character: Character;
}

const { character } = Astro.props;
const mythology = getMythologyById(character.mythologyId);
const characterRealms = character.realmIds.map(getRealmById).filter(Boolean);
const relatedArtworks = getArtworksForCharacter(character.id);
---

<BaseLayout
  title={character.name}
  description={`${character.name} · ${character.nameEn}：${character.summary}`}
  image={character.portrait?.src ?? characterRealms[0]?.heroImage.src ?? mythology?.heroImage.src}
>
  <section class="character-hero">
    <div class="container-wide hero-grid">
      <div class="character-copy">
        <a class="back-link" href={mythology ? `/mythology/${mythology.slug}/` : '/explore/'}>← {mythology?.name ?? '返回探索'}</a>
        <span class="eyebrow">{character.role}</span>
        <h1>{character.name}</h1>
        <p class="en-name">{character.nameEn}</p>
        <p class="summary">{character.summary}</p>
        <div class="symbol-list">
          {character.symbols.map((symbol) => <span class="chip">{symbol}</span>)}
        </div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#variants">查看视觉形态</a>
          <a class="btn btn-secondary" href="#recreate">绘制我的 {character.name}</a>
        </div>
      </div>

      <div class="character-visual" aria-label={character.portrait ? `${character.name} Canonical Design 肖像` : `${character.name} Canonical Design 视觉占位`}>
        {character.portrait ? (
          <img
            class="portrait-img"
            src={character.portrait.src}
            alt={character.portrait.alt}
            width={character.portrait.width}
            height={character.portrait.height}
            fetchpriority="high"
          />
        ) : (
          <div class="visual-mock" aria-hidden="true">
            <div class="moon"></div>
            <div class="orbit orbit-a"></div>
            <div class="orbit orbit-b"></div>
            <div class="sigil">{character.symbols[0] ?? '✦'}</div>
          </div>
        )}
        <div class="visual-caption">
          <span>Canonical Design</span>
          <strong>{character.canonicalDesign.anchors.slice(0, 3).join(' · ')}</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section-compact">
    <div class="container-wide identity-grid">
      <div>
        <span class="eyebrow">Identity Anchors</span>
        <h2>换画风，不换身份</h2>
        <p>角色可以进入不同材质、时代和画法，但 Canonical Design 的关键识别点必须被保留。</p>
      </div>
      <div class="identity-list surface">
        {character.canonicalDesign.anchors.map((anchor, index) => (
          <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{anchor}</strong></div>
        ))}
        {character.canonicalDesign.silhouette && <p>{character.canonicalDesign.silhouette}</p>}
      </div>
    </div>
  </section>

  <section class="section-compact section-tint" id="variants">
    <div class="container-wide">
      <div class="section-heading"><div><span class="eyebrow">Style Variants</span><h2>多种画风，同一个 {character.name}</h2><p>视觉风格独立于文明 Visual DNA 和网站 Light / Dark Theme。</p></div></div>
      <div class="variant-grid">
        {styles.map((style, index) => (
          <article class="variant surface">
            <div class:list={{ swatch: true, [`swatch-${(index % 4) + 1}`]: true }}><span>{character.symbols[index % character.symbols.length] ?? '✦'}</span></div>
            <div><span class="small-caps">Style Variant</span><h3>{style.name}</h3></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {characterRealms.length > 0 && (
    <section class="section-compact">
      <div class="container-wide">
        <div class="section-heading"><div><span class="eyebrow">Related Realms</span><h2>所在神域</h2></div></div>
        <div class="realm-grid">{characterRealms.map((realm) => realm && <RealmCard realm={realm} />)}</div>
      </div>
    </section>
  )}

  <section class="section-compact">
    <div class="container-wide">
      <div class="section-heading"><div><span class="eyebrow">Wallpapers</span><h2>{character.name} 视觉作品</h2></div></div>
      {relatedArtworks.length > 0 ? (
        <div class="artwork-grid">{relatedArtworks.map((artwork) => <ArtworkCard artwork={artwork} mythologyName={mythology?.name} realmName={artwork.realmId ? getRealmById(artwork.realmId)?.name : undefined} />)}</div>
      ) : (
        <div class="coming surface"><span aria-hidden="true">✦</span><h3>首批角色视觉正在绘制</h3><p>Canonical Design 已建立，下一步将补齐正式角色视觉资产。</p></div>
      )}
    </div>
  </section>

  <section class="section-compact" id="recreate">
    <div class="container-wide recreate surface">
      <div><span class="eyebrow">AI Recreate</span><h2>绘制我的 {character.name}</h2><p>从角色身份开始，而不是从空白 Prompt 开始。选择画风、场景、氛围和设备构图即可。</p></div>
      <a class="btn btn-primary" href="/#create">开始绘神</a>
    </div>
  </section>
</BaseLayout>

<style>
  .character-hero { padding-block: clamp(4rem, 8vw, 8rem); border-bottom: 1px solid var(--border); background: radial-gradient(circle at 78% 30%, var(--hero-ambient), transparent 34%); }
  .hero-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(3rem, 7vw, 7rem); align-items: center; }
  .back-link { display: inline-block; margin-bottom: var(--space-8); color: var(--text-secondary); font-size: .82rem; }
  .character-copy h1 { margin: 0; }
  .en-name { margin: var(--space-2) 0 0; color: var(--accent-strong); font-family: Georgia, serif; font-size: 1.25rem; }
  .summary { max-width: 38rem; margin: var(--space-6) 0 0; color: var(--text-secondary); font-size: 1rem; }
  .symbol-list, .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-6); }
  .hero-actions { gap: var(--space-3); margin-top: var(--space-8); }
  .character-visual { position: relative; min-height: 540px; display: grid; place-items: center; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-xl); background: linear-gradient(145deg, var(--surface), var(--surface-muted)); box-shadow: var(--shadow-hero); }
  .character-visual::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--moon-white) 70%, transparent), transparent 22%), linear-gradient(to top, color-mix(in srgb, var(--accent) 6%, transparent), transparent 50%); }
  .portrait-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .visual-mock { position: absolute; inset: 0; display: grid; place-items: center; }
  .moon { position: absolute; width: min(330px, 60%); aspect-ratio: 1; border: 1px solid var(--border-strong); border-radius: 50%; box-shadow: 0 0 80px var(--hero-ambient), inset 0 0 50px color-mix(in srgb, var(--moon-white) 36%, transparent); }
  .orbit { position: absolute; width: 72%; height: 38%; border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); border-radius: 50%; }
  .orbit-a { transform: rotate(24deg); }
  .orbit-b { transform: rotate(-24deg); }
  .sigil { position: relative; z-index: 2; max-width: 15rem; padding: var(--space-4); color: var(--accent-strong); font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 2.4rem); text-align: center; }
  .visual-caption { position: absolute; right: var(--space-5); bottom: var(--space-5); left: var(--space-5); display: grid; gap: var(--space-1); padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); backdrop-filter: blur(12px); }
  .visual-caption span { color: var(--accent-strong); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; }
  .visual-caption strong { font-size: .82rem; }
  .identity-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: var(--space-10); }
  .identity-grid > div:first-child p { max-width: 34rem; color: var(--text-secondary); }
  .identity-list { padding: var(--space-6); border-radius: var(--radius-lg); }
  .identity-list > div { display: grid; grid-template-columns: 44px 1fr; gap: var(--space-4); padding: var(--space-4) 0; border-bottom: 1px solid var(--border); }
  .identity-list > div:first-child { padding-top: 0; }
  .identity-list span { color: var(--accent); font-family: Georgia, serif; font-size: .78rem; }
  .identity-list p { margin: var(--space-5) 0 0; color: var(--text-secondary); }
  .section-tint { border-block: 1px solid var(--border); background: color-mix(in srgb, var(--bg-secondary) 66%, transparent); }
  .variant-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .variant { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); border-radius: var(--radius-lg); }
  .swatch { display: grid; width: 80px; aspect-ratio: 1; place-items: center; flex: 0 0 auto; border-radius: 50%; color: var(--text-inverse); font-family: var(--font-serif); font-size: .8rem; }
  .swatch-1 { background: linear-gradient(145deg, var(--cloud-blue), var(--accent)); }
  .swatch-2 { background: linear-gradient(145deg, var(--jade), #e8c98d); }
  .swatch-3 { background: linear-gradient(145deg, #304a66, #a98858); }
  .swatch-4 { background: linear-gradient(145deg, #5e516d, #89a7ca); }
  .variant h3 { margin: var(--space-1) 0 0; font-size: 1.15rem; }
  .realm-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .artwork-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
  .coming { padding: var(--space-16) var(--space-6); border-radius: var(--radius-lg); text-align: center; }
  .coming > span { color: var(--accent); font-size: 2rem; }
  .coming h3 { margin: var(--space-4) 0 var(--space-2); }
  .coming p { color: var(--text-secondary); }
  .recreate { display: flex; align-items: end; justify-content: space-between; gap: var(--space-10); padding: clamp(2rem, 5vw, 4rem); border-radius: var(--radius-xl); }
  .recreate p { max-width: 42rem; margin: 0; color: var(--text-secondary); }
  @media (max-width: 900px) { .hero-grid, .identity-grid { grid-template-columns: 1fr; } .character-visual { min-height: 440px; } .variant-grid, .realm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .variant-grid, .realm-grid { grid-template-columns: 1fr; } .recreate { align-items: start; flex-direction: column; } }
</style>

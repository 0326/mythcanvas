---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterCard from '../../components/character/CharacterCard.astro';
import { Search } from '@lucide/astro';
import { getCharacters, getMythologies } from '../../lib/content/repositories';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const [characters, mythologies] = await Promise.all([
  getCharacters(db),
  getMythologies(db, { published: 'all' }),
]);

const mythologyBySlug = new Map(mythologies.map((item) => [item.slug, item]));
const mythologyById = new Map(mythologies.map((item) => [item.id, item]));

const requestedMythology = Astro.url.searchParams.get('mythology') ?? '';
const requestedQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const selectedMythology = mythologyBySlug.has(requestedMythology) ? requestedMythology : '';
const selectedQuery = requestedQuery.toLowerCase();

const normalize = (value: string) => value.trim().toLowerCase();
const matchesQuery = (
  name: string,
  nameEn: string,
  role: string,
  query: string,
) =>
  !query ||
  normalize(name).includes(query) ||
  normalize(nameEn).includes(query) ||
  normalize(role).includes(query);

const visibleCharacters = characters.filter((character) => {
  if (selectedMythology) {
    const mythology = mythologyById.get(character.mythologyId);
    if (!mythology || mythology.slug !== selectedMythology) return false;
  }
  if (selectedQuery) {
    if (!matchesQuery(character.name, character.nameEn, character.role, selectedQuery)) return false;
  }
  return true;
});

const filterHref = (mythologySlug: string) => {
  const url = new URL(Astro.url.pathname, Astro.site);
  if (mythologySlug) url.searchParams.set('mythology', mythologySlug);
  if (selectedQuery) url.searchParams.set('q', selectedQuery);
  return `${url.pathname}${url.search}`;
};

const searchValue = requestedQuery;
---

<BaseLayout
  title="神灵"
  description="探索拥有 Canonical Design 的神话神灵与视觉形态，跨越中国、希腊、北欧、日本、埃及五大神话体系。"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: '神灵', item: new URL('/character/', Astro.site).toString() },
      ],
    })} />
  </Fragment>

  <div class="character-index" data-character-index data-selected-mythology={selectedMythology}>
    <section class="collection-hero">
      <div class="container-wide">
        <span class="eyebrow">Characters · 神灵视觉资产</span>
        <h1>诸神有形</h1>
        <p>每个神灵都拥有稳定的身份锚点，也可以在电影感、动漫、神圣与赛博画风中重新演绎。</p>
      </div>
    </section>

    <section class="filter-section collection-filter-section" aria-label="神灵筛选">
      <div class="container-wide filter-toolbar collection-filter-toolbar" data-filter-toolbar>
        <div class="filter-group mythology-filter" role="group" aria-label="按神话体系筛选神灵">
          <span class="filter-label">神话体系</span>
          <div class="filter-options">
            <a
              class:list={{ 'filter-option': true, 'is-active': selectedMythology === '' }}
              href={filterHref('')}
              data-mythology-filter=""
              aria-current={selectedMythology === '' ? 'true' : 'false'}
            >全部</a>
            {mythologies.map((mythology) => (
              <a
                class:list={{ 'filter-option': true, 'is-active': mythology.slug === selectedMythology }}
                href={filterHref(mythology.slug)}
                data-mythology-filter={mythology.slug}
                aria-current={mythology.slug === selectedMythology ? 'true' : 'false'}
              >{mythology.name}</a>
            ))}
          </div>
        </div>

        <div class="filter-group search-filter">
          <label class="search-box collection-filter-search">
            <Search class="search-icon" aria-hidden="true" />
            <input
              type="search"
              name="q"
              placeholder="搜索神灵中文名 / 英文名 / 神职"
              value={searchValue}
              data-search-input
              aria-label="搜索神灵"
            />
          </label>
        </div>
      </div>
    </section>

    <section class="section-compact gallery-section" aria-labelledby="gallery-heading">
      <div class="container-wide">
        <h2 id="gallery-heading" class="sr-only">全部角色</h2>
        {characters.length > 0 ? (
          <div class="character-grid" data-character-grid>
            {characters.map((character) => {
              const mythology = mythologyById.get(character.mythologyId);
              const searchText = `${character.name} ${character.nameEn} ${character.role}`.toLowerCase();
              const matchesMythology = !selectedMythology || mythology?.slug === selectedMythology;
              const matchesSearch = !selectedQuery || searchText.includes(selectedQuery);
              return (
                <div
                  class="character-cell"
                  data-character-cell
                  data-mythology={mythology?.slug ?? ''}
                  data-search={searchText}
                  hidden={!matchesMythology || !matchesSearch}
                >
                  <CharacterCard character={character} mythology={mythology} />
                </div>
              );
            })}
          </div>
        ) : null}

        <div class="gallery-empty" data-gallery-empty hidden={visibleCharacters.length > 0}>
          <p class="gallery-empty-title">没有找到对应角色</p>
          <p class="gallery-empty-hint">尝试切换神话体系或搜索其他名称。</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector('[data-character-index]');
  const grid = document.querySelector('[data-character-grid]');
  const cells = Array.from(document.querySelectorAll('[data-character-cell]'));
  const mythologyLinks = Array.from(document.querySelectorAll('[data-mythology-filter]'));
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const emptyState = document.querySelector('[data-gallery-empty]');

  if (root && grid) {
    const setUrlState = (mythology: string, query: string) => {
      const url = new URL(window.location.href);
      if (mythology) url.searchParams.set('mythology', mythology);
      else url.searchParams.delete('mythology');
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
    };

    const applyFilters = (mythology: string, query: string) => {
      const normalizedQuery = query.trim().toLowerCase();
      let visibleCount = 0;
      cells.forEach((cell) => {
        const cellMythology = cell.getAttribute('data-mythology') ?? '';
        const cellSearch = cell.getAttribute('data-search') ?? '';
        const matchesMythology = !mythology || cellMythology === mythology;
        const matchesSearch = !normalizedQuery || cellSearch.includes(normalizedQuery);
        const visible = matchesMythology && matchesSearch;
        cell.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      mythologyLinks.forEach((link) => {
        const value = link.getAttribute('data-mythology-filter') ?? '';
        const active = value === mythology;
        link.classList.toggle('is-active', active);
        link.setAttribute('aria-current', String(active));
      });
      if (root) root.dataset.selectedMythology = mythology;
      if (emptyState) emptyState.hidden = visibleCount > 0;
      setUrlState(mythology, query);
    };

    mythologyLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const value = link.getAttribute('data-mythology-filter') ?? '';
        const current = root?.dataset.selectedMythology ?? '';
        if (value === current) return;
        event.preventDefault();
        const query = searchInput?.value ?? '';
        applyFilters(value, query);
      });
    });

    if (searchInput) {
      let debounce: number | undefined;
      searchInput.addEventListener('input', () => {
        window.clearTimeout(debounce);
        debounce = window.setTimeout(() => {
          const mythology = root?.dataset.selectedMythology ?? '';
          applyFilters(mythology, searchInput.value);
        }, 160);
      });
    }
  }
</script>

<style>
  .collection-hero {
    padding-block: clamp(2.75rem, 5vw, 4.75rem) clamp(1.75rem, 3vw, 2.75rem);
    border-bottom: 1px solid var(--border);
    background: radial-gradient(circle at 82% 20%, var(--hero-ambient), transparent 28%);
  }
  .collection-hero h1 { margin: 0; font-size: clamp(3rem, 6vw, 5.4rem); }
  .collection-hero p { max-width: 42rem; margin: var(--space-5) 0 0; color: var(--text-secondary); }

  .filter-section {
    position: sticky;
    top: 0;
    z-index: calc(var(--z-header) + 1);
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
    backdrop-filter: blur(12px) saturate(118%);
  }
  .filter-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filter-toolbar::-webkit-scrollbar { display: none; }
  .filter-group { display: flex; min-width: 0; align-items: center; gap: 0.8rem; }
  .mythology-filter { flex: 1 1 auto; min-width: 0; }
  .search-filter { flex: 0 0 auto; }
  .filter-label { color: var(--text-muted); font-size: 0.76rem; white-space: nowrap; }
  .filter-options {
    display: flex;
    min-width: 0;
    flex-wrap: nowrap;
    gap: 0.35rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filter-options::-webkit-scrollbar { display: none; }
  .filter-option {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    padding-inline: 0.85rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.78rem;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  }
  .filter-option:hover,
  .filter-option:focus-visible,
  .filter-option.is-active {
    color: var(--text-primary);
    border-color: var(--border-strong);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 240px;
  }
  .search-icon {
    position: absolute;
    left: 0.62rem;
    width: 16px;
    height: 16px;
    color: var(--text-muted);
    pointer-events: none;
  }
  .search-box input {
    width: 100%;
    padding: 0.55rem 0.8rem 0.55rem 2.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    color: var(--text-primary);
    font-size: 0.84rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .search-box input::placeholder { color: var(--text-muted); }

  .gallery-section { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .character-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .character-cell[hidden] { display: none; }

  .gallery-empty[hidden] { display: none; }
  .gallery-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding-block: clamp(4rem, 8vw, 6rem);
    color: var(--text-secondary);
    text-align: center;
  }
  .gallery-empty-title { margin: 0; font-size: 1.2rem; color: var(--text-primary); }
  .gallery-empty-hint { margin: 0; color: var(--text-muted); }

  @media (max-width: 1499px) { .character-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 1199px) { .character-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .character-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
    .filter-toolbar { flex-direction: column; align-items: stretch; }
    .search-box { min-width: 0; width: 100%; }
    .collection-filter-search { flex: 0 0 auto; margin-left: 0; }
  }
  @media (max-width: 360px) { .character-grid { grid-template-columns: 1fr; } }
</style>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CardShowcase from '../../../../components/cards/CardShowcase.astro';
import { formatCardNumber, getCardById, getCardByNumber, norseM01Series } from '../../../../lib/cards/catalog';
import { localizedPath } from '../../../../lib/i18n/url';
import { ArrowLeft, ArrowRight, BookOpen, Download, Heart, Sparkles } from '@lucide/astro';

export const prerender = true;

export function getStaticPaths() {
  return norseM01Series.cards.map((card) => ({
    params: { cardId: String(card.cardId) },
    props: { card },
  }));
}

const { card } = Astro.props;
const cardNumber = Number(Astro.params.cardId?.slice(-2));
const hasStory = card.seriesNarrative && card.type === 'story';
const previous = hasStory
  ? (card.seriesNarrative?.previousCardId ? getCardById(card.seriesNarrative.previousCardId) : undefined)
  : getCardByNumber(cardNumber - 1);
const next = hasStory
  ? (card.seriesNarrative?.nextCardId ? getCardById(card.seriesNarrative.nextCardId) : undefined)
  : getCardByNumber(cardNumber + 1);
const title = card.titleZh;
---

<BaseLayout title={title} description={card.display.full}>
  <section class="card-detail-page" aria-labelledby="card-detail-title">
    <div class="container-wide card-detail-shell">
      <a class="back-link" href={localizedPath('zh-Hans', '/cards/norse/m01-norse-genesis/')}><ArrowLeft size={16} strokeWidth={1.8} aria-hidden="true" /> 返回 M01 系列</a>

      <div class="card-detail-grid">
        <div class="card-detail-stage">
          <CardShowcase card={card} />
        </div>

        <div class="card-detail-copy">
          <span class="eyebrow"><Sparkles size={15} strokeWidth={1.8} aria-hidden="true" /> M01 · {formatCardNumber(card.cardNumber)}</span>
          <h1 id="card-detail-title">{title}</h1>
          <p class="card-detail-en">{card.titleEn}</p>
          <div class="detail-meta">
            <span>{card.display.categoryLabel}</span>
            <span>{card.display.identity}</span>
            <span>{card.generation?.status === 'approved' ? '已出图' : '制作中'}</span>
          </div>
          <p class="detail-description">{card.display.full}</p>

          <div class="detail-actions">
            {card.imageUrl ? <a class="btn btn-primary" href={card.imageUrl} download={card.output.fileName}><Download size={16} strokeWidth={1.8} aria-hidden="true" /> 下载卡图</a> : <button class="btn btn-primary" type="button" disabled><Download size={16} strokeWidth={1.8} aria-hidden="true" /> 图片制作中</button>}
            <button class="btn btn-secondary" type="button" data-favorite aria-pressed="false"><Heart size={16} strokeWidth={1.8} aria-hidden="true" /> <span>收藏</span></button>
          </div>

          {hasStory && (
            <section class="story-context" aria-labelledby="story-context-title">
              <div class="context-heading"><BookOpen size={17} strokeWidth={1.8} aria-hidden="true" /><h2 id="story-context-title">{card.seriesNarrative?.chapterTitle} · {card.seriesNarrative?.keyMoment}</h2></div>
              <p>{card.seriesNarrative?.narrative}</p>
            </section>
          )}

          <div class="series-role">
            <span>Series role</span>
            <p>{card.display.roleInSeries}</p>
          </div>

          <nav class="card-neighbours" aria-label="卡片浏览">
            {previous ? <a href={`${localizedPath('zh-Hans', '/cards/norse/m01-norse-genesis/')}${previous.cardId}/`}><ArrowLeft size={16} strokeWidth={1.8} aria-hidden="true" /> 上一张</a> : <span></span>}
            {next ? <a href={`${localizedPath('zh-Hans', '/cards/norse/m01-norse-genesis/')}${next.cardId}/`}>下一张 <ArrowRight size={16} strokeWidth={1.8} aria-hidden="true" /></a> : <span></span>}
          </nav>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const favorite = document.querySelector<HTMLButtonElement>('[data-favorite]');
  favorite?.addEventListener('click', () => {
    const active = favorite.getAttribute('aria-pressed') === 'true';
    favorite.setAttribute('aria-pressed', active ? 'false' : 'true');
    const label = favorite.querySelector('span');
    if (label) label.textContent = active ? '收藏' : '已收藏';
  });
</script>

<style>
  .card-detail-page { min-height: calc(100vh - var(--header-height)); padding-block: clamp(2rem, 5vw, 4.5rem) clamp(4rem, 8vw, 8rem); background: radial-gradient(circle at 70% 22%, color-mix(in srgb, #8ac9dc 12%, transparent), transparent 27%); }
  .back-link { display: inline-flex; align-items: center; gap: .45rem; color: var(--text-muted); font-size: .8rem; }
  .back-link:hover { color: var(--text-primary); }
  .card-detail-grid { display: grid; grid-template-columns: minmax(260px, 390px) minmax(0, 600px); align-items: start; justify-content: center; gap: clamp(3rem, 9vw, 9rem); margin-top: clamp(2.5rem, 6vw, 5.5rem); }
  .card-detail-stage { width: min(100%, 380px); }
  .card-detail-copy { padding-top: clamp(.5rem, 2vw, 2.5rem); }
  .card-detail-copy h1 { margin: 0; font-family: var(--font-display); font-size: clamp(3rem, 6vw, 6rem); line-height: .98; letter-spacing: -.055em; }
  .card-detail-en { margin: .7rem 0 0; color: var(--text-muted); font-size: .85rem; letter-spacing: .08em; }
  .detail-meta { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: var(--space-6); }
  .detail-meta span { padding: .38rem .62rem; border: 1px solid var(--border); border-radius: 999px; color: var(--text-secondary); background: var(--surface); font-size: .7rem; }
  .detail-description { max-width: 38rem; margin: var(--space-8) 0 0; color: var(--text-secondary); font-family: var(--font-literary); font-size: 1rem; line-height: 1.9; }
  .detail-actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: var(--space-8); }
  .detail-actions button:disabled { cursor: not-allowed; opacity: .48; }
  .story-context { margin-top: var(--space-12); padding: var(--space-5); border-block: 1px solid var(--border); }
  .context-heading { display: flex; align-items: center; gap: .6rem; color: var(--accent-strong); }
  .context-heading h2 { margin: 0; color: var(--text-primary); font-family: var(--font-display); font-size: 1rem; }
  .story-context p { margin: var(--space-3) 0 0; color: var(--text-secondary); font-size: .86rem; line-height: 1.8; }
  .series-role { margin-top: var(--space-8); }
  .series-role > span { color: var(--accent-strong); font-size: .68rem; font-weight: 760; letter-spacing: .12em; text-transform: uppercase; }
  .series-role p { margin: .55rem 0 0; color: var(--text-secondary); font-size: .82rem; line-height: 1.75; }
  .card-neighbours { display: flex; justify-content: space-between; gap: 1rem; margin-top: var(--space-10); padding-top: var(--space-5); border-top: 1px solid var(--border); }
  .card-neighbours a { display: inline-flex; align-items: center; gap: .4rem; color: var(--text-secondary); font-size: .8rem; }
  .card-neighbours a:hover { color: var(--accent-strong); }
  @media (max-width: 760px) { .card-detail-grid { grid-template-columns: minmax(0, 340px); gap: var(--space-10); } .card-detail-stage { margin-inline: auto; } .card-detail-copy { padding-top: 0; } }
</style>

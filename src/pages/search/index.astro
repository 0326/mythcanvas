---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkCard from '../../components/artwork/ArtworkCard.astro';
import { searchAll, type SearchResult } from '../../lib/content/search';
import { getPublicArtworkBySlug, getPublicCharacters, getPublicMythologies, getPublicWorlds } from '../../lib/content/public-catalog';

export const prerender = false;

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const results = query ? await searchAll(undefined, query) : [];
const entityNames = loadEntityNames();
const artworkResults = (
  results
    .filter((result) => result.type === 'artwork')
    .map((result) => getPublicArtworkBySlug(result.slug))
);
const artworks = artworkResults.filter((item) => item != null);

function resultPath(result: SearchResult): string {
  switch (result.type) {
    case 'mythology': return `/mythology/${result.slug}/`;
    case 'world': return `/world/${result.slug}/`;
    case 'character': return `/character/${result.slug}/`;
    case 'artwork': return `/wallpaper/${result.slug}/`;
  }
}

function resultTypeLabel(type: string): string {
  return { mythology: '神话体系', world: '神域', character: '神灵', artwork: '作品' }[type] ?? type;
}

function loadEntityNames() {
  const [mythologies, worlds, characters] = [
    getPublicMythologies(),
    getPublicWorlds({ limit: 1000 }),
    getPublicCharacters({ limit: 1000 }),
  ];
  return {
    mythology: new Map(mythologies.map((item) => [item.id, item])),
    world: new Map(worlds.map((item) => [item.id, item])),
    character: new Map(characters.map((item) => [item.id, item])),
  };
}

const entityResults = results.filter((result) => result.type !== 'artwork') as Array<SearchResult & { type: 'mythology' | 'world' | 'character' }>;
---

<BaseLayout
  title={query ? `搜索“${query}”` : '搜索'}
  description={`在 MythCanvas 搜索神话体系、神域、神灵与视觉作品${query ? `：${query}` : ''}。`}
>
  <section class="search-hero">
    <div class="container-wide">
      <span class="eyebrow">Search MythCanvas</span>
      <h1>探索神话</h1>
      <form class="search-bar" action="/search/" method="get" role="search">
        <input type="search" name="q" value={query} placeholder="搜索神话体系、神域、神灵、作品…" aria-label="全站搜索" autoFocus />
        <button class="btn btn-primary" type="submit">搜索</button>
      </form>
    </div>
  </section>

  <section class="section-compact">
    <div class="container-wide">
      {!query ? (
        <div class="empty-state surface">
          <span aria-hidden="true">⌕</span>
          <h2>输入关键词开始探索</h2>
          <p>可以搜索神话体系（中国、希腊…）、神域（月宫、奥林匹斯…）、神灵（嫦娥、雅典娜…）或视觉作品。</p>
        </div>
      ) : results.length === 0 ? (
        <div class="empty-state surface">
          <span aria-hidden="true">☾</span>
          <h2>没有找到“{query}”</h2>
          <p>换个关键词，或前往探索页浏览全部作品。</p>
          <a class="btn btn-secondary" href="/explore/">去探索</a>
        </div>
      ) : (
        <>
          <div class="results-head">
            <span class="small-caps">Results</span>
            <h2>“{query}” 共 {results.length} 条</h2>
          </div>

          {entityResults.length > 0 && (
            <div class="entity-results">
              {entityResults.map((result) => (
                <a class="entity-result surface" href={resultPath(result)}>
                  {result.image && <img src={result.image} alt="" loading="lazy" width="96" height="96" />}
                  <div>
                    <span class="entity-type">{resultTypeLabel(result.type)}</span>
                    <strong>{result.name}</strong>
                    <p>{result.subtitle}</p>
                  </div>
                  <span class="result-arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          )}

          {artworks.length > 0 && (
            <div class="artwork-section">
              <div class="section-heading">
                <div><span class="eyebrow">Artworks</span><h2>相关壁纸</h2></div>
              </div>
              <div class="artwork-grid">
                {artworks.map((artwork) =>
                  <ArtworkCard
                    artwork={artwork}
                    mythologyName={artwork ? entityNames.mythology.get(artwork.mythologyId)?.name : undefined}
                    worldName={artwork?.worldId ? entityNames.world.get(artwork.worldId)?.name : undefined}
                  />
                )}
              </div>
            </div>
          )}
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .search-hero { padding-block: clamp(4rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--border); }
  .search-hero h1 { margin: 0 0 var(--space-6); font-size: clamp(2.8rem, 5vw, 5rem); }
  .search-bar { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-3); max-width: 560px; }
  .search-bar input { min-height: 50px; padding: .7rem 1rem; border: 1px solid var(--border); border-radius: 8px; color: var(--text-primary); background: var(--surface); font-size: 1rem; }
  .search-bar input:focus { border-color: var(--border-strong); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 16%, transparent); }
  .search-bar .btn { min-height: 50px; }
  .results-head { margin: clamp(2rem, 4vw, 3rem) 0 var(--space-6); }
  .results-head h2 { margin: var(--space-1) 0 0; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .entity-results { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .entity-result { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); border-radius: var(--radius-lg); }
  .entity-result:hover { border-color: var(--border-strong); }
  .entity-result img { width: 72px; height: 72px; object-fit: cover; border-radius: var(--radius-md); flex: 0 0 auto; }
  .entity-result > div { display: grid; min-width: 0; }
  .entity-type { color: var(--accent-strong); font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .entity-result strong { font-size: .95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .entity-result p { margin: 2px 0 0; color: var(--text-muted); font-size: .74rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .result-arrow { margin-left: auto; color: var(--text-muted); font-size: 1.1rem; }
  .artwork-section { margin-top: var(--space-12); }
  .artwork-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
  .empty-state { margin-top: var(--space-8); padding: var(--space-16) var(--space-6); border-radius: var(--radius-lg); text-align: center; }
  .empty-state > span { display: block; margin-bottom: var(--space-3); color: var(--accent); font-size: 2.4rem; }
  .empty-state h2 { margin-bottom: var(--space-2); }
  .empty-state p { color: var(--text-secondary); }
  .empty-state .btn { margin-top: var(--space-4); }
  @media (max-width: 720px) { .entity-results { grid-template-columns: 1fr; } .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

---
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicMythologies } from '../lib/content/public-catalog';
import {
  cloudflareImageUrl,
  focalPointToCss,
  shouldUseCloudflareImageTransformations,
} from '../lib/media/cloudflare-images';

export const prerender = true;

const mythologyCards = getPublicMythologies()
  .toSorted((a, b) => (a.displayOrder ?? 999) - (b.displayOrder ?? 999))
  .slice(0, 10);

const defaultMythology = mythologyCards[0];
const heroTitleChars = [...'绘神宇宙'];
const defaultCtaText = defaultMythology ? `进入${defaultMythology.name}` : '探索神话世界';
const defaultCtaChars = [...defaultCtaText];
const useImageTransformations = shouldUseCloudflareImageTransformations(Astro.url, Astro.site);
const defaultFocalCss = focalPointToCss(defaultMythology?.homeHero?.focalPoint);
const homeShellStyle = `--hero-focal-x:${defaultFocalCss.x};--hero-focal-y:${defaultFocalCss.y}`;

// Homepage Light/Dark images are already R2 WebP derivatives. Keeping the LCP
// path direct avoids making first paint depend on a cold image-transformation
// request; smaller card thumbnails still use responsive transformations below.
const homeHeroUrl = (src?: string) => src;

const defaultHeroLightSource = defaultMythology?.homeHero?.lightSrc ?? defaultMythology?.heroImage.src;
const defaultHeroDarkSource = defaultMythology?.homeHero?.darkSrc ?? defaultHeroLightSource;
const defaultHeroLight = homeHeroUrl(defaultHeroLightSource);
const defaultHeroDark = homeHeroUrl(defaultHeroDarkSource);
const heroArtStyle = [
  `--hero-light-image:${defaultHeroLight ? `url("${defaultHeroLight}")` : 'none'}`,
  `--hero-dark-image:${defaultHeroDark ? `url("${defaultHeroDark}")` : 'none'}`,
].join(';');

const cardImageStyle = (
  lightSrc?: string,
  darkSrc?: string,
  focalPoint?: { x: number; y: number },
) => {
  const focalCss = focalPointToCss(focalPoint);
  const transformOptions = {
    width: 480,
    height: 360,
    fit: 'cover' as const,
    quality: 82,
    format: 'auto' as const,
    focalPoint,
  };
  const lightThumbnail = cloudflareImageUrl(lightSrc, transformOptions, useImageTransformations);
  const darkThumbnail = cloudflareImageUrl(darkSrc, transformOptions, useImageTransformations);

  return [
    `--card-light-image:${lightThumbnail ? `url("${lightThumbnail}")` : 'none'}`,
    `--card-dark-image:${darkThumbnail ? `url("${darkThumbnail}")` : 'none'}`,
    `--card-focal-x:${focalCss.x}`,
    `--card-focal-y:${focalCss.y}`,
  ].join(';');
};
---

<BaseLayout
  fullBleed
  immersiveHeader
  hideFooter
  description="绘神宇宙 MythCanvas：用 AI 重现神话世界。探索中国、希腊、北欧、埃及、印度、日本、凯尔特、玛雅、阿兹特克与美索不达米亚神话。"
>
  <section
    class="home-shell"
    aria-labelledby="hero-title"
    data-home-shell
    data-active-mythology={defaultMythology?.slug ?? 'chinese'}
    style={homeShellStyle}
  >
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="hero-art" data-hero-art aria-hidden="true" style={heroArtStyle}></div>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="hero-stage container-wide">
      <div class="hero-copy">
        <h1 id="hero-title" aria-label="绘神宇宙">
          {heroTitleChars.map((char, index) => (
            <span class="title-char" style={`--char-index:${index}`} aria-hidden="true">{char}</span>
          ))}
        </h1>
        <p class="hero-tagline">用 AI 重现神话世界</p>
        <a
          class="hero-cta"
          data-active-cta
          href={defaultMythology ? `/mythology/${defaultMythology.slug}/` : '/mythology/'}
          aria-label={defaultCtaText}
        >
          <span class="cta-text" data-active-cta-text aria-hidden="true">
            {defaultCtaChars.map((char, index) => (
              <span class="cta-char" style={`--char-index:${index}`}>{char}</span>
            ))}
          </span>
        </a>
        <p class="hero-description" data-active-description>
          {defaultMythology?.summary ?? '选择一个神话体系，进入属于它的诸神与世界。'}
        </p>
      </div>
    </div>

    <section class="mythology-dock" aria-label="选择神话体系">
      <div class="container-wide mythology-panel">
        <div class="mythology-carousel">
          <button type="button" class="carousel-button" data-mythology-prev aria-label="上一组神话" disabled>
            <ChevronLeft size={18} strokeWidth={1.8} aria-hidden="true" />
          </button>

          <div class="mythology-viewport" data-mythology-viewport>
            <div class="mythology-track">
              {mythologyCards.map((item, index) => {
                // A newly published mythology must never leave the homepage blank:
                // use its canonical hero until dedicated Light/Dark art is ready.
                const lightSrc = item.homeHero?.lightSrc ?? item.heroImage.src;
                const darkSrc = item.homeHero?.darkSrc ?? lightSrc;
                const lightHeroSrc = homeHeroUrl(lightSrc);
                const darkHeroSrc = homeHeroUrl(darkSrc);
                const focalCss = focalPointToCss(item.homeHero?.focalPoint);
                const hasImage = Boolean(lightSrc || darkSrc);
                return (
                  <button
                    type="button"
                    class:list={{ 'mythology-card': true, 'mythology-card--has-image': hasImage }}
                    data-mythology-card
                    data-slug={item.slug}
                    data-name={item.name}
                    data-summary={item.summary}
                    data-href={`/mythology/${item.slug}/`}
                    data-light-src={lightHeroSrc ?? ''}
                    data-dark-src={darkHeroSrc ?? ''}
                    data-focal-x={focalCss.x}
                    data-focal-y={focalCss.y}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    style={cardImageStyle(lightSrc, darkSrc, item.homeHero?.focalPoint)}
                  >
                    <span class="mythology-card-visual" aria-hidden="true">
                      <span class="mythology-card-number">{String(index + 1).padStart(2, '0')}</span>
                    </span>
                    <span class="mythology-card-shade" aria-hidden="true"></span>
                    <span class="mythology-card-copy">
                      <strong>{item.name}</strong>
                      <small>{item.tagline}</small>
                    </span>
                  </button>
                );
              })}
            </div>
          </div>

          <button type="button" class="carousel-button" data-mythology-next aria-label="下一组神话">
            <ChevronRight size={18} strokeWidth={1.8} aria-hidden="true" />
          </button>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<script>
  const shell = document.querySelector('[data-home-shell]');
  const description = document.querySelector('[data-active-description]');
  const cta = document.querySelector('[data-active-cta]');
  const ctaText = document.querySelector('[data-active-cta-text]');
  const heroArt = document.querySelector('[data-hero-art]');
  const cards = Array.from(document.querySelectorAll('[data-mythology-card]'));
  const viewport = document.querySelector('[data-mythology-viewport]');
  const previous = document.querySelector('[data-mythology-prev]');
  const next = document.querySelector('[data-mythology-next]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const setHeroSource = (property: '--hero-light-image' | '--hero-dark-image', src: string) => {
    if (!(heroArt instanceof HTMLElement)) return;
    heroArt.style.setProperty(property, src ? `url("${src}")` : 'none');
  };

  const renderCtaText = (text: string) => {
    if (!(ctaText instanceof HTMLElement)) return;
    const fragment = document.createDocumentFragment();
    Array.from(text).forEach((char, index) => {
      const span = document.createElement('span');
      span.className = 'cta-char';
      span.style.setProperty('--char-index', String(index));
      span.textContent = char;
      fragment.append(span);
    });
    ctaText.replaceChildren(fragment);
  };

  const selectMythology = (card: HTMLButtonElement) => {
    if (!(shell instanceof HTMLElement)) return;
    const slug = card.dataset.slug ?? '';
    const name = card.dataset.name ?? '';
    const summary = card.dataset.summary ?? '';
    const href = card.dataset.href ?? '/mythology/';

    shell.classList.add('is-switching');
    shell.dataset.activeMythology = slug;
    shell.style.setProperty('--hero-focal-x', card.dataset.focalX ?? '50%');
    shell.style.setProperty('--hero-focal-y', card.dataset.focalY ?? '50%');
    cards.forEach((item) => {
      if (item instanceof HTMLButtonElement) item.setAttribute('aria-pressed', item === card ? 'true' : 'false');
    });

    if (description instanceof HTMLElement) description.textContent = summary;
    if (cta instanceof HTMLAnchorElement) {
      const label = `进入${name}`;
      cta.href = href;
      cta.setAttribute('aria-label', label);
      renderCtaText(label);
    }

    setHeroSource('--hero-light-image', card.dataset.lightSrc ?? '');
    setHeroSource('--hero-dark-image', card.dataset.darkSrc ?? '');

    window.setTimeout(() => shell.classList.remove('is-switching'), reducedMotion.matches ? 0 : 360);
  };

  cards.forEach((card, index) => {
    if (!(card instanceof HTMLButtonElement)) return;
    card.addEventListener('click', () => selectMythology(card));
    card.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const target = cards[(index + direction + cards.length) % cards.length];
      if (target instanceof HTMLButtonElement) {
        target.focus();
        selectMythology(target);
        target.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      }
    });
  });

  if (viewport instanceof HTMLElement && previous instanceof HTMLButtonElement && next instanceof HTMLButtonElement) {
    const updateButtons = () => {
      const maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
      previous.disabled = viewport.scrollLeft <= 2;
      next.disabled = viewport.scrollLeft >= maxScroll - 2;
    };

    const scrollByPage = (direction: number) => {
      viewport.scrollBy({
        left: direction * Math.max(viewport.clientWidth * 0.82, 260),
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
      });
    };

    previous.addEventListener('click', () => scrollByPage(-1));
    next.addEventListener('click', () => scrollByPage(1));
    viewport.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);
    updateButtons();
  }
</script>

<style>
  .home-shell {
    position: relative;
    display: grid;
    width: 100%;
    min-width: 0;
    height: 100svh;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
    background: var(--bg-primary);
    isolation: isolate;
  }

  .hero-backdrop,
  .hero-art,
  .hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-backdrop {
    z-index: -4;
    background:
      radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--accent-soft) 52%, transparent), transparent 30%),
      radial-gradient(circle at 18% 74%, color-mix(in srgb, var(--bg-secondary) 82%, transparent), transparent 38%),
      linear-gradient(145deg, var(--bg-primary), color-mix(in srgb, var(--bg-secondary) 72%, var(--bg-primary)) 55%, var(--bg-primary));
  }

  .hero-art {
    z-index: -3;
    overflow: hidden;
    opacity: 1;
    background-image: var(--hero-light-image);
    background-position: var(--hero-focal-x, 50%) var(--hero-focal-y, 50%);
    background-size: cover;
    transition: opacity .5s ease, transform 14s ease;
  }

  :global([data-theme='dark']) .hero-art { background-image: var(--hero-dark-image); }

  .home-shell.is-switching .hero-art {
    opacity: .25;
  }

  .home-shell:hover .hero-art {
    transform: scale(1.018);
  }

  .hero-overlay {
    z-index: -2;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 20%, transparent), transparent 28%),
      radial-gradient(circle at 50% 39%, transparent 0 15%, color-mix(in srgb, var(--bg-primary) 10%, transparent) 48%, color-mix(in srgb, var(--bg-primary) 28%, transparent) 82%),
      linear-gradient(to top, color-mix(in srgb, var(--bg-primary) 76%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 32%, transparent) 38%, transparent 78%);
    pointer-events: none;
  }

  .hero-stage {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: none;
    min-width: 0;
    min-height: 0;
    margin-inline: 0;
    padding: clamp(5.4rem, 9vh, 7rem) var(--space-5) clamp(1.2rem, 2.5vh, 2rem);
  }

  .hero-copy {
    position: relative;
    width: min(760px, 100%);
    min-width: 0;
    margin-top: clamp(0rem, 2.4vh, 1.8rem);
    text-align: center;
  }

  .hero-copy::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 35%;
    left: 50%;
    width: min(660px, 86vw);
    height: clamp(160px, 23vw, 240px);
    border-radius: 50%;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--accent-soft) 32%, transparent) 0%, transparent 72%);
    filter: blur(24px);
    transform: translate(-50%, -50%);
    animation: hero-ambient-breathe 9s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-copy h1 {
    display: inline-flex;
    margin: 0;
    align-items: center;
    justify-content: center;
    color: transparent;
    font-family: var(--font-display, var(--font-serif));
    font-size: clamp(3.2rem, 4.8vw, 4.8rem);
    font-weight: 650;
    line-height: .98;
    isolation: isolate;
    filter: drop-shadow(0 4px 16px color-mix(in srgb, var(--accent-strong) 25%, transparent));
  }

  .title-char {
    --char-delay: calc(var(--char-index) * -1.24s);
    display: inline-block;
    margin-inline: .06em;
    color: transparent;
    background-image:
      repeating-linear-gradient(18deg, color-mix(in srgb, white 10%, transparent) 0 1px, color-mix(in srgb, var(--accent-strong) 8%, transparent) 1px 2px, transparent 2px 5px),
      linear-gradient(108deg, var(--accent-strong) 0%, var(--accent) 25%, color-mix(in srgb, var(--accent) 42%, white) 42%, white 50%, color-mix(in srgb, var(--accent) 48%, white) 57%, var(--accent) 76%, var(--accent-strong) 100%);
    background-position: 0 0, 230% 0;
    background-size: 7px 7px, 260% 100%;
    background-repeat: repeat, no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: .35px color-mix(in srgb, var(--accent-strong) 34%, transparent);
    filter: drop-shadow(0 0 7px color-mix(in srgb, white 48%, transparent)) drop-shadow(0 0 18px color-mix(in srgb, var(--accent) 24%, transparent));
    animation: title-char-shimmer 12.8s cubic-bezier(.42, 0, .25, 1) infinite;
    animation-delay: var(--char-delay);
  }

  .hero-tagline {
    margin: clamp(1rem, 2.2vh, 1.45rem) 0 0;
    color: var(--text-primary);
    font-family: var(--font-literary, var(--font-serif));
    font-size: clamp(1.04rem, 1.55vw, 1.38rem);
    font-weight: 520;
    letter-spacing: .18em;
    text-shadow: 0 1px 2px color-mix(in srgb, var(--bg-primary) 72%, transparent), 0 0 18px color-mix(in srgb, var(--bg-primary) 56%, transparent);
  }

  .hero-cta {
    position: relative;
    display: inline-flex;
    min-width: 178px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    margin-top: clamp(1.25rem, 2.6vh, 1.85rem);
    padding: .72rem 1.55rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 56%, transparent);
    border-radius: 999px;
    color: var(--text-on-accent, white);
    background: linear-gradient(145deg, var(--accent-strong), var(--accent) 52%, var(--accent-strong));
    box-shadow: 0 10px 28px color-mix(in srgb, var(--accent-strong) 24%, transparent), inset 0 1px 0 color-mix(in srgb, white 24%, transparent);
    font-size: .86rem;
    font-weight: 650;
    letter-spacing: .08em;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
    animation: cta-ambient-breathe 8s ease-in-out infinite;
  }

  .hero-cta::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: linear-gradient(108deg, transparent 18%, color-mix(in srgb, white 26%, transparent) 42%, transparent 60%);
    background-size: 240% 100%;
    animation: cta-sheen 12s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px color-mix(in srgb, var(--accent-strong) 30%, transparent), inset 0 1px 0 color-mix(in srgb, white 28%, transparent);
  }

  .cta-text {
    position: relative;
    z-index: 1;
    display: inline-flex;
  }

  :global(.cta-char) {
    --char-delay: calc(var(--char-index) * -1.08s);
    display: inline-block;
    color: color-mix(in srgb, white 86%, var(--accent));
    text-shadow: 0 0 10px color-mix(in srgb, white 18%, transparent);
    animation: cta-char-shimmer 13.6s ease-in-out infinite;
    animation-delay: var(--char-delay);
  }

  .hero-description {
    max-width: 640px;
    min-height: 2.9em;
    margin: clamp(.85rem, 1.8vh, 1.15rem) auto 0;
    color: var(--text-secondary);
    font-family: var(--font-literary, var(--font-serif));
    font-size: clamp(.88rem, 1.05vw, 1rem);
    line-height: 1.75;
    letter-spacing: .035em;
    text-wrap: balance;
    text-shadow: 0 1px 10px color-mix(in srgb, var(--bg-primary) 72%, transparent);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .home-shell.is-switching .hero-description {
    opacity: .58;
    transform: translateY(2px);
  }

  .mythology-dock {
    position: relative;
    z-index: 2;
    min-width: 0;
    padding: 0 0 clamp(.8rem, 2vh, 1.35rem);
  }

  .mythology-panel {
    width: 100%;
    max-width: 1500px;
    padding-inline: clamp(.8rem, 2.4vw, 2.25rem);
  }

  .mythology-carousel {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 34px;
    gap: .65rem;
    align-items: center;
  }

  .mythology-viewport {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .mythology-viewport::-webkit-scrollbar { display: none; }

  .mythology-track {
    display: flex;
    width: max-content;
    gap: clamp(.55rem, .8vw, .8rem);
    padding: 4px;
  }

  .mythology-card {
    position: relative;
    flex: 0 0 clamp(154px, 13vw, 188px);
    aspect-ratio: 4 / 3;
    padding: 0;
    overflow: hidden;
    scroll-snap-align: center;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    border-radius: 10px;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--shadow-color, black) 10%, transparent);
    text-align: left;
    cursor: pointer;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .mythology-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 48%, var(--border));
  }

  .mythology-card[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--accent) 82%, white 8%);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 28%, transparent), 0 10px 28px color-mix(in srgb, var(--accent-strong) 20%, transparent);
    transform: translateY(-3px);
  }

  .mythology-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .mythology-card-visual,
  .mythology-card-shade {
    position: absolute;
    inset: 0;
  }

  .mythology-card-visual {
    display: grid;
    place-items: center;
    background-image: var(--card-light-image), radial-gradient(circle at 50% 34%, color-mix(in srgb, var(--accent-soft) 42%, transparent), transparent 42%), linear-gradient(145deg, color-mix(in srgb, var(--bg-secondary) 88%, white 6%), color-mix(in srgb, var(--bg-primary) 86%, var(--bg-secondary)));
    background-position: var(--card-focal-x, 50%) var(--card-focal-y, 50%), center, center;
    background-size: cover;
    transition: transform 7s ease;
  }

  :global([data-theme='dark']) .mythology-card-visual {
    background-image: var(--card-dark-image), radial-gradient(circle at 50% 34%, color-mix(in srgb, var(--accent-soft) 22%, transparent), transparent 42%), linear-gradient(145deg, color-mix(in srgb, var(--bg-secondary) 92%, black 8%), var(--bg-primary));
  }

  .mythology-card:hover .mythology-card-visual,
  .mythology-card[aria-pressed='true'] .mythology-card-visual {
    transform: scale(1.035);
  }

  .mythology-card-number {
    margin-top: -.8rem;
    color: color-mix(in srgb, var(--text-secondary) 28%, transparent);
    font-family: var(--font-display, var(--font-serif));
    font-size: clamp(2rem, 2.8vw, 2.8rem);
    font-weight: 500;
    letter-spacing: .04em;
  }

  .mythology-card--has-image .mythology-card-number { opacity: 0; }

  .mythology-card-shade {
    background: linear-gradient(to top, color-mix(in srgb, var(--bg-primary) 90%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 45%, transparent) 42%, transparent 74%);
  }

  .mythology-card-copy {
    position: absolute;
    z-index: 1;
    right: .8rem;
    bottom: .7rem;
    left: .8rem;
    display: grid;
    gap: .12rem;
  }

  .mythology-card-copy strong {
    overflow: hidden;
    color: var(--text-primary);
    font-family: var(--font-literary, var(--font-serif));
    font-size: .94rem;
    font-weight: 650;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mythology-card-copy small {
    overflow: hidden;
    color: var(--text-secondary);
    font-size: .7rem;
    letter-spacing: .03em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .carousel-button {
    display: grid;
    width: 34px;
    height: 34px;
    padding: 0;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    border-radius: 50%;
    color: var(--text-secondary);

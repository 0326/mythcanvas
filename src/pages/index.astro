---
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMythologies } from '../lib/content/repositories';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const mythologies = await getMythologies(db);
const mythologyBySlug = new Map(mythologies.map((item) => [item.slug, item]));

const heroLightImage = '/bg.png';
const heroDarkImage = '/bg-dark.png';
const heroTitleChars = [...'绘世神话'];
const heroCtaChars = [...'开启神话探索之旅'];

const mythologyCards = [
  {
    slug: 'chinese',
    name: '华夏神话',
    subtitle: '天宫云海',
    href: '/mythology/chinese/',
    image: mythologyBySlug.get('chinese')?.heroImage.src ?? '/art/chinese-celestial.svg',
  },
  {
    slug: 'greek',
    name: '希腊神话',
    subtitle: '奥林匹斯',
    href: '/mythology/greek/',
    image: mythologyBySlug.get('greek')?.heroImage.src ?? '/art/greek-olympus.jpg',
  },
  {
    slug: 'norse',
    name: '北欧神话',
    subtitle: '世界树与诸神',
    href: '/mythology/norse/',
    image: mythologyBySlug.get('norse')?.heroImage.src ?? '/art/norse-asgard.jpg',
  },
  {
    slug: 'japanese',
    name: '日本神话',
    subtitle: '高天原',
    href: '/mythology/japanese/',
    image: mythologyBySlug.get('japanese')?.heroImage.src ?? '/art/japanese-takamagahara.jpg',
  },
  {
    slug: 'indian',
    name: '印度神话',
    subtitle: '诸神与神庙',
    href: '/mythology/',
    image: undefined,
  },
  {
    slug: 'egyptian',
    name: '埃及神话',
    subtitle: '太阳神域',
    href: '/mythology/egyptian/',
    image: mythologyBySlug.get('egyptian')?.heroImage.src ?? '/art/egyptian-duat.jpg',
  },
  {
    slug: 'more',
    name: '更多神话',
    subtitle: '探索更多文明',
    href: '/mythology/',
    image: undefined,
  },
];
---

<BaseLayout
  fullBleed
  immersiveHeader
  hideFooter
  description="绘世神话 MythCanvas：用 AI 重现神话世界。探索华夏、希腊、北欧、日本、印度与埃及神话中的诸神与神域。"
  image={heroLightImage}
>
  <section class="home-shell" aria-labelledby="hero-title">
    <div class="hero-art" aria-hidden="true">
      <img class="hero-art-light" src={heroLightImage} alt="" width="2560" height="1440" fetchpriority="high" />
      <img class="hero-art-dark" src={heroDarkImage} alt="" width="2560" height="1440" fetchpriority="high" />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="hero-stage container-wide">
      <div class="hero-copy">
        <h1 id="hero-title" aria-label="绘世神话">
          {heroTitleChars.map((char, index) => (
            <span class="title-char" style={`--char-index:${index}`} aria-hidden="true">{char}</span>
          ))}
        </h1>
        <p>用 AI 重现神话世界</p>
        <a class="hero-cta" href="/explore/" aria-label="开启神话探索之旅">
          <span class="cta-text" aria-hidden="true">
            {heroCtaChars.map((char, index) => (
              <span class="cta-char" style={`--char-index:${index}`}>{char}</span>
            ))}
          </span>
        </a>
      </div>
    </div>

    <section class="mythology-dock" aria-label="神话文明轮播">
      <div class="container-wide mythology-panel">
        <div class="mythology-carousel">
          <button type="button" class="carousel-button" data-mythology-prev aria-label="上一组神话" disabled>
            <ChevronLeft size={18} strokeWidth={1.8} aria-hidden="true" />
          </button>

          <div class="mythology-viewport" data-mythology-viewport>
            <div class="mythology-track">
              {mythologyCards.map((item) => (
                <a class:list={{ 'mythology-card': true, 'mythology-card--indian': item.slug === 'indian', 'mythology-card--more': item.slug === 'more' }} href={item.href}>
                  <span
                    class="mythology-card-visual"
                    style={item.image ? `background-image: url('${item.image}')` : undefined}
                    aria-hidden="true"
                  ></span>
                  <span class="mythology-card-shade" aria-hidden="true"></span>
                  <span class="mythology-card-copy">
                    <strong>{item.name}</strong>
                    <small>{item.subtitle}</small>
                  </span>
                </a>
              ))}
            </div>
          </div>

          <button type="button" class="carousel-button" data-mythology-next aria-label="下一组神话">
            <ChevronRight size={18} strokeWidth={1.8} aria-hidden="true" />
          </button>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<script>
  const viewport = document.querySelector('[data-mythology-viewport]');
  const previous = document.querySelector('[data-mythology-prev]');
  const next = document.querySelector('[data-mythology-next]');

  if (viewport instanceof HTMLElement && previous instanceof HTMLButtonElement && next instanceof HTMLButtonElement) {
    const updateButtons = () => {
      const maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
      previous.disabled = viewport.scrollLeft <= 2;
      next.disabled = viewport.scrollLeft >= maxScroll - 2;
    };

    const scrollByPage = (direction: number) => {
      viewport.scrollBy({
        left: direction * Math.max(viewport.clientWidth * 0.86, 240),
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };

    previous.addEventListener('click', () => scrollByPage(-1));
    next.addEventListener('click', () => scrollByPage(1));
    viewport.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);
    updateButtons();
  }
</script>

<style>
  .home-shell {
    position: relative;
    display: grid;
    width: 100%;
    min-width: 0;
    height: 100svh;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
    background: var(--bg-primary);
    isolation: isolate;
  }

  .hero-art,
  .hero-art img,
  .hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-art {
    z-index: -3;
    overflow: hidden;
  }

  .hero-art img {
    object-fit: cover;
    object-position: center 42%;
    transition: opacity var(--transition-base), transform 14s ease;
  }

  .home-shell:hover .hero-art img {
    transform: scale(1.018);
  }

  .hero-art-dark {
    opacity: 0;
  }

  :global([data-theme='dark']) .hero-art-light {
    opacity: 0;
  }

  :global([data-theme='dark']) .hero-art-dark {
    opacity: 1;
  }

  .hero-overlay {
    z-index: -2;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 14%, transparent), transparent 28%),
      radial-gradient(circle at 50% 39%, transparent 0 14%, color-mix(in srgb, var(--bg-primary) 10%, transparent) 44%, color-mix(in srgb, var(--bg-primary) 24%, transparent) 78%),
      linear-gradient(to top, color-mix(in srgb, var(--bg-primary) 64%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 28%, transparent) 38%, transparent 78%);
    pointer-events: none;
  }

  .hero-stage {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: none;
    min-width: 0;
    min-height: 0;
    margin-inline: 0;
    padding: clamp(5.2rem, 9vh, 7rem) var(--space-5) clamp(1.5rem, 3vh, 2.5rem);
  }

  .hero-copy {
    position: relative;
    width: min(760px, 100%);
    min-width: 0;
    margin-top: clamp(0rem, 3vh, 2.2rem);
    text-align: center;
  }

  .hero-copy::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 34%;
    left: 50%;
    width: min(620px, 82vw);
    height: clamp(150px, 22vw, 230px);
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(255, 232, 169, .24) 0%, rgba(232, 184, 89, .10) 36%, transparent 72%);
    filter: blur(22px);
    transform: translate(-50%, -50%);
    animation: hero-ambient-breathe 6.8s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-copy h1 {
    display: inline-flex;
    margin: 0;
    align-items: center;
    justify-content: center;
    color: transparent;
    font-family: var(--font-display, var(--font-serif));
    font-size: clamp(3.2rem, 4.8vw, 4.8rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: .98;
    isolation: isolate;
    filter: drop-shadow(0 4px 16px rgba(73, 43, 12, .24));
  }

  .title-char {
    --char-delay: calc(var(--char-index) * -1.24s);
    display: inline-block;
    margin-inline: .06em;
    color: transparent;
    background-image:
      repeating-linear-gradient(18deg, rgba(255,255,255,.10) 0 1px, rgba(120,74,20,.08) 1px 2px, transparent 2px 5px),
      radial-gradient(circle at 28% 24%, rgba(255,247,211,.55) 0 3%, transparent 13%),
      linear-gradient(108deg,
        #8c5a1e 0%,
        #bd8734 23%,
        #e6bd68 39%,
        #fff4c2 47%,
        #ffffff 50%,
        #f6d77f 56%,
        #c28a34 72%,
        #8d5b20 100%);
    background-position: 0 0, 0 0, 230% 0;
    background-size: 7px 7px, 100% 100%, 260% 100%;
    background-repeat: repeat, no-repeat, no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: .35px rgba(115, 73, 24, .32);
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, .45)) drop-shadow(0 0 14px rgba(255, 255, 255, .22));
    animation: title-char-shimmer 9.8s cubic-bezier(.42,0,.25,1) infinite;
    animation-delay: var(--char-delay);
    will-change: filter, background-position;
  }

  .hero-copy p {
    margin: clamp(1rem, 2.2vh, 1.5rem) 0 0;
    color: var(--text-primary);
    font-family: var(--font-literary, var(--font-serif));
    font-size: clamp(1.05rem, 1.65vw, 1.42rem);
    font-weight: 520;
    letter-spacing: .18em;
    text-shadow:
      0 1px 2px color-mix(in srgb, var(--bg-primary) 70%, transparent),
      0 0 16px color-mix(in srgb, var(--bg-primary) 48%, transparent);
  }

  .hero-cta {
    position: relative;
    display: inline-flex;
    min-width: 188px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    margin-top: clamp(1.35rem, 2.8vh, 2rem);
    padding: .72rem 1.55rem;
    overflow: hidden;
    border: 1px solid rgba(255, 225, 153, .58);
    border-radius: 999px;
    color: #fff8dc;
    background:
      repeating-linear-gradient(135deg, rgba(255,255,255,.045) 0 1px, transparent 1px 5px),
      radial-gradient(circle at 28% 20%, rgba(255,244,194,.18), transparent 32%),
      linear-gradient(145deg, rgba(133, 83, 24, .90), rgba(190, 133, 45, .94) 48%, rgba(112, 67, 20, .94));
    box-shadow:
      0 10px 28px rgba(125, 77, 18, .22),
      inset 0 1px 0 rgba(255,255,255,.24),
      inset 0 -1px 0 rgba(85,48,10,.24);
    font-size: .86rem;
    font-weight: 650;
    letter-spacing: .08em;
    text-shadow: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
    animation: cta-ambient-breathe 5.6s ease-in-out infinite;
  }

  .hero-cta::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background:
      radial-gradient(circle at 20% 30%, rgba(255,255,255,.12) 0 1px, transparent 1.5px) 0 0 / 11px 11px,
      linear-gradient(to bottom, rgba(255,255,255,.06), transparent 45%);
    mix-blend-mode: screen;
    opacity: .55;
    pointer-events: none;
  }

  .cta-text {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cta-char {
    --char-delay: calc(var(--char-index) * -0.28s);
    display: inline-block;
    color: transparent;
    background-image: linear-gradient(105deg,
      #f4d17c 0%,
      #fff4bf 28%,
      #ffffff 47%,
      #fff8d6 52%,
      #e8bd59 70%,
      #f4d17c 100%);
    background-position: 220% 0;
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 1px rgba(70,38,8,.34));
    animation: cta-char-shimmer 3.8s cubic-bezier(.42,0,.3,1) infinite;
    animation-delay: var(--char-delay);
  }

  .hero-cta:hover,
  .hero-cta:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(255, 237, 184, .88);
    color: #fff8dc;
    box-shadow:
      0 14px 36px rgba(163, 104, 26, .30),
      0 0 30px rgba(246, 200, 104, .18),
      inset 0 1px 0 rgba(255,255,255,.3);
  }

  @keyframes title-char-shimmer {
    0%, 18% {
      background-position: 0 0, 0 0, 230% 0;
      filter: drop-shadow(0 0 7px rgba(255, 255, 255, .48)) drop-shadow(0 0 18px rgba(255, 255, 255, .28)) drop-shadow(0 0 42px rgba(255, 255, 255, .16));
    }
    48% {
      background-position: 0 0, 0 0, 48% 0;
      filter: drop-shadow(0 0 12px rgba(255, 255, 255, .72)) drop-shadow(0 0 30px rgba(255, 255, 255, .48)) drop-shadow(0 0 64px rgba(255, 255, 255, .26));
    }
    76%, 100% {
      background-position: 0 0, 0 0, -150% 0;
      filter: drop-shadow(0 0 7px rgba(255, 255, 255, .50)) drop-shadow(0 0 18px rgba(255, 255, 255, .30)) drop-shadow(0 0 42px rgba(255, 255, 255, .18));
    }
  }

  @keyframes cta-char-shimmer {
    0%, 24% { background-position: 220% 0; }
    58% { background-position: 45% 0; }
    84%, 100% { background-position: -140% 0; }
  }

  @keyframes hero-ambient-breathe {
    0%, 100% { opacity: .68; transform: translate(-50%, -50%) scale(.96); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
  }

  @keyframes cta-ambient-breathe {
    0%, 100% {
      box-shadow: 0 10px 28px rgba(125,77,18,.20), inset 0 1px 0 rgba(255,255,255,.22), inset 0 -1px 0 rgba(85,48,10,.22);
    }
    50% {
      box-shadow: 0 12px 34px rgba(157,99,22,.28), 0 0 22px rgba(246,198,94,.13), inset 0 1px 0 rgba(255,255,255,.28), inset 0 -1px 0 rgba(85,48,10,.18);
    }
  }

  .mythology-dock {
    position: relative;
    z-index: 2;
    min-width: 0;
    padding: 0 clamp(.75rem, 2vw, 1.5rem) clamp(.75rem, 1.6vh, 1.1rem);
  }

  .mythology-panel {
    min-width: 0;
    padding: clamp(.75rem, 1.5vh, 1rem) clamp(.85rem, 1.6vw, 1.2rem) clamp(.85rem, 1.6vh, 1.1rem);
    border: 1px solid color-mix(in srgb, var(--border-strong) 72%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--surface) 58%, transparent);
    box-shadow: 0 20px 48px color-mix(in srgb, var(--bg-primary) 18%, transparent);
    backdrop-filter: blur(5px) saturate(108%);
  }

  .mythology-carousel {
    display: flex;
    align-items: center;
    gap: clamp(.45rem, 1vw, .8rem);
  }

  .mythology-carousel .mythology-viewport {
    flex: 1 1 auto;
  }

  .carousel-button {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--border-strong) 78%, transparent);
    border-radius: 50%;
    color: var(--text-secondary);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast), opacity var(--transition-fast);
  }

  .carousel-button:not(:disabled):hover,
  .carousel-button:not(:disabled):focus-visible {
    border-color: var(--accent);
    color: var(--accent-strong);
    transform: translateY(-1px);
  }

  .carousel-button:disabled {
    cursor: default;
    opacity: .32;
  }

  .mythology-viewport {
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .mythology-viewport::-webkit-scrollbar {
    display: none;
  }

  .mythology-track {
    --card-gap: .75rem;
    display: flex;
    gap: var(--card-gap);
    width: 100%;
    min-width: 0;
    justify-content: flex-start;
  }

  .mythology-card {
    position: relative;
    flex: 0 0 calc((100% - (var(--card-gap) * 5)) / 6);
    min-width: 148px;
    max-width: none;
    height: auto;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border-strong) 68%, transparent);
    border-radius: 10px;
    scroll-snap-align: start;
    background: var(--bg-secondary);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--bg-primary) 14%, transparent);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .mythology-card:hover,
  .mythology-card:focus-visible {
    transform: none;
    border-color: color-mix(in srgb, var(--accent) 62%, var(--border-strong));
    box-shadow: 0 12px 30px color-mix(in srgb, var(--bg-primary) 21%, transparent);
  }

  .mythology-card-visual,
  .mythology-card-shade {
    position: absolute;
    inset: 0;
  }

  .mythology-card-visual {
    background-position: center;
    background-size: cover;
    transform: scale(1.01);
    transition: transform 1.1s ease;
  }

  .mythology-card:hover .mythology-card-visual,
  .mythology-card:focus-visible .mythology-card-visual {
    transform: scale(1.055);
  }

  .mythology-card--indian .mythology-card-visual {
    background:
      radial-gradient(circle at 70% 25%, rgba(255, 220, 135, .58), transparent 22%),
      linear-gradient(145deg, #7f3f2c 0%, #c88b4d 48%, #f1d59c 100%);
  }

  .mythology-card--more .mythology-card-visual {
    background:
      radial-gradient(circle at 72% 22%, color-mix(in srgb, var(--accent) 40%, transparent), transparent 30%),
      linear-gradient(135deg, color-mix(in srgb, var(--bg-secondary) 88%, var(--accent)), color-mix(in srgb, var(--surface) 80%, var(--accent)));
  }

  .mythology-card-shade {
    background: linear-gradient(to top, rgba(6, 13, 20, .82), rgba(6, 13, 20, .02) 74%);
  }

  .mythology-card-copy {
    position: absolute;
    right: .72rem;
    bottom: .62rem;
    left: .72rem;
    z-index: 1;
    display: grid;
    gap: .15rem;
    color: white;
    text-shadow: 0 2px 12px rgba(0, 0, 0, .35);
  }

  .mythology-card-copy strong {
    font-family: var(--font-serif);
    font-size: clamp(.76rem, 1vw, .92rem);
    font-weight: 650;
    letter-spacing: .05em;
  }

  .mythology-card-copy small {
    overflow: hidden;
    color: rgba(255, 255, 255, .76);
    font-size: .6rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1180px) {
    .mythology-card { flex-basis: calc((100vw - 5.5rem - (var(--card-gap) * 4)) / 5); max-width: none; }
  }

  @media (max-width: 960px) {
    .hero-copy h1 { font-size: clamp(3rem, 8vw, 4.4rem); }
    .mythology-card { flex-basis: calc((100% - (var(--card-gap) * 3)) / 4); }
  }

  @media (max-width: 820px) {
    .hero-stage { padding-top: 8.7rem; }
    .hero-copy { margin-top: 0; }
    .title-char { margin-inline: .035em; }
    .mythology-panel { border-radius: 12px; }
    .mythology-card { flex-basis: min(34vw, 200px); min-width: 150px; }
  }

  @media (max-width: 560px) {
    .hero-stage { padding: 8.2rem 1rem 1rem; }
    .hero-copy { width: 100%; }
    .hero-copy h1 { font-size: clamp(2.55rem, 13vw, 3.55rem); }
    .hero-copy p { font-size: .94rem; letter-spacing: .13em; }
    .hero-cta { min-width: 176px; min-height: 42px; margin-top: 1.25rem; }
    .mythology-dock { padding-inline: .55rem; padding-bottom: .55rem; }
    .mythology-panel { padding: .7rem; }
    .mythology-card { flex-basis: 44vw; min-width: 142px; }
  }

  @media (max-height: 720px) and (min-width: 821px) {
    .hero-stage { padding-top: 4.8rem; padding-bottom: .85rem; }
    .hero-copy h1 { font-size: clamp(3rem, 5.4vw, 4.45rem); }
    .hero-copy p { margin-top: .8rem; }
    .hero-cta { min-height: 40px; margin-top: 1rem; padding-block: .58rem; }
    .mythology-panel { padding-block: .65rem .75rem; }
    .mythology-card { height: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art img,
    .mythology-card,
    .mythology-card-visual,
    .hero-cta,
    .carousel-button {
      transition: none;
    }

    .title-char,
    .cta-char,
    .hero-copy::before,
    .hero-cta {
      animation: none;
    }

    .title-char { background-position: 0 0, 0 0, 50% 0; filter: drop-shadow(0 0 10px rgba(255, 255, 255, .56)) drop-shadow(0 0 26px rgba(255, 255, 255, .30)) drop-shadow(0 0 54px rgba(255, 255, 255, .18)); }
    .cta-char { background-position: 50% 0; }
    .mythology-viewport { scroll-behavior: auto; }
  }
</style>
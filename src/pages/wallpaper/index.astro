---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkCard from '../../components/artwork/ArtworkCard.astro';
import {
  getPublicArtworks,
  getPublicMythologies,
  getPublicWorlds,
} from '../../lib/content/public-catalog';

export const prerender = false;

const PAGE_SIZE = 24;
const requestedPage = Astro.url.searchParams.size === 1 ? Astro.url.searchParams.get('page') : null;
const parsedPage = requestedPage && /^[1-9]\d*$/.test(requestedPage) ? Number(requestedPage) : 1;
const currentPage = Number.isSafeInteger(parsedPage) ? parsedPage : 1;

const [artworkPage, mythologiesById, worldsById] = await Promise.all([
  getPublicArtworks({ limit: PAGE_SIZE + 1, offset: (currentPage - 1) * PAGE_SIZE }),
  Promise.resolve(new Map(getPublicMythologies().map((item) => [item.id, item]))),
  Promise.resolve(new Map(getPublicWorlds().map((item) => [item.id, item]))),
]);

if (currentPage > 1 && artworkPage.length === 0) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

const hasNextPage = artworkPage.length > PAGE_SIZE;
const approvedArtworks = artworkPage.slice(0, PAGE_SIZE);
const paginationHref = (page: number) => page <= 1 ? '/wallpaper/' : `/wallpaper/?page=${page}`;
const pageTitle = currentPage > 1 ? `精选壁纸 · 第 ${currentPage} 页` : '精选壁纸';
const pageDescription = currentPage > 1
  ? `浏览绘神宇宙精选神话壁纸第 ${currentPage} 页，发现可下载、收藏和重新创作的神话视觉作品。`
  : '下载与收藏绘神宇宙的精选神话视觉壁纸。';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="collection-hero">
    <div class="container-wide">
      <span class="eyebrow">Wallpapers · Curated Visuals</span>
      <h1>精选壁纸</h1>
      <p>场景优先、角色并行。找到一张让你想带走的神话视觉作品。</p>
    </div>
  </section>
  <section class="section-compact">
    <div class="container-wide">
      <div class="collection-head"><span class="small-caps">All mythologies</span><span>第 {currentPage} 页 · {approvedArtworks.length} 件作品</span></div>
      {approvedArtworks.length > 0 ? (
        <div class="artwork-grid">
          {approvedArtworks.map((artwork) => <ArtworkCard artwork={artwork} mythologyName={mythologiesById.get(artwork.mythologyId)?.name} worldName={artwork.worldId ? worldsById.get(artwork.worldId)?.name : undefined} />)}
        </div>
      ) : (
        <div class="collection-empty">
          <h2>这一页还没有作品</h2>
          <p>返回精选壁纸首页，继续发现神话视觉。</p>
          <a class="btn btn-secondary" href="/wallpaper/">返回第一页</a>
        </div>
      )}

      {(currentPage > 1 || hasNextPage) && (
        <nav class="pagination" aria-label="壁纸分页">
          {currentPage > 1 ? (
            <a class="pagination-link" href={paginationHref(currentPage - 1)} rel="prev">
              <ArrowLeft size={17} strokeWidth={1.8} aria-hidden="true" />
              上一页
            </a>
          ) : <span class="pagination-spacer" aria-hidden="true"></span>}
          <span class="pagination-current" aria-current="page">第 {currentPage} 页</span>
          {hasNextPage ? (
            <a class="pagination-link" href={paginationHref(currentPage + 1)} rel="next">
              下一页
              <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
            </a>
          ) : <span class="pagination-spacer" aria-hidden="true"></span>}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .collection-hero { padding-block: clamp(4rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--border); background: radial-gradient(circle at 82% 20%, var(--hero-ambient), transparent 28%); }
  h1 { margin: 0; font-size: clamp(3rem, 6vw, 5.4rem); }
  .collection-hero p { max-width: 42rem; margin: var(--space-5) 0 0; color: var(--text-secondary); }
  .collection-head { display: flex; justify-content: space-between; align-items: end; margin-bottom: var(--space-6); color: var(--text-muted); font-size: .8rem; }
  .artwork-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
  .collection-empty { padding-block: var(--space-12); text-align: center; }
  .collection-empty h2 { margin: 0; }
  .collection-empty p { margin: var(--space-3) 0 var(--space-6); color: var(--text-secondary); }
  .pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-4); margin-top: var(--space-10); padding-top: var(--space-6); border-top: 1px solid var(--border); }
  .pagination-link { display: inline-flex; align-items: center; gap: .45rem; width: max-content; min-height: 40px; padding-inline: .8rem; border: 1px solid var(--border); border-radius: 8px; color: var(--text-secondary); background: var(--surface); }
  .pagination-link:last-child { justify-self: end; }
  .pagination-link:hover { border-color: var(--border-strong); color: var(--text-primary); }
  .pagination-current { color: var(--text-muted); font-size: .82rem; }
  .pagination-spacer { min-width: 1px; }
  @media (max-width: 900px) { .artwork-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 680px) {
    .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pagination { gap: var(--space-2); }
    .pagination-link { padding-inline: .65rem; font-size: .82rem; }
    .pagination-current { font-size: .75rem; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUserBySessionId, readSessionId } from '../lib/auth/session';
import { safeRedirect } from '../lib/auth/redirect';

export const prerender = false;

const sessionId = readSessionId(Astro.request);
const currentUser = sessionId ? await getUserBySessionId(Astro.locals.runtime.env.SESSION, sessionId) : null;
const redirectTarget = safeRedirect(Astro.url.searchParams.get('redirect'));
const isLoggedIn = Boolean(currentUser && !currentUser.isGuest);
---

<BaseLayout
  title="登录 · 绘神宇宙"
  description="登录 MythCanvas 绘神宇宙，保存你的神话壁纸、收藏与 AI 创作。"
>
  <section class="auth-hero">
    <div class="container-narrow">
      <span class="eyebrow">进入 MythCanvas</span>
      <h1>回到你的神话宇宙</h1>
      <p class="auth-sub">可以使用邮箱验证码或邮箱密码登录。注册时只需验证一次邮箱，之后可自由选择登录方式。</p>
    </div>
  </section>

  <section class="auth-section" data-redirect={redirectTarget}>
    <div class="container-narrow">
      {isLoggedIn ? (
        <div class="surface auth-card" data-state="logged-in">
          <p class="auth-done">当前账号：<strong>{currentUser!.email ?? currentUser!.nickname}</strong></p>
          <a class="btn btn-primary" href={redirectTarget}>继续进入</a>
          <button class="auth-link-button" type="button" data-logout>退出当前账号</button>
          <div class="auth-status" data-status role="status" aria-live="polite" hidden></div>
        </div>
      ) : (
        <div class="surface auth-card">
          <div class="auth-switch" role="tablist" aria-label="登录方式">
            <button class="auth-switch-button is-active" type="button" role="tab" aria-selected="true" data-login-mode="password">密码登录</button>
            <button class="auth-switch-button" type="button" role="tab" aria-selected="false" data-login-mode="otp">邮箱验证码登录</button>
          </div>

          <form class="auth-form" data-login-password>
            <label class="field">
              <span class="field-label">邮箱</span>
              <input type="email" name="email" inputmode="email" autocomplete="email" required placeholder="你的邮箱地址" aria-label="邮箱地址" />
            </label>
            <label class="field">
              <span class="field-label">密码</span>
              <input type="password" name="password" autocomplete="current-password" required minlength="8" placeholder="至少 8 位密码" aria-label="密码" />
            </label>
            <button class="btn btn-primary" type="submit" data-submit>登录</button>
            <div class="auth-links">
              <a href="/register/">注册账号</a>
              <a href="/password/">忘记密码 / 首次设置密码</a>
            </div>
          </form>

          <form class="auth-form" data-login-otp hidden>
            <label class="field">
              <span class="field-label">邮箱</span>
              <input type="email" name="email" inputmode="email" autocomplete="email" required placeholder="你的邮箱地址" aria-label="验证码登录邮箱" />
            </label>
            <div class="code-row">
              <label class="field">
                <span class="field-label">邮箱验证码</span>
                <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required placeholder="6 位验证码" aria-label="邮箱验证码" />
              </label>
              <button class="btn btn-secondary code-button" type="button" data-send-code>发送验证码</button>
            </div>
            <p class="auth-note">验证码 10 分钟内有效，发送后 60 秒可再次获取。</p>
            <button class="btn btn-primary" type="submit" data-otp-submit>登录</button>
            <div class="auth-links">
              <a href="/register/">注册账号</a>
              <a href="/password/">设置或重置密码</a>
            </div>
          </form>

          <div class="auth-status" data-status role="alert" aria-live="assertive" hidden></div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector('[data-redirect]');
  const statusEl = root?.querySelector('[data-status]') as HTMLElement | null;
  const redirectTarget = root?.getAttribute('data-redirect') ?? '/my/';
  const passwordForm = document.querySelector('[data-login-password]') as HTMLFormElement | null;
  const otpForm = document.querySelector('[data-login-otp]') as HTMLFormElement | null;
  const sendCodeButton = document.querySelector('[data-send-code]') as HTMLButtonElement | null;
  let otpNonceId = '';
  let countdownTimer = 0;

  document.querySelectorAll('[data-login-mode]').forEach((button) => {
    button.addEventListener('click', () => {
      const mode = button.getAttribute('data-login-mode') === 'otp' ? 'otp' : 'password';
      document.querySelectorAll('[data-login-mode]').forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
      });
      if (passwordForm) passwordForm.hidden = mode !== 'password';
      if (otpForm) otpForm.hidden = mode !== 'otp';
      setStatus('', '');
    });
  });

  passwordForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const submit = form.querySelector('[data-submit]') as HTMLButtonElement;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;
    setStatus('登录中…', '');
    submit.disabled = true;
    try {
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, password, redirect: redirectTarget }),
      });
      const data = await response.json();
      if (!response.ok) {
        setStatus(data?.error?.message ?? '登录失败，请检查邮箱和密码。', 'error');
        return;
      }
      setStatus(data.message ?? '登录成功，正在进入…', 'ok');
      window.location.href = data.redirect || redirectTarget;
    } catch {
      setStatus('网络异常，请重试。', 'error');
    } finally {
      submit.disabled = false;
    }
  });

  sendCodeButton?.addEventListener('click', async () => {
    if (!otpForm) return;
    const emailInput = otpForm.elements.namedItem('email') as HTMLInputElement;
    if (!emailInput.reportValidity()) return;
    sendCodeButton.disabled = true;
    setStatus('正在发送验证码…', '');
    try {
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'request', email: emailInput.value.trim() }),
      });
      const data = await response.json();
      if (!response.ok) {
        setStatus(data?.error?.message ?? '验证码发送失败，请稍后重试。', 'error');
        sendCodeButton.disabled = false;
        return;
      }
      otpNonceId = data.nonceId ?? '';
      setStatus(data.message ?? '验证码已发送，请查收邮件。', 'ok');
      if (data.devFallback?.otp) setStatus(`开发模式验证码：${data.devFallback.otp}`, 'ok');
      startCountdown(Number(data.resendAfterSeconds) || 60);
    } catch {
      setStatus('网络异常，请重试。', 'error');
      sendCodeButton.disabled = false;
    }
  });

  otpForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const submit = form.querySelector('[data-otp-submit]') as HTMLButtonElement;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const code = (form.elements.namedItem('code') as HTMLInputElement).value.trim();
    if (!otpNonceId) {
      setStatus('请先发送验证码。', 'error');
      return;
    }
    setStatus('登录中…', '');
    submit.disabled = true;
    try {
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'complete', email, code, nonceId: otpNonceId, redirect: redirectTarget }),
      });
      const data = await response.json();
      if (!response.ok) {
        setStatus(data?.error?.message ?? '登录失败，请检查验证码。', 'error');
        return;
      }
      setStatus(data.message ?? '登录成功，正在进入…', 'ok');
      window.location.href = data.redirect || redirectTarget;
    } catch {
      setStatus('网络异常，请重试。', 'error');
    } finally {
      submit.disabled = false;
    }
  });

  document.querySelector('[data-logout]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    await fetch('/api/user', { method: 'DELETE' }).catch(() => undefined);
    window.location.reload();
  });

  function startCountdown(seconds: number) {
    if (!sendCodeButton) return;
    window.clearInterval(countdownTimer);
    let remaining = Math.max(1, Math.ceil(seconds));
    sendCodeButton.disabled = true;
    sendCodeButton.textContent = `重新发送（${remaining}s）`;
    countdownTimer = window.setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        window.clearInterval(countdownTimer);
        sendCodeButton.disabled = false;
        sendCodeButton.textContent = '重新发送验证码';
      } else {
        sendCodeButton.textContent = `重新发送（${remaining}s）`;
      }
    }, 1000);
  }

  function setStatus(message: string, kind: 'ok' | 'error' | '') {
    if (!statusEl) return;
    statusEl.hidden = !message;
    statusEl.dataset.kind = kind;
    statusEl.textContent = message;
  }
</script>

<style>
  .container-narrow { width: min(100% - 40px, 480px); margin-inline: auto; }
  .auth-hero { padding: var(--space-16) 0 var(--space-8); text-align: center; }
  .auth-hero h1 { margin: var(--space-3) 0 var(--space-4); font-size: clamp(1.75rem, 3vw, 2.4rem); }
  .auth-sub { max-width: 34rem; margin: 0 auto; color: var(--text-secondary); line-height: 1.7; }
  .auth-section { padding: var(--space-6) 0 var(--space-20); }
  .auth-card { padding: var(--space-8); border-radius: var(--radius-lg); }
  .auth-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-bottom: var(--space-6); padding: 4px; border-radius: var(--radius-md); background: var(--surface-muted); }
  .auth-switch-button { min-height: 40px; border: 0; border-radius: calc(var(--radius-md) - 2px); color: var(--text-secondary); background: transparent; cursor: pointer; font: inherit; font-size: .88rem; }
  .auth-switch-button.is-active { color: var(--text-primary); background: var(--surface); box-shadow: var(--shadow-sm); }
  .auth-form { display: grid; gap: var(--space-4); }
  .field { display: grid; gap: var(--space-2); }
  .field-label { color: var(--text-secondary); font-size: .85rem; font-weight: 650; }
  .field input { width: 100%; min-height: 46px; padding: .7rem .8rem; border: 1px solid var(--border-strong); border-radius: var(--radius-md); color: var(--text-primary); background: var(--surface-muted); }
  .code-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--space-3); }
  .code-button { min-height: 46px; white-space: nowrap; }
  .auth-note { margin: calc(var(--space-2) * -1) 0 0; color: var(--text-tertiary); font-size: .78rem; line-height: 1.5; }
  .auth-links { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); font-size: .82rem; }
  .auth-links a, .auth-link-button { color: var(--accent-strong); text-decoration: none; }
  .auth-link-button { display: block; margin: var(--space-4) auto 0; border: 0; padding: 0; background: transparent; cursor: pointer; font-size: .82rem; }
  .auth-status { margin-top: var(--space-4); padding: var(--space-3); border-radius: var(--radius-md); color: var(--text-primary); font-size: .85rem; line-height: 1.6; }
  .auth-status[data-kind='ok'] { background: color-mix(in srgb, var(--success) 14%, transparent); }
  .auth-status[data-kind='error'] { background: color-mix(in srgb, var(--danger) 14%, transparent); }
  .auth-done { margin: 0; color: var(--text-primary); line-height: 1.7; }
  .auth-done + .btn { width: 100%; margin-top: var(--space-5); }
  @media (max-width: 560px) {
    .auth-card { padding: var(--space-6); }
    .auth-links { justify-content: flex-start; }
    .code-row { grid-template-columns: 1fr; }
    .code-button { width: 100%; }
  }
</style>

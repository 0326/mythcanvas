---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;
---
<BaseLayout title="内容审核台" description="MythCanvas 运营审核后台">
  <section class="admin-hero">
    <div class="container-wide">
      <span class="eyebrow">Admin · Content Review</span>
      <h1>内容审核台</h1>
      <p>审核用户申请公开的绘神作品，通过后发布进探索页。</p>
    </div>
  </section>
  <section class="section-compact">
    <div class="container-wide" data-admin>
      <div class="admin-toolbar surface">
        <label class="admin-token">
          <span>访问令牌</span>
          <input type="password" placeholder="输入 ADMIN_TOKEN" data-token />
          <small>仅本站可访问；发布后在环境变量 ADMIN_TOKEN 配置。</small>
        </label>
        <div class="admin-filters">
          <button class="chip is-active" type="button" data-status="pending" aria-pressed="true">待审核</button>
          <button class="chip" type="button" data-status="all" aria-pressed="false">全部</button>
        </div>
      </div>
      <div class="empty-state surface" data-empty>暂无审核记录。</div>
      <div class="submission-list" data-list></div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-admin]');
    if (!root) return;
    const list = root.querySelector('[data-list]');
    const empty = root.querySelector('[data-empty]');
    const tokenInput = root.querySelector('[data-token]');
    let statusFilter = 'pending';

    const currentToken = () => tokenInput instanceof HTMLInputElement ? tokenInput.value.trim() : '';

    const load = async () => {
      const token = currentToken();
      if (!token) { list.innerHTML = ''; return; }
      try {
        const res = await fetch(`/api/admin/review?status=${statusFilter}`, {
          headers: { authorization: `Bearer ${token}` },
        });
        if (res.status === 401) { list.innerHTML = '<p class="admin-msg">令牌无效，请检查 ADMIN_TOKEN 后重试。</p>'; return; }
        const data = await res.json();
        render(data.items || []);
      } catch {
        list.innerHTML = '<p class="admin-msg">加载失败，请稍后重试。</p>';
      }
    };

    const render = (items) => {
      if (empty) empty.hidden = items.length !== 0;
      list.innerHTML = '';
      items.forEach((item) => {
        const card = document.createElement('div');
        card.className = 'submission-card surface';
        card.innerHTML = `
          <div class="submission-main">
            <div class="submission-meta">
              <span class="status status-${escapeHtml(item.status)}">${item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已发布' : '已拒绝'}</span>
              <span class="submission-date">${escapeHtml((item.createdAt || '').slice(0, 16))}</span>
            </div>
            <h3>${escapeHtml(item.title)}</h3>
            <p>${escapeHtml(item.name)}</p>
            <p class="submission-alt">${escapeHtml(item.altText)}</p>
          </div>
          <div class="submission-actions">
            ${item.status === 'pending' ? `
              <button class="btn btn-primary" type="button" data-approve="${escapeHtml(item.id)}">通过并发布</button>
              <button class="btn btn-secondary" type="button" data-reject="${escapeHtml(item.id)}">拒绝</button>
            ` : `<span class="reviewed-note">${escapeHtml(item.reviewNote || '')}</span>`}
          </div>`;
        card.querySelector('[data-approve]')?.addEventListener('click', () => act(item.id, 'approve'));
        card.querySelector('[data-reject]')?.addEventListener('click', () => act(item.id, 'reject'));
        list.appendChild(card);
      });
    };

    const act = async (id, action) => {
      const token = currentToken();
      try {
        const res = await fetch('/api/admin/review', {
          method: 'POST',
          headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
          body: JSON.stringify({ id, action }),
        });
        const data = await res.json();
        alert(data.message || (res.ok ? '操作成功' : '操作失败'));
        if (res.ok) load();
      } catch { alert('网络错误，请重试'); }
    };

    const escapeHtml = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    tokenInput?.addEventListener('input', load);
    root.querySelectorAll('[data-status]').forEach((btn) => {
      btn.addEventListener('click', () => {
        statusFilter = btn.dataset.status;
        root.querySelectorAll('[data-status]').forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        load();
      });
    });
  })();
</script>

<style>
  .admin-hero { padding-block: clamp(4rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--border); }
  .admin-hero h1 { margin: 0; font-size: clamp(2.8rem, 5vw, 5rem); }
  .admin-hero p { max-width: 42rem; margin: var(--space-5) 0 0; color: var(--text-secondary); }
  .admin-toolbar { display: grid; gap: var(--space-4); padding: var(--space-5); margin-bottom: var(--space-6); border-radius: var(--radius-lg); }
  .admin-token { display: grid; gap: var(--space-2); }
  .admin-token span { font-size: .76rem; font-weight: 700; color: var(--text-secondary); }
  .admin-token input { min-height: 40px; padding: .55rem .75rem; border: 1px solid var(--border); border-radius: 6px; color: var(--text-primary); background: var(--surface); }
  .admin-token small { color: var(--text-muted); font-size: .7rem; }
  .admin-filters { display: flex; gap: var(--space-2); }
  .submission-list { display: grid; gap: var(--space-4); }
  .submission-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-5); align-items: start; padding: var(--space-5); border-radius: var(--radius-lg); }
  .submission-meta { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2); }
  .status { padding: .2rem .5rem; border-radius: var(--radius-pill); font-size: .66rem; font-weight: 700; }
  .status-pending { color: #8a5a00; background: color-mix(in srgb, var(--accent) 18%, transparent); }
  .status-approved { color: var(--jade, #2e7d5b); background: color-mix(in srgb, var(--jade, #2e7d5b) 16%, transparent); }
  .status-rejected { color: var(--text-secondary); background: var(--surface-muted); }
  .submission-date { color: var(--text-muted); font-size: .72rem; }
  .submission-card h3 { margin: 0 0 var(--space-1); font-size: 1.15rem; }
  .submission-card p { margin: 0; color: var(--text-secondary); font-size: .8rem; }
  .submission-alt { margin-top: var(--space-2) !important; color: var(--text-muted) !important; font-size: .72rem !important; }
  .submission-actions { display: grid; gap: var(--space-2); }
  .reviewed-note { color: var(--text-muted); font-size: .72rem; }
  .admin-msg { padding: var(--space-4); color: var(--text-secondary); }
  .empty-state { padding: var(--space-16) var(--space-6); border-radius: var(--radius-lg); text-align: center; color: var(--text-muted); }
  @media (max-width: 720px) { .submission-card { grid-template-columns: 1fr; } }
</style>
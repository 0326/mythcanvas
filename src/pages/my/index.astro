---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkCard from '../../components/artwork/ArtworkCard.astro';
import { getOrCreateUser } from '../../lib/auth/session';
import { listGenerationsByUser } from '../../lib/cloudflare/generation-repository';
import { listFavorites } from '../../lib/social/favorites';
import { getArtworkById, getCharacterById, getRealmById } from '../../lib/content/repositories';

export const prerender = false;

const sessionResult = await getOrCreateUser(Astro.locals.runtime.env.SESSION, Astro.request);
const user = sessionResult.user;
const generations = await listGenerationsByUser(Astro.locals.runtime.env.DB, user.id);
const favorites = await listFavorites(Astro.locals.runtime.env.DB, user.id);

// 预解析收藏对象（artwork/character/realm）
const favoriteEntities = await Promise.all(
  favorites.map(async (fav) => {
    if (fav.targetType === 'artwork') return { fav, entity: await getArtworkById(Astro.locals.runtime.env.DB, fav.targetId) };
    if (fav.targetType === 'character') return { fav, entity: await getCharacterById(Astro.locals.runtime.env.DB, fav.targetId) };
    if (fav.targetType === 'realm') return { fav, entity: await getRealmById(Astro.locals.runtime.env.DB, fav.targetId) };
    return { fav, entity: undefined };
  }),
);
const favoriteArtworks = favoriteEntities
  .filter((item) => item.fav.targetType === 'artwork' && item.entity)
  .map((item) => item.entity);
const myCookie = sessionResult.cookie;
---

<BaseLayout title="我的宇宙" description="管理你收藏的神话角色、神域与视觉作品，以及你的绘神历史。">
  <section class="collection-hero">
    <div class="container-wide">
      <span class="eyebrow">My Universe · Your Collection</span>
      <h1>我的宇宙</h1>
      <p>收藏你喜欢的角色、神域与壁纸，让 MythCanvas 慢慢长成一套属于你的审美宇宙。</p>
    </div>
  </section>
  <section class="section-compact">
    <div class="container-wide my-grid">
      <aside class="profile surface">
        <div class="profile-avatar">{user.nickname.slice(0, 1)}</div>
        <div>
          <strong data-nickname>{user.nickname}</strong>
          <span>{user.isGuest ? '游客' : '已登录探索者'} · {generations.length} 个生成作品</span>
        </div>
        <details class="login-form">
          <summary>设置昵称 / 登录</summary>
          <form onsubmit="return false">
            <input type="text" maxlength="24" placeholder="输入昵称（可选）" data-profile-name />
            <button class="btn btn-secondary" type="button" data-profile-save>保存</button>
          </form>
          {!user.isGuest && <button class="btn btn-secondary" type="button" data-profile-logout>登出</button>}
        </details>
        <a class="btn btn-primary" href="/create/">开始绘神</a>
      </aside>

      <div class="my-content">
        <div class="my-tabs" role="tablist">
          <button class="is-active" type="button" role="tab" data-my-tab="generations" aria-selected="true">我的绘神 <span>({generations.length})</span></button>
          <button type="button" role="tab" data-my-tab="favorites" aria-selected="false">我的收藏 <span>({favoriteArtworks.length})</span></button>
        </div>

        <div class="tab-panel generations-panel" data-panel="generations">
          {generations.length === 0 ? (
            <div class="empty-state surface">
              <span aria-hidden="true">✦</span>
              <h3>还没有绘神作品</h3>
              <p>从选择角色或神域开始，AI 会为你的神话世界生成第一幅视觉。</p>
              <a class="btn btn-primary" href="/create/">开始绘神</a>
            </div>
          ) : (
            <div class="gen-grid">
              {generations.map((job) => (
                <div class="gen-card surface">
                  {job.assetKey ? (
                    <img src={`/media/${job.assetKey}`} alt={`${job.entityType} · ${job.scene}`} loading="lazy" width="180" height="240" />
                  ) : (
                    <div class="gen-placeholder">{job.status === 'failed' ? '已失败' : '未完成'}</div>
                  )}
                  <div class="gen-meta">
                    <span class:list={{ 'gen-status': true, [`gen-status--${job.status}`]: true }}>{job.status}</span>
                    <strong>{job.scene}</strong>
                    <small>{job.ratio} · {job.createdAt.slice(0, 10)}</small>
                    {job.errorCode && <small class="gen-error">{job.errorCode}</small>}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        <div class="tab-panel favorites-panel" data-panel="favorites" hidden>
          {favoriteArtworks.length === 0 ? (
            <div class="empty-state surface">
              <span aria-hidden="true">♡</span>
              <h3>还没有收藏</h3>
              <p>看到喜欢的壁纸，点击收藏，它们会出现在这里。</p>
              <a class="btn btn-secondary" href="/explore/">去探索</a>
            </div>
          ) : (
            <div class="artwork-grid">
              {favoriteArtworks.map((artwork) => (
                <ArtworkCard artwork={artwork} />
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('.my-grid');
    if (!root) return;

    // tabs
    root.querySelectorAll('[data-my-tab]').forEach((tab) => {
      tab.addEventListener('click', () => {
        const panel = tab.dataset.myTab;
        root.querySelectorAll('[data-my-tab]').forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        root.querySelectorAll('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== panel; });
      });
    });

    // set cookie if a fresh session was created (make subsequent fetches authenticated)
    const cookie = {myCookie};
    if (cookie && !document.cookie.includes('mythcanvas_session')) {
      document.cookie = cookie;
    }

    // nickname save
    const nameInput = root.querySelector('[data-profile-name]');
    if (nameInput) {
      nameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') saveName(); });
    }
    const saveBtn = root.querySelector('[data-profile-save]');
    if (saveBtn) saveBtn.addEventListener('click', saveName);
    async function saveName() {
      const value = nameInput.value.trim();
      if (!value) return;
      try {
        const res = await fetch('/api/user', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ nickname: value }),
        });
        const data = await res.json();
        if (res.ok) {
          const el = root.querySelector('[data-nickname]');
          if (el) el.textContent = data.user.nickname;
          window.location.reload();
        } else {
          alert(data.error?.message || '保存失败');
        }
      } catch {
        alert('网络错误，请重试');
      }
    }

    const logoutBtn = root.querySelector('[data-profile-logout]');
    if (logoutBtn) logoutBtn.addEventListener('click', async () => {
      await fetch('/api/user', { method: 'DELETE' });
      window.location.reload();
    });
  })();
</script>

<style>
  .collection-hero { padding-block: clamp(4rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--border); background: radial-gradient(circle at 82% 20%, var(--hero-ambient), transparent 28%); }
  h1 { margin: 0; font-size: clamp(3rem, 6vw, 5.4rem); }
  .collection-hero p { max-width: 42rem; margin: var(--space-5) 0 0; color: var(--text-secondary); }
  .my-grid { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: var(--space-10); align-items: start; }
  .profile { position: sticky; top: calc(var(--header-height) + var(--space-5)); display: grid; gap: var(--space-3); padding: var(--space-5); border-radius: var(--radius-lg); }
  .profile-avatar { display: grid; width: 56px; height: 56px; place-items: center; border: 1px solid var(--border-strong); border-radius: 50%; color: var(--accent-strong); background: var(--surface-muted); font-family: var(--font-serif); font-size: 1.4rem; }
  .profile strong, .profile span { display: block; }
  .profile span { margin-top: .25rem; color: var(--text-muted); font-size: .74rem; }
  .login-form summary { cursor: pointer; color: var(--accent-strong); font-size: .78rem; margin-bottom: var(--space-2); }
  .login-form form { display: grid; gap: var(--space-2); }
  .login-form input { min-height: 36px; padding: .4rem .6rem; border: 1px solid var(--border); border-radius: 6px; color: var(--text-primary); background: var(--surface); font-size: .8rem; }
  .login-form .btn, .profile .btn { margin-top: var(--space-1); }
  .my-tabs { display: flex; gap: var(--space-2); margin-bottom: var(--space-6); border-bottom: 1px solid var(--border); }
  .my-tabs button { padding: var(--space-3) var(--space-4); border: 0; border-bottom: 2px solid transparent; color: var(--text-secondary); background: transparent; cursor: pointer; font-size: .86rem; }
  .my-tabs button.is-active { color: var(--text-primary); border-bottom-color: var(--accent); }
  .my-tabs span { color: var(--text-muted); font-size: .72rem; }
  .gen-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
  .gen-card { overflow: hidden; border-radius: var(--radius-lg); }
  .gen-card img { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; }
  .gen-placeholder { width: 100%; aspect-ratio: 3/4; display: grid; place-items: center; color: var(--text-muted); background: var(--surface-muted); font-size: .8rem; }
  .gen-meta { padding: var(--space-3); }
  .gen-meta strong, .gen-meta small { display: block; }
  .gen-meta strong { font-size: .84rem; }
  .gen-meta small { margin-top: 2px; color: var(--text-muted); font-size: .68rem; }
  .gen-status { display: inline-block; width: fit-content; margin-bottom: var(--space-2); padding: .14rem .5rem; border-radius: var(--radius-pill); font-size: .62rem; font-weight: 700; text-transform: capitalize; }
  .gen-status--succeeded { color: var(--jade, #2e7d5b); background: color-mix(in srgb, var(--jade, #2e7d5b) 16%, transparent); }
  .gen-status--failed, .gen-error { color: var(--text-secondary); background: var(--surface-muted); }
  .artwork-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .empty-state { padding: var(--space-16) var(--space-6); border-radius: var(--radius-lg); text-align: center; }
  .empty-state > span { display: block; margin-bottom: var(--space-3); color: var(--accent); font-size: 2.4rem; }
  .empty-state h3 { margin-bottom: var(--space-2); }
  .empty-state p { color: var(--text-secondary); }
  .empty-state .btn { margin-top: var(--space-4); }
  @media (max-width: 900px) { .my-grid { grid-template-columns: 1fr; } .profile { position: static; } .gen-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .gen-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
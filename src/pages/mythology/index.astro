---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MythologyCard from '../../components/mythology/MythologyCard.astro';
import { getMythologies } from '../../lib/content/repositories';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const mythologies = await getMythologies(db);
---

<BaseLayout title="文明图鉴" description="进入中国、希腊、北欧、日本与埃及神话的视觉体系。">
  <section class="collection-hero">
    <div class="container-wide">
      <span class="eyebrow">Mythologies · Visual DNA</span>
      <h1>文明图鉴</h1>
      <p>文化决定“是谁”。从云海天宫、大理石神殿到极光北境，进入每个神话体系的视觉世界。</p>
    </div>
  </section>
  <section class="section-compact">
    <div class="container-wide collection-grid">
      {mythologies.map((mythology) => <MythologyCard mythology={mythology} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .collection-hero { padding-block: clamp(4rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--border); background: radial-gradient(circle at 82% 20%, var(--hero-ambient), transparent 28%); }
  h1 { margin: 0; font-size: clamp(3rem, 6vw, 5.4rem); }
  .collection-hero p { max-width: 42rem; margin: var(--space-5) 0 0; color: var(--text-secondary); }
  .collection-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  @media (max-width: 800px) { .collection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .collection-grid { grid-template-columns: 1fr; } }
</style>

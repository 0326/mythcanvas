---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MythologyCard from '../../components/mythology/MythologyCard.astro';
import { getMythologies } from '../../lib/content/repositories';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const mythologies = (await getMythologies(db)).toSorted(
  (a, b) => (a.displayOrder ?? 999) - (b.displayOrder ?? 999),
);
const mythologyCount = String(mythologies.length).padStart(2, '0');
const mythologyHeroImage = '/media/content/mythology-civilizations-banner.webp';
---

<BaseLayout
  title="神话"
  description="进入中国、希腊、北欧、日本与埃及等神话体系，穿越诸神、神域与各自独特的视觉文明。"
  immersiveHeader
  fullBleed
>
  <section class="mythology-hero" aria-labelledby="mythology-title" data-mythology-hero>
    <div
      class="mythology-hero-art"
      data-mythology-parallax
      style={`--mythology-hero-image: url("${mythologyHeroImage}")`}
      aria-hidden="true"
    ></div>
    <div class="mythology-hero-overlay" aria-hidden="true"></div>

    <div class="container-wide mythology-hero-inner">
      <div class="mythology-hero-copy">
        <span class="eyebrow">Mythologies · 神话文明</span>
        <h1 id="mythology-title">进入诸神的世界</h1>
        <p>
          从云海天宫、大理石神殿，到极光北境与太阳圣城。每一种神话，都拥有独立的诸神、神域与视觉秩序。
        </p>
      </div>

      <div class="mythology-hero-foot" aria-label={`共收录 ${mythologies.length} 个神话体系`}>
        <span>{mythologyCount} MYTHOLOGIES</span>
        <span class="hero-foot-line" aria-hidden="true"></span>
        <span>EXPLORE THE DIVINE WORLDS</span>
      </div>
    </div>
  </section>

  <section class="mythology-collection" aria-label="神话体系列表">
    <div class="container-wide">
      <div class="collection-grid">
        {mythologies.map((mythology, index) => (
          <MythologyCard
            mythology={mythology}
            index={index}
            featured={index === 0 || index === mythologies.length - 1}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const hero = document.querySelector('[data-mythology-hero]');
  const parallax = document.querySelector('[data-mythology-parallax]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero instanceof HTMLElement && parallax instanceof HTMLElement && !reducedMotion.matches) {
    let ticking = false;

    const renderParallax = () => {
      const rect = hero.getBoundingClientRect();
      const heroHeight = hero.offsetHeight;

      if (rect.bottom > 0 && rect.top < window.innerHeight) {
        const travelled = Math.min(Math.max(-rect.top, 0), heroHeight);
        const offset = Math.min(travelled * 0.16, 96);
        parallax.style.setProperty('--parallax-y', `${offset}px`);
      }

      ticking = false;
    };

    const requestParallax = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(renderParallax);
    };

    window.addEventListener('scroll', requestParallax, { passive: true });
    window.addEventListener('resize', requestParallax);
    renderParallax();
  }
</script>

<style>
  .mythology-hero {
    position: relative;
    min-height: clamp(620px, 78svh, 820px);
    overflow: hidden;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 64%, transparent);
    background:
      radial-gradient(circle at 70% 24%, color-mix(in srgb, var(--hero-ambient) 72%, transparent), transparent 30%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-secondary) 58%, var(--bg-primary)), var(--bg-primary));
    isolation: isolate;
  }

  .mythology-hero-art,
  .mythology-hero-overlay {
    position: absolute;
    pointer-events: none;
  }

  .mythology-hero-art {
    --parallax-y: 0px;
    z-index: -3;
    inset: -9% 0;
    background-image: var(--mythology-hero-image);
    background-repeat: no-repeat;
    background-position: 66% 48%;
    background-size: cover;
    filter: saturate(.88) contrast(1.02);
    transform: translate3d(0, var(--parallax-y), 0) scale(1.06);
    transform-origin: center center;
    will-change: transform;
  }

  .mythology-hero-overlay {
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(to right, color-mix(in srgb, var(--bg-primary) 93%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 74%, transparent) 34%, color-mix(in srgb, var(--bg-primary) 20%, transparent) 68%, color-mix(in srgb, var(--bg-primary) 32%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 54%, transparent) 0%, transparent 23%, transparent 66%, color-mix(in srgb, var(--bg-primary) 80%, transparent) 100%);
  }

  :global([data-theme='dark']) .mythology-hero-art {
    filter: saturate(.82) brightness(.8) contrast(1.06);
  }

  :global([data-theme='dark']) .mythology-hero-overlay {
    background:
      linear-gradient(to right, color-mix(in srgb, var(--bg-primary) 94%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 76%, transparent) 32%, color-mix(in srgb, var(--bg-primary) 18%, transparent) 68%, color-mix(in srgb, var(--bg-primary) 38%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 62%, transparent) 0%, transparent 25%, transparent 62%, color-mix(in srgb, var(--bg-primary) 86%, transparent) 100%);
  }

  .mythology-hero-inner {
    position: relative;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(8.5rem, 17vh, 12rem) clamp(4rem, 8vh, 6.5rem);
  }

  .mythology-hero-copy {
    width: min(800px, 64%);
  }

  .mythology-hero-copy :global(.eyebrow) {
    text-shadow: 0 2px 20px color-mix(in srgb, var(--bg-primary) 72%, transparent);
  }

  .mythology-hero-copy h1 {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-display, var(--font-serif));
    font-size: clamp(4rem, 7.8vw, 7.5rem);
    font-weight: 620;
    line-height: .96;
    letter-spacing: -.055em;
    text-wrap: balance;
    text-shadow: 0 5px 34px color-mix(in srgb, var(--bg-primary) 72%, transparent);
  }

  .mythology-hero-copy p {
    max-width: 660px;
    margin: clamp(1.5rem, 3vw, 2.2rem) 0 0;
    color: var(--text-secondary);
    font-family: var(--font-literary, var(--font-serif));
    font-size: clamp(1rem, 1.25vw, 1.16rem);
    line-height: 1.9;
    letter-spacing: .025em;
    text-wrap: balance;
    text-shadow: 0 2px 18px color-mix(in srgb, var(--bg-primary) 84%, transparent);
  }

  .mythology-hero-foot {
    position: absolute;
    right: 0;
    bottom: clamp(2.2rem, 5vw, 3.6rem);
    left: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--text-muted);
    font-size: .67rem;
    font-weight: 650;
    letter-spacing: .15em;
    text-shadow: 0 1px 12px color-mix(in srgb, var(--bg-primary) 88%, transparent);
  }

  .hero-foot-line {
    width: clamp(36px, 6vw, 84px);
    height: 1px;
    background: color-mix(in srgb, var(--accent) 42%, var(--border-strong));
  }

  .mythology-collection {
    position: relative;
    padding-block: clamp(1.5rem, 3.5vw, 3rem) clamp(5rem, 10vw, 9rem);
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 96%, transparent), var(--bg-primary) 12rem),
      var(--bg-primary);
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  @media (max-width: 900px) {
    .mythology-hero {
      min-height: 680px;
    }

    .mythology-hero-art {
      background-position: 62% 50%;
    }

    .mythology-hero-copy {
      width: min(680px, 84%);
    }

    .collection-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .mythology-hero {
      min-height: 620px;
    }

    .mythology-hero-art {
      inset: -7% -30%;
      background-position: 62% 50%;
      transform: translate3d(0, var(--parallax-y), 0) scale(1.04);
    }

    .mythology-hero-overlay {
      background:
        linear-gradient(to right, color-mix(in srgb, var(--bg-primary) 92%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 60%, transparent) 72%, color-mix(in srgb, var(--bg-primary) 34%, transparent) 100%),
        linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 48%, transparent), transparent 22%, transparent 60%, color-mix(in srgb, var(--bg-primary) 86%, transparent));
    }

    .mythology-hero-inner {
      justify-content: flex-start;
      padding-top: 8.8rem;
      padding-bottom: 4.8rem;
    }

    .mythology-hero-copy {
      width: 100%;
    }

    .mythology-hero-copy h1 {
      max-width: 350px;
      font-size: clamp(3.3rem, 17vw, 4.5rem);
      line-height: .95;
    }

    .mythology-hero-copy p {
      max-width: 94%;
      font-size: .92rem;
      line-height: 1.78;
    }

    .mythology-hero-foot {
      bottom: 1.8rem;
      gap: .65rem;
      font-size: .58rem;
      letter-spacing: .1em;
    }

    .hero-foot-line {
      width: 24px;
    }

    .mythology-collection {
      padding-block: 1rem 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mythology-hero-art {
      transform: scale(1.03);
      will-change: auto;
    }
  }
</style>

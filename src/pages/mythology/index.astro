---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MythologyCard from '../../components/mythology/MythologyCard.astro';
import { getMythologies } from '../../lib/content/repositories';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const mythologies = (await getMythologies(db)).toSorted(
  (a, b) => (a.displayOrder ?? 999) - (b.displayOrder ?? 999),
);
const mythologyHeroImage = '/media/content/mythology-civilizations-banner.webp';
---

<BaseLayout
  title="神话"
  description="进入中国、希腊、北欧、日本与埃及等神话体系，穿越诸神、神域与各自独特的视觉文明。"
  immersiveHeader
  fullBleed
>
  <section class="mythology-hero" aria-labelledby="mythology-title">
    <div
      class="mythology-hero-art"
      style={`--mythology-hero-image: url("${mythologyHeroImage}")`}
      aria-hidden="true"
    ></div>
    <div class="mythology-hero-overlay" aria-hidden="true"></div>

    <div class="container-wide mythology-hero-inner">
      <div class="mythology-hero-copy">
        <span class="eyebrow">Mythologies · 神话文明</span>
        <h1 id="mythology-title">探索<span class="mythology-title-break"><br /></span>世界神话</h1>
        <p>
          循着众神、神域与故事，探索中国、希腊、北欧、日本与埃及等不同文明的神话世界。
        </p>
      </div>
    </div>
  </section>

  <section class="mythology-collection" aria-label="神话体系列表">
    <div class="container-wide">
      <div class="collection-grid">
        {mythologies.map((mythology, index) => (
          <MythologyCard
            mythology={mythology}
            index={index}
            featured={index === 0 || index === mythologies.length - 1}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mythology-hero {
    position: relative;
    min-height: clamp(520px, 64svh, 660px);
    background:
      radial-gradient(circle at 70% 24%, color-mix(in srgb, var(--hero-ambient) 72%, transparent), transparent 30%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-secondary) 58%, var(--bg-primary)), var(--bg-primary));
    isolation: isolate;
  }

  .mythology-hero::after {
    position: absolute;
    z-index: -1;
    right: 0;
    bottom: 0;
    left: 0;
    height: clamp(8rem, 16vw, 14rem);
    content: '';
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--bg-primary));
  }

  .mythology-hero-art,
  .mythology-hero-overlay {
    position: absolute;
    pointer-events: none;
  }

  .mythology-hero-art {
    z-index: -3;
    position: fixed;
    inset: 0;
    background-image: var(--mythology-hero-image);
    background-repeat: no-repeat;
    background-position: 66% 48%;
    background-size: cover;
    filter: saturate(.88) contrast(1.02);
    transform: scale(1.025);
    transform-origin: center center;
  }

  .mythology-hero-overlay {
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(to right, color-mix(in srgb, var(--bg-primary) 93%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 74%, transparent) 34%, color-mix(in srgb, var(--bg-primary) 20%, transparent) 68%, color-mix(in srgb, var(--bg-primary) 32%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 54%, transparent) 0%, transparent 23%, transparent 66%, color-mix(in srgb, var(--bg-primary) 80%, transparent) 100%);
  }

  :global([data-theme='dark']) .mythology-hero-art {
    filter: saturate(.82) brightness(.8) contrast(1.06);
  }

  :global([data-theme='dark']) .mythology-hero-overlay {
    background:
      linear-gradient(to right, color-mix(in srgb, var(--bg-primary) 94%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 76%, transparent) 32%, color-mix(in srgb, var(--bg-primary) 18%, transparent) 68%, color-mix(in srgb, var(--bg-primary) 38%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 62%, transparent) 0%, transparent 25%, transparent 62%, color-mix(in srgb, var(--bg-primary) 86%, transparent) 100%);
  }

  .mythology-hero-inner {
    position: relative;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(5.4rem, 9vh, 6.8rem) clamp(3.5rem, 6vh, 4.5rem);
  }

  .mythology-hero-copy {
    width: min(800px, 64%);
  }

  .mythology-hero-copy :global(.eyebrow) {
    text-shadow: 0 2px 20px color-mix(in srgb, var(--bg-primary) 72%, transparent);
  }

  .mythology-hero-copy h1 {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-display, var(--font-serif));
    font-size: clamp(4rem, 7.8vw, 7.5rem);
    font-weight: 620;
    line-height: .96;
    letter-spacing: -.055em;
    text-wrap: balance;
    text-shadow: 0 5px 34px color-mix(in srgb, var(--bg-primary) 72%, transparent);
  }

  .mythology-title-break {
    display: none;
  }

  .mythology-hero-copy p {
    max-width: 660px;
    margin: clamp(1.5rem, 3vw, 2.2rem) 0 0;
    color: var(--text-secondary);
    font-family: var(--font-literary, var(--font-serif));
    font-size: clamp(1rem, 1.25vw, 1.16rem);
    line-height: 1.9;
    letter-spacing: .025em;
    text-wrap: balance;
    text-shadow: 0 2px 18px color-mix(in srgb, var(--bg-primary) 84%, transparent);
  }

  .mythology-collection {
    position: relative;
    z-index: 0;
    padding-block: clamp(.75rem, 2.5vw, 2rem) clamp(5rem, 10vw, 9rem);
    background: linear-gradient(
      to bottom,
      var(--bg-primary) 0%,
      var(--bg-primary) calc(100% - clamp(10rem, 14vw, 14rem)),
      color-mix(in srgb, var(--bg-primary) 88%, transparent) calc(100% - clamp(6rem, 9vw, 9rem)),
      color-mix(in srgb, var(--bg-primary) 48%, transparent) calc(100% - clamp(2rem, 4vw, 4rem)),
      transparent 100%
    );
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  @media (max-width: 900px) {
    .mythology-hero {
      min-height: 560px;
    }

    .mythology-hero-art {
      background-position: 62% 50%;
    }

    .mythology-hero-copy {
      width: min(680px, 84%);
    }

    .collection-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .mythology-hero {
      min-height: 540px;
    }

    .mythology-hero-art {
      inset: 0 -30%;
      background-position: 62% 50%;
      transform: scale(1.04);
    }

    .mythology-hero-overlay {
      background:
        linear-gradient(to right, color-mix(in srgb, var(--bg-primary) 92%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 60%, transparent) 72%, color-mix(in srgb, var(--bg-primary) 34%, transparent) 100%),
        linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 48%, transparent), transparent 22%, transparent 60%, color-mix(in srgb, var(--bg-primary) 86%, transparent));
    }

    .mythology-hero-inner {
      justify-content: flex-start;
      padding-top: 7.4rem;
      padding-bottom: 4.2rem;
    }

    .mythology-hero-copy {
      width: 100%;
    }

    .mythology-hero-copy h1 {
      max-width: 350px;
      font-size: clamp(3.3rem, 17vw, 4.5rem);
      line-height: .95;
    }

    .mythology-title-break {
      display: block;
    }

    .mythology-hero-copy p {
      max-width: 94%;
      font-size: .92rem;
      line-height: 1.78;
    }

    .mythology-collection {
      padding-block: .5rem 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mythology-hero-art {
      position: absolute;
      transform: scale(1.03);
    }
  }
</style>

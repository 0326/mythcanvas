---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RealmCard from '../../components/realm/RealmCard.astro';
import CharacterCard from '../../components/character/CharacterCard.astro';
import ArtworkCard from '../../components/artwork/ArtworkCard.astro';
import {
  getArtworksForMythology,
  getCharactersForMythology,
  getMythologyBySlug,
  getRealms,
  getRealmsForMythology,
} from '../../lib/content/repositories';
import { SITE_TITLE } from '../../consts';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const { slug } = Astro.params;
const mythology = await getMythologyBySlug(db, slug ?? '');
if (!mythology) return Astro.redirect('/404');
const [relatedRealms, relatedCharacters, relatedArtworks, realmsById] = await Promise.all([
  getRealmsForMythology(db, mythology.id),
  getCharactersForMythology(db, mythology.id),
  getArtworksForMythology(db, mythology.id),
  getRealms(db).then((list) => new Map(list.map((item) => [item.id, item]))),
]);
---

<BaseLayout
  title={mythology.name}
  description={`${mythology.name}视觉世界：${mythology.summary}`}
  image={mythology.heroImage.src}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'Thing',
        name: mythology.name,
        alternateName: mythology.nameEn,
        description: mythology.summary,
        image: new URL(mythology.heroImage.src, Astro.site).toString(),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).toString() },
          { '@type': 'ListItem', position: 2, name: '文明图鉴', item: new URL('/mythology/', Astro.site).toString() },
          { '@type': 'ListItem', position: 3, name: mythology.name },
        ],
      },
    ])} />
  </Fragment>
  <section class="entity-hero">
    <img src={mythology.heroImage.src} alt={mythology.heroImage.alt} width={mythology.heroImage.width} height={mythology.heroImage.height} fetchpriority="high" />
    <div class="entity-overlay"></div>
    <div class="container-wide entity-copy">
      <span class="eyebrow">{mythology.nameEn}</span>
      <h1>{mythology.name}</h1>
      <p>{mythology.summary}</p>
      <a class="btn btn-primary" href={`/explore/#${mythology.slug}`}>探索作品</a>
    </div>
  </section>

  <section class="section-compact">
    <div class="container-wide dna-panel surface">
      <div>
        <span class="eyebrow">Civilization Visual DNA</span>
        <h2>这个文明如何被看见</h2>
      </div>
      <div class="dna-groups">
        <div><span>色彩</span><p>{mythology.visualDna.palette.join(' · ')}</p></div>
        <div><span>纹样</span><p>{mythology.visualDna.motifs.join(' · ')}</p></div>
        <div><span>材质</span><p>{mythology.visualDna.materials.join(' · ')}</p></div>
        <div><span>气质</span><p>{mythology.visualDna.atmosphere.join(' · ')}</p></div>
      </div>
    </div>
  </section>

  <section class="section-compact">
    <div class="container-wide">
      <div class="section-heading"><div><span class="eyebrow">Realms</span><h2>代表神域</h2></div></div>
      <div class="realm-grid">
        {relatedRealms.map((realm) => <RealmCard realm={realm} />)}
      </div>
    </div>
  </section>

  <section class="section-compact section-tint">
    <div class="container-wide">
      <div class="section-heading"><div><span class="eyebrow">Characters</span><h2>代表角色</h2></div></div>
      <div class="character-grid">
        {relatedCharacters.map((character) => <CharacterCard character={character} />)}
      </div>
    </div>
  </section>

  <section class="section-compact">
    <div class="container-wide">
      <div class="section-heading"><div><span class="eyebrow">Artworks</span><h2>视觉作品</h2></div></div>
      <div class="artwork-grid">
        {relatedArtworks.map((artwork) => (
          <ArtworkCard artwork={artwork} mythologyName={mythology.name} realmName={artwork.realmId ? realmsById.get(artwork.realmId)?.name : undefined} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .entity-hero { position: relative; min-height: 620px; display: grid; align-items: end; overflow: hidden; border-bottom: 1px solid var(--border); }
  .entity-hero > img, .entity-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
  .entity-hero > img { object-fit: cover; }
  .entity-overlay { background: linear-gradient(to top, var(--bg-primary) 3%, color-mix(in srgb, var(--bg-primary) 86%, transparent) 35%, color-mix(in srgb, var(--bg-primary) 18%, transparent) 78%); }
  .entity-copy { position: relative; z-index: 1; padding-bottom: clamp(3.5rem, 7vw, 6rem); }
  .entity-copy h1 { margin: 0; }
  .entity-copy p { max-width: 42rem; margin: var(--space-5) 0 var(--space-6); color: var(--text-secondary); font-size: 1.05rem; }
  .dna-panel { display: grid; grid-template-columns: minmax(250px, .8fr) 1.4fr; gap: var(--space-10); padding: clamp(2rem, 5vw, 4rem); border-radius: var(--radius-xl); }
  .dna-panel h2 { margin: 0; font-size: clamp(2rem, 3vw, 3rem); }
  .dna-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .dna-groups span { color: var(--accent-strong); font-size: .76rem; font-weight: 700; }
  .dna-groups p { margin: var(--space-2) 0 0; color: var(--text-secondary); font-size: .9rem; }
  .realm-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .character-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .artwork-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
  .section-tint { border-block: 1px solid var(--border); background: color-mix(in srgb, var(--bg-secondary) 66%, transparent); }
  @media (max-width: 900px) { .dna-panel { grid-template-columns: 1fr; } .realm-grid, .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) { .entity-hero { min-height: 520px; } .character-grid, .realm-grid { grid-template-columns: 1fr; } .artwork-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .dna-groups { grid-template-columns: 1fr; } }
</style>

---
import { Check, ChevronDown, Copy, Sparkles } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicCharacters, getPublicWorlds, getPublicStyles } from '../../lib/content/public-catalog';
import {
  listPublicCharacterInterpretationProfiles,
  listPublicCharacterVariantProfiles,
  listCreatorOutputSpecs,
} from '../../lib/generation/creator-config';

export const prerender = false;

const [allCharacters, allWorlds, styles, outputSpecs] = await Promise.all([
  getPublicCharacters({ limit: 1000 }),
  getPublicWorlds({ limit: 1000 }),
  getPublicStyles(),
  listCreatorOutputSpecs(undefined),
]);

const featuredCharacterIds = ['character-change', 'character-erlang-shen'];
const creatorCharacters = [
  ...featuredCharacterIds
    .map((id) => allCharacters.find((character) => character.id === id))
    .filter((character): character is NonNullable<typeof character> => character != null),
  ...allCharacters.filter((character) => !featuredCharacterIds.includes(character.id)),
].slice(0, 5);
const creatorWorlds = allWorlds.slice(0, 5);
const [variants, interpretations] = await Promise.all([
  listPublicCharacterVariantProfiles(creatorCharacters.map((character) => character.id)),
  listPublicCharacterInterpretationProfiles(creatorCharacters.map((character) => character.id)),
]);
const variantsByCharacter = new Map(creatorCharacters.map((character) => [
  character.id,
  variants.filter((variant) => variant.characterId === character.id),
]));
const interpretationsByCharacter = new Map(creatorCharacters.map((character) => [
  character.id,
  interpretations.filter((interpretation) => interpretation.characterId === character.id),
]));

const scenes = ['云海', '月夜', '星空', '神殿', '山海', '遗迹', '深渊'];
const compositions = ['人物居中', '环境叙事', '近景肖像', '史诗远景'];
const quickRefines = [
  { key: 'epic', label: '更史诗', hint: '宏大构图、史诗氛围，画面更辽阔壮丽' },
  { key: 'dreamy', label: '更梦幻', hint: '梦幻光晕、柔和空气透视，增强神话缥缈感' },
  { key: 'realistic', label: '更写实', hint: '写实光影与材质，减少塑料感与通用 AI 质感' },
  { key: 'bright', label: '更明亮', hint: '提高亮度与通透感，保留层次而不过曝' },
  { key: 'far-shot', label: '拉远镜头', hint: '扩大环境占比，强化世界与空间层次' },
  { key: 'divine-glow', label: '强化神光', hint: '增强克制的神性光源，不使用泛滥粒子特效' },
];
const variantTypeLabels = {
  age: '年龄',
  costume: '服装',
  form: '形态',
  composite: '综合',
} as const;

const initialCharacter = creatorCharacters[0];
const initialStyle = styles[0];
const initialOutput = outputSpecs.find((spec) => spec.deviceType === 'mobile') ?? outputSpecs[0];
const initialImage = initialCharacter?.portrait?.src ?? '/media/content/art-moon-palace.jpg';
---

<BaseLayout
  title="AI 绘神"
  description="MythCanvas AI 绘神：选择神话神灵或神域、形态、画风、场景与壁纸规格，生成个性化神话视觉。"
  hideFooter
>
  <section class="creator-workspace">
    <div
      class="container-wide creator-grid"
      data-creator
      data-initial-entity-id={initialCharacter?.id ?? ''}
      data-initial-entity-name={initialCharacter?.name ?? ''}
      data-initial-image={initialImage}
      data-initial-style-id={initialStyle?.id ?? 'canonical'}
      data-initial-style-name={initialStyle?.name ?? '经典神话'}
      data-initial-output-id={initialOutput?.id ?? 'mobile-wallpaper'}
      data-initial-output-name={initialOutput?.name ?? '手机壁纸'}
      data-initial-ratio={initialOutput?.ratio ?? '9:16'}
      data-initial-width={String(initialOutput?.width ?? 1440)}
      data-initial-height={String(initialOutput?.height ?? 2560)}
    >
      <form class="creator-panel surface" onsubmit="return false;">
        <header class="panel-heading">
          <h1>AI 绘神</h1>
          <div class="segmented" role="group" aria-label="创作对象类型">
            <button class="is-active" type="button" data-entity-tab="character" aria-pressed="true">神灵</button>
            <button type="button" data-entity-tab="world" aria-pressed="false">神域</button>
          </div>
        </header>

        <div class="field-grid">
          <label class="creator-field entity-field">
            <span data-entity-label>角色</span>
            <span class="select-wrap" data-entity-group="character">
              <select data-entity-select data-entity-type="character" aria-label="选择角色">
                {creatorCharacters.map((character, index) => (
                  <option
                    value={character.id}
                    selected={index === 0}
                    data-entity-id={character.id}
                    data-entity-type="character"
                    data-entity-slug={character.slug}
                    data-name={character.name}
                    data-image={character.portrait?.src ?? '/media/content/chinese-celestial.svg'}
                  >
                    {character.name} · {character.role}
                  </option>
                ))}
              </select>
              <ChevronDown size={16} strokeWidth={1.8} aria-hidden="true" />
            </span>
            <span class="select-wrap" data-entity-group="world" hidden>
              <select data-entity-select data-entity-type="world" aria-label="选择神域">
                {creatorWorlds.map((world) => (
                  <option
                    value={world.id}
                    data-entity-id={world.id}
                    data-entity-type="world"
                    data-entity-slug={world.slug}
                    data-name={world.name}
                    data-image={world.heroImage.src}
                  >
                    {world.name}
                  </option>
                ))}
              </select>
              <ChevronDown size={16} strokeWidth={1.8} aria-hidden="true" />
            </span>
          </label>

          <label class="creator-field interpretation-field field-wide" data-interpretation-step>
            <span>传统版本</span>
            <span class="select-wrap">
              {creatorCharacters.map((character, characterIndex) => (
                <select data-interpretation-select data-character-id={character.id} aria-label={`${character.name}的传统版本`} hidden={characterIndex !== 0}>
                  <option value="" data-name="经典设定">经典设定</option>
                  {(interpretationsByCharacter.get(character.id) ?? []).map((interpretation) => (
                    <option value={interpretation.id} data-name={interpretation.name} data-interpretation-slug={interpretation.slug}>
                      {interpretation.name}
                    </option>
                  ))}
                </select>
              ))}
              <ChevronDown size={16} strokeWidth={1.8} aria-hidden="true" />
            </span>
          </label>

          <label class="creator-field variant-field" data-variant-step>
            <span>角色形态</span>
            <span class="select-wrap">
              {creatorCharacters.map((character, characterIndex) => (
                <select data-variant-select data-character-id={character.id} aria-label={`${character.name}的角色形态`} hidden={characterIndex !== 0}>
                  <option value="" data-name="经典设定">经典设定</option>
                  {(variantsByCharacter.get(character.id) ?? []).map((variant) => (
                    <option value={variant.id} data-name={variant.name} data-variant-slug={variant.slug}>
                      {variant.name} · {variantTypeLabels[variant.variantType]}
                    </option>
                  ))}
                </select>
              ))}
              <ChevronDown size={16} strokeWidth={1.8} aria-hidden="true" />
            </span>
          </label>

          <label class="creator-field">
            <span>画风</span>
            <span class="select-wrap">
              <select data-style-select aria-label="选择画风">
                {styles.map((style, index) => (
                  <option value={style.id} selected={index === 0} data-name={style.name}>{style.name}</option>
                ))}
              </select>
              <ChevronDown size={16} strokeWidth={1.8} aria-hidden="true" />
            </span>
          </label>

          <label class="creator-field">
            <span>场景</span>
            <span class="select-wrap">
              <select data-scene-select aria-label="选择场景">
                {scenes.map((scene) => <option value={scene}>{scene}</option>)}
              </select>
              <ChevronDown size={16} strokeWidth={1.8} aria-hidden="true" />
            </span>
          </label>

          <label class="creator-field">
            <span>镜头</span>
            <span class="select-wrap">
              <select data-composition-select aria-label="选择镜头构图">
                {compositions.map((composition) => <option value={composition}>{composition}</option>)}
              </select>
              <ChevronDown size={16} strokeWidth={1.8} aria-hidden="true" />
            </span>
          </label>

          <label class="creator-field">
            <span>输出规格</span>
            <span class="select-wrap">
              <select data-output-select aria-label="选择输出规格">
                {outputSpecs.map((spec, index) => (
                  <option
                    value={spec.id}
                    selected={spec.id === initialOutput?.id || (!initialOutput && index === 0)}
                    data-name={spec.name}
                    data-output-device={spec.deviceType}
                    data-ratio={spec.ratio}
                    data-width={String(spec.width)}
                    data-height={String(spec.height)}
                  >
                    {spec.name} · {spec.ratio} · {spec.width}×{spec.height}
                  </option>
                ))}
              </select>
              <ChevronDown size={16} strokeWidth={1.8} aria-hidden="true" />
            </span>
          </label>

          <label class="creator-field field-wide description-field">
            <span>补充描述 <small>可选</small></span>
            <textarea rows="2" maxlength="300" placeholder="例如：远处有巨大的月轮，晨光穿过云层……" data-description></textarea>
          </label>
        </div>

        {variants.length === 0 && <p class="variant-fallback">当前使用经典角色设定。</p>}

        <div class="generate-actions">
          <button class="btn btn-primary generate-button" type="button" data-generate>
            <span data-generate-label>开始绘神</span><Sparkles size={17} strokeWidth={1.8} aria-hidden="true" />
          </button>
          <button
            class="btn btn-secondary copy-prompt-button"
            type="button"
            data-copy-prompt
            aria-label="复制完整提示词"
            title="复制完整提示词"
          >
            <Copy size={18} strokeWidth={1.8} aria-hidden="true" data-copy-icon />
            <Check size={18} strokeWidth={1.8} aria-hidden="true" data-copy-success-icon hidden />
          </button>
          <span class="copy-status" data-copy-status aria-live="polite"></span>
        </div>
      </form>

      <aside class="preview-card surface" aria-label="作品预览与提示词" data-active-view="preview">
        <header class="preview-heading">
          <div class="preview-heading-copy">
            <h2 data-preview-title>{initialCharacter?.name ?? '神灵'} · {initialStyle?.name ?? '经典神话'}</h2>
            <p class="preview-meta">
              <span data-preview-subtitle>经典设定 · 云海 · {initialOutput?.name ?? '手机壁纸'}</span>
              <span aria-hidden="true">·</span>
              <strong data-resolution>{initialOutput?.width ?? 1440}×{initialOutput?.height ?? 2560}</strong>
            </p>
          </div>
          <div class="view-tabs" role="tablist" aria-label="创作详情视图">
            <button
              class="is-active"
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="creator-preview-panel"
              data-view-tab="preview"
            >预览</button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="creator-prompt-panel"
              data-view-tab="prompt"
            >提示词</button>
          </div>
        </header>

        <div
          class="preview-stage"
          id="creator-preview-panel"
          role="tabpanel"
          data-view-panel="preview"
          data-preview-stage
          data-device={initialOutput?.deviceType ?? 'mobile'}
        >
          <div class="preview-frame" data-preview-frame>
            <img src={initialImage} alt="AI 绘神预览" width="720" height="1280" data-preview-image />
            <div class="preview-overlay" data-preview-overlay hidden></div>
            <div class="mobile-safe-zone" data-mobile-safe-zone aria-hidden="true"></div>
            <div class="preview-status" data-preview-status aria-live="polite" hidden>
              <strong data-status-title>准备预览</strong>
              <p data-status-text>调整左侧选项，画面会同步切换。</p>
            </div>
          </div>
        </div>

        <section
          class="prompt-panel"
          id="creator-prompt-panel"
          role="tabpanel"
          data-view-panel="prompt"
          aria-label="当前生成提示词"
          hidden
        >
          <div class="prompt-summary">
            <div>
              <strong>当前配置 Prompt</strong>
              <p data-prompt-summary>切换到此面板后，会解析当前选项对应的完整生成提示词。</p>
            </div>
            <span data-prompt-status>与实际生成规则同步</span>
          </div>

          <div class="prompt-loading" data-prompt-loading>正在解析当前组合…</div>
          <div class="prompt-error" data-prompt-error role="status" hidden></div>

          <div class="prompt-content" data-prompt-content hidden>
            <div class="prompt-layers" data-prompt-layers></div>
            <section class="prompt-final">
              <div class="prompt-section-heading">
                <h3>最终 Prompt</h3>
                <span>实际发送给图片模型的文本提示词</span>
              </div>
              <pre data-prompt-final></pre>
            </section>
          </div>
        </section>

        <div class="preview-footer" data-preview-footer hidden>
          <div class="preview-actions" data-preview-actions hidden>
            <a class="btn btn-secondary" data-download href="#" download>下载</a>
            <button class="btn btn-secondary" type="button" data-publish>申请公开</button>
            <button class="btn btn-secondary" type="button" data-retry hidden>重试</button>
            <button class="btn btn-secondary" type="button" data-favorite aria-pressed="false">收藏</button>
          </div>
        </div>

        <div class="refine-card" data-refine-panel hidden>
          <span>快捷微调</span>
          <div class="refine-options">
            {quickRefines.map((item) => (
              <button class="refine-option" type="button" data-refine={item.key} title={item.hint}>{item.label}</button>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-creator]');
    if (!root) return;

    const state = {
      entityType: 'character',
      entityId: root.dataset.initialEntityId || '',
      entity: root.dataset.initialEntityName || '',
      image: root.dataset.initialImage || '',
      interpretationId: '',
      interpretation: '经典设定',
      variantId: '',
      variant: '经典设定',
      styleId: root.dataset.initialStyleId || 'canonical',
      style: root.dataset.initialStyleName || '经典神话',
      scene: '云海',
      composition: '人物居中',
      outputSpecId: root.dataset.initialOutputId || 'mobile-wallpaper',
      outputName: root.dataset.initialOutputName || '手机壁纸',
      ratio: root.dataset.initialRatio || '9:16',
      width: Number(root.dataset.initialWidth || 1440),
      height: Number(root.dataset.initialHeight || 2560),
      device: 'mobile',
      lastJobId: null,
      lastImageUrl: null,
      activeView: 'preview',
      promptData: null,
      promptDirty: true,
      promptRevision: 0,
    };

    const PROMPT_LAYER_ORDER = [
      'purpose',
      'identity',
      'interpretation',
      'variant',
      'civilization',
      'style',
      'scene',
      'output',
      'refinement',
      'guardrails',
    ];
    const PROMPT_LAYER_LABELS = {
      purpose: '生成目标',
      identity: '角色身份',
      interpretation: '传统版本',
      variant: '角色形态',
      civilization: '文明视觉 DNA',
      style: '画风规则',
      scene: '场景与构图',
      output: '输出规格',
      refinement: '补充描述',
      guardrails: '生成约束',
    };

    const HISTORY_KEY = 'mythcanvas-generations-v2';
    const loadHistory = () => { try { return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]'); } catch { return []; } };
    const saveHistory = (list) => { try { localStorage.setItem(HISTORY_KEY, JSON.stringify(list.slice(0, 8))); } catch { /* ignore */ } };
    const selectedOption = (select) => select?.selectedOptions?.[0];
    const emitChange = (select) => select?.dispatchEvent(new Event('change', { bubbles: true }));
    let promptRefreshTimer = null;
    let copyResetTimer = null;

    const setPressed = (selector, active) => {
      root.querySelectorAll(selector).forEach((item) => {
        const selected = item === active;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
    };

    const currentCharacterSelect = (selector) => root.querySelector(`${selector}[data-character-id="${CSS.escape(state.entityId)}"]`);

    const buildGenerationRequest = (refineHint = '', includeSourceGeneration = false) => {
      const description = root.querySelector('[data-description]');
      const baseDescription = description?.value || '';
      return {
        entityType: state.entityType,
        entityId: state.entityId,
        interpretationId: state.entityType === 'character' && state.interpretationId ? state.interpretationId : undefined,
        variantId: state.entityType === 'character' && state.variantId ? state.variantId : undefined,
        styleId: state.styleId,
        scene: state.scene,
        composition: state.composition,
        ratio: state.ratio,
        outputSpecId: state.outputSpecId,
        description: [baseDescription, refineHint].filter(Boolean).join('，'),
        sourceGenerationId: includeSourceGeneration && state.lastJobId ? state.lastJobId : undefined,
      };
    };

    const renderPrompt = (result) => {
      const summary = root.querySelector('[data-prompt-summary]');
      const status = root.querySelector('[data-prompt-status]');
      const loading = root.querySelector('[data-prompt-loading]');
      const errorNode = root.querySelector('[data-prompt-error]');
      const content = root.querySelector('[data-prompt-content]');
      const layersRoot = root.querySelector('[data-prompt-layers]');
      const finalPrompt = root.querySelector('[data-prompt-final]');
      const context = result?.context || {};
      const output = context.output || {};

      if (summary) {
        const details = [
          context.entityName,
          context.interpretationName,
          context.variantName,
          context.styleName,
          context.scene,
          output.name,
        ].filter(Boolean);
        summary.textContent = details.join(' · ');
      }
      if (status) status.textContent = `${context.mythologyName || 'MythCanvas'} · ${output.ratio || state.ratio} · ${output.width || state.width}×${output.height || state.height}`;
      if (layersRoot) {
        layersRoot.replaceChildren();
        PROMPT_LAYER_ORDER.forEach((key, index) => {
          const value = result?.layers?.[key];
          if (!value) return;
          const section = document.createElement('section');
          section.className = 'prompt-layer';
          const heading = document.createElement('div');
          heading.className = 'prompt-layer-heading';
          const order = document.createElement('span');
          order.textContent = String(index + 1).padStart(2, '0');
          const title = document.createElement('h3');
          title.textContent = PROMPT_LAYER_LABELS[key] || key;
          heading.append(order, title);
          const text = document.createElement('p');
          text.textContent = value;
          section.append(heading, text);
          layersRoot.append(section);
        });
      }
      if (finalPrompt) finalPrompt.textContent = result?.prompt || '';
      if (loading) loading.hidden = true;
      if (errorNode) errorNode.hidden = true;
      if (content) content.hidden = false;
    };

    const showPromptError = (message) => {
      const loading = root.querySelector('[data-prompt-loading]');
      const errorNode = root.querySelector('[data-prompt-error]');
      const content = root.querySelector('[data-prompt-content]');
      if (loading) loading.hidden = true;
      if (content) content.hidden = true;
      if (errorNode) {
        errorNode.hidden = false;
        errorNode.textContent = message;
      }
    };

    const loadPromptPreview = async (force = false) => {
      if (!force && !state.promptDirty && state.promptData) return state.promptData;
      const revision = state.promptRevision;
      const loading = root.querySelector('[data-prompt-loading]');
      const errorNode = root.querySelector('[data-prompt-error]');
      const content = root.querySelector('[data-prompt-content]');
      if (loading) loading.hidden = false;
      if (errorNode) errorNode.hidden = true;
      if (content) content.hidden = true;

      try {
        const response = await fetch('/api/prompt-preview', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(buildGenerationRequest()),
        });
        const result = await response.json();
        if (!response.ok || !result.prompt) throw new Error(result.error?.message || '提示词解析失败');
        if (revision !== state.promptRevision) return null;
        state.promptData = result;
        state.promptDirty = false;
        renderPrompt(result);
        return result;
      } catch (error) {
        if (revision !== state.promptRevision) return null;
        const message = error instanceof Error ? error.message : '提示词解析失败';
        showPromptError(message);
        throw error;
      }
    };

    const invalidatePrompt = () => {
      state.promptDirty = true;
      state.promptData = null;
      state.promptRevision += 1;
      if (state.activeView !== 'prompt') return;
      if (promptRefreshTimer) window.clearTimeout(promptRefreshTimer);
      promptRefreshTimer = window.setTimeout(() => {
        loadPromptPreview().catch(() => undefined);
      }, 220);
    };

    const switchView = (view) => {
      if (view !== 'preview' && view !== 'prompt') return;
      state.activeView = view;
      const card = root.querySelector('.preview-card');
      if (card) card.dataset.activeView = view;
      root.querySelectorAll('[data-view-tab]').forEach((button) => {
        const selected = button.dataset.viewTab === view;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-selected', selected ? 'true' : 'false');
      });
      root.querySelectorAll('[data-view-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.viewPanel !== view;
      });
      if (view === 'prompt') loadPromptPreview().catch(() => undefined);
    };

    const writeClipboard = async (text) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.append(textarea);
      textarea.select();
      const copied = document.execCommand('copy');
      textarea.remove();
      if (!copied) throw new Error('浏览器未允许复制');
    };

    const setCopyState = (button, statusText, copied) => {
      const copyIcon = button?.querySelector('[data-copy-icon]');
      const successIcon = button?.querySelector('[data-copy-success-icon]');
      const liveStatus = root.querySelector('[data-copy-status]');
      if (button) {
        button.dataset.copyState = copied ? 'success' : 'idle';
        button.setAttribute('aria-label', copied ? '提示词已复制' : '复制完整提示词');
        button.setAttribute('title', copied ? '已复制' : '复制完整提示词');
      }
      if (copyIcon) copyIcon.hidden = copied;
      if (successIcon) successIcon.hidden = !copied;
      if (liveStatus) liveStatus.textContent = statusText;
    };

    const copyCurrentPrompt = async (button) => {
      if (!button) return;
      button.disabled = true;
      const liveStatus = root.querySelector('[data-copy-status]');
      if (liveStatus) liveStatus.textContent = '正在整理提示词';
      try {
        const result = await loadPromptPreview();
        if (!result?.prompt) throw new Error('当前提示词不可用');
        await writeClipboard(result.prompt);
        setCopyState(button, '完整提示词已复制', true);
        if (copyResetTimer) window.clearTimeout(copyResetTimer);
        copyResetTimer = window.setTimeout(() => setCopyState(button, '', false), 1600);
      } catch (error) {
        const message = error instanceof Error ? error.message : '复制失败';
        setCopyState(button, `复制失败：${message}`, false);
      } finally {
        button.disabled = false;
      }
    };

    const resetCharacterChoices = () => {
      root.querySelectorAll('[data-interpretation-select]').forEach((select) => {
        select.hidden = select.dataset.characterId !== state.entityId;
      });
      root.querySelectorAll('[data-variant-select]').forEach((select) => {
        select.hidden = select.dataset.characterId !== state.entityId;
      });
      const interpretationSelect = currentCharacterSelect('[data-interpretation-select]');
      const variantSelect = currentCharacterSelect('[data-variant-select]');
      const interpretationStep = root.querySelector('[data-interpretation-step]');
      const variantStep = root.querySelector('[data-variant-step]');
      const fieldGrid = root.querySelector('.field-grid');
      const hasInterpretations = Boolean(interpretationSelect && interpretationSelect.options.length > 1);
      const hasVariants = Boolean(variantSelect && variantSelect.options.length > 1);
      if (interpretationStep) interpretationStep.hidden = !hasInterpretations;
      if (fieldGrid) fieldGrid.classList.toggle('has-interpretation', hasInterpretations);
      if (variantStep) variantStep.hidden = !hasVariants;
      if (interpretationSelect) interpretationSelect.selectedIndex = 0;
      if (variantSelect) variantSelect.selectedIndex = 0;
      state.interpretationId = '';
      state.interpretation = '经典设定';
      state.variantId = '';
      state.variant = '经典设定';
    };

    const refresh = () => {
      invalidatePrompt();
      const image = root.querySelector('[data-preview-image]');
      if (image && !state.lastImageUrl && image.getAttribute('src') !== state.image) image.setAttribute('src', state.image);
      const title = root.querySelector('[data-preview-title]');
      const subtitle = root.querySelector('[data-preview-subtitle]');
      if (title) title.textContent = `${state.entity} · ${state.style}`;
      if (subtitle) subtitle.textContent = `${state.entityType === 'character' ? state.variant + ' · ' : ''}${state.scene} · ${state.outputName}`;
      const stage = root.querySelector('[data-preview-stage]');
      if (stage) stage.dataset.device = state.device;
      const safeZone = root.querySelector('[data-mobile-safe-zone]');
      if (safeZone) safeZone.hidden = state.device !== 'mobile';
      const status = root.querySelector('[data-preview-status]');
      const overlay = root.querySelector('[data-preview-overlay]');
      if (!state.lastImageUrl) {
        if (status) status.hidden = true;
        if (overlay) overlay.hidden = true;
      }
      const resolution = root.querySelector('[data-resolution]');
      if (resolution) resolution.textContent = `${state.width}×${state.height}`;
    };

    root.querySelectorAll('[data-view-tab]').forEach((button) => {
      button.addEventListener('click', () => switchView(button.dataset.viewTab));
    });

    root.querySelector('[data-copy-prompt]')?.addEventListener('click', (event) => {
      copyCurrentPrompt(event.currentTarget);
    });

    root.querySelector('[data-description]')?.addEventListener('input', invalidatePrompt);

    root.querySelectorAll('[data-entity-tab]').forEach((button) => {
      button.addEventListener('click', () => {
        const type = button.dataset.entityTab;
        if (!type) return;
        state.entityType = type;
        state.lastImageUrl = null;
        setPressed('[data-entity-tab]', button);
        root.querySelectorAll('[data-entity-group]').forEach((group) => { group.hidden = group.dataset.entityGroup !== type; });
        const entityLabel = root.querySelector('[data-entity-label]');
        if (entityLabel) entityLabel.textContent = type === 'character' ? '角色' : '神域';
        const variantStep = root.querySelector('[data-variant-step]');
        const interpretationStep = root.querySelector('[data-interpretation-step]');
        if (variantStep) variantStep.hidden = type !== 'character';
        if (interpretationStep) interpretationStep.hidden = type !== 'character';
        emitChange(root.querySelector(`[data-entity-select][data-entity-type="${type}"]`));
      });
    });

    root.querySelectorAll('[data-entity-select]').forEach((select) => {
      select.addEventListener('change', () => {
        const option = selectedOption(select);
        if (!option) return;
        state.entityId = option.dataset.entityId || option.value || state.entityId;
        state.entity = option.dataset.name || option.textContent?.trim() || state.entity;
        state.image = option.dataset.image || state.image;
        state.lastImageUrl = null;
        if (state.entityType === 'character') resetCharacterChoices();
        refresh();
      });
    });

    root.querySelectorAll('[data-interpretation-select]').forEach((select) => {
      select.addEventListener('change', () => {
        if (state.entityType !== 'character' || select.hidden) return;
        const option = selectedOption(select);
        state.interpretationId = option?.value || '';
        state.interpretation = option?.dataset.name || '经典设定';
        const variantSelect = currentCharacterSelect('[data-variant-select]');
        if (variantSelect) variantSelect.selectedIndex = 0;
        state.variantId = '';
        state.variant = '经典设定';
        refresh();
      });
    });

    root.querySelectorAll('[data-variant-select]').forEach((select) => {
      select.addEventListener('change', () => {
        if (state.entityType !== 'character' || select.hidden) return;
        const option = selectedOption(select);
        state.variantId = option?.value || '';
        state.variant = option?.dataset.name || '经典设定';
        refresh();
      });
    });

    root.querySelector('[data-style-select]')?.addEventListener('change', (event) => {
      const option = selectedOption(event.currentTarget);
      state.styleId = option?.value || state.styleId;
      state.style = option?.dataset.name || state.style;
      refresh();
    });

    root.querySelector('[data-scene-select]')?.addEventListener('change', (event) => {
      state.scene = event.currentTarget.value || state.scene;
      refresh();
    });

    root.querySelector('[data-composition-select]')?.addEventListener('change', (event) => {
      state.composition = event.currentTarget.value || state.composition;
      refresh();
    });

    root.querySelector('[data-output-select]')?.addEventListener('change', (event) => {
      const option = selectedOption(event.currentTarget);
      if (!option) return;
      state.outputSpecId = option.value || state.outputSpecId;
      state.outputName = option.dataset.name || state.outputName;
      state.device = option.dataset.outputDevice || state.device;
      state.ratio = option.dataset.ratio || state.ratio;
      state.width = Number(option.dataset.width || state.width);
      state.height = Number(option.dataset.height || state.height);
      refresh();
    });

    const preselectFromQuery = () => {
      try {
        const params = new URLSearchParams(window.location.search);
        const characterSlug = params.get('character');
        const worldSlug = params.get('world');
        const entityType = characterSlug ? 'character' : 'world';
        const entitySlug = characterSlug || worldSlug;
        if (entitySlug) {
          root.querySelector(`[data-entity-tab="${entityType}"]`)?.click();
          const option = root.querySelector(`[data-entity-select][data-entity-type="${entityType}"] [data-entity-slug="${CSS.escape(entitySlug)}"]`);
          if (option) {
            option.parentElement.value = option.value;
            emitChange(option.parentElement);
          }
        }
        const interpretationSlug = params.get('interpretation');
        if (state.entityType === 'character' && interpretationSlug) {
          const option = currentCharacterSelect('[data-interpretation-select]')?.querySelector(`[data-interpretation-slug="${CSS.escape(interpretationSlug)}"]`);
          if (option) {
            option.parentElement.value = option.value;
            emitChange(option.parentElement);
          }
        }
        const variantSlug = params.get('variant');
        if (state.entityType === 'character' && variantSlug) {
          const option = currentCharacterSelect('[data-variant-select]')?.querySelector(`[data-variant-slug="${CSS.escape(variantSlug)}"]`);
          if (option) {
            option.parentElement.value = option.value;
            emitChange(option.parentElement);
          }
        }
        const styleId = params.get('style');
        const styleSelect = root.querySelector('[data-style-select]');
        if (styleId && styleSelect?.querySelector(`option[value="${CSS.escape(styleId)}"]`)) {
          styleSelect.value = styleId;
          emitChange(styleSelect);
        }
        const outputId = params.get('output');
        const outputSelect = root.querySelector('[data-output-select]');
        if (outputId && outputSelect?.querySelector(`option[value="${CSS.escape(outputId)}"]`)) {
          outputSelect.value = outputId;
          emitChange(outputSelect);
        }
      } catch { /* ignore malformed query */ }
    };

    const setBusy = (busy, label) => {
      const button = root.querySelector('[data-generate]');
      const actions = root.querySelector('[data-preview-actions]');
      const footer = root.querySelector('[data-preview-footer]');
      if (!button) return;
      button.disabled = busy;
      const labelNode = button.querySelector('[data-generate-label]');
      if (labelNode) labelNode.textContent = label;
      if (actions) actions.hidden = busy || !state.lastImageUrl;
      if (footer) footer.hidden = busy || !state.lastImageUrl;
    };

    const runGenerate = async (isRetry, refineHint) => {
      const status = root.querySelector('[data-preview-status]');
      const image = root.querySelector('[data-preview-image]');
      const retryBtn = root.querySelector('[data-retry]');
      const favoriteBtn = root.querySelector('[data-favorite]');
      const downloadBtn = root.querySelector('[data-download]');
      const overlay = root.querySelector('[data-preview-overlay]');
      if (!status || !image) return;

      const statusTitle = status.querySelector('[data-status-title]');
      const statusText = status.querySelector('[data-status-text]');
      setBusy(true, '正在绘神…');
      switchView('preview');
      status.hidden = false;
      if (overlay) overlay.hidden = false;
      status.classList.add('is-generating');
      if (retryBtn) retryBtn.hidden = true;
      if (favoriteBtn) favoriteBtn.setAttribute('aria-pressed', 'false');
      if (statusTitle) statusTitle.textContent = isRetry ? '正在重新构筑' : '正在唤醒神祇';
      if (statusText) statusText.textContent = `${state.entity} · ${state.style} · ${state.outputName}`;

      const body = buildGenerationRequest(refineHint || '', true);

      try {
        const response = await fetch('/api/generate', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const result = await response.json();
        if (response.status === 429) throw new Error(result.error?.message || '绘神次数已达上限，请稍后再试。');
        if (result.status === 'moderated') throw new Error(result.error?.message || '生成内容未通过安全审核。');
        if (!response.ok || result.status !== 'succeeded' || !result.imageUrl) throw new Error(result.error?.message || '生成失败');

        state.lastJobId = result.id;
        state.lastImageUrl = result.imageUrl;
        image.setAttribute('src', result.imageUrl);
        image.setAttribute('alt', `${state.entity} · ${state.interpretation} · ${state.variant} · ${state.style} · ${state.scene}`);
        if (statusTitle) statusTitle.textContent = `${state.entity} · ${state.style}`;
        if (statusText) statusText.textContent = result.persisted ? '作品已完成并保存。' : '作品已完成。';

        const history = loadHistory();
        history.unshift({
          jobId: result.id,
          entityType: state.entityType,
          entityId: state.entityId,
          entity: state.entity,
          interpretationId: state.interpretationId,
          interpretation: state.interpretation,
          variantId: state.variantId,
          variant: state.variant,
          styleId: state.styleId,
          style: state.style,
          scene: state.scene,
          composition: state.composition,
          outputSpecId: state.outputSpecId,
          outputName: state.outputName,
          ratio: state.ratio,
          width: state.width,
          height: state.height,
          device: state.device,
          imageUrl: result.imageUrl,
          createdAt: new Date().toISOString(),
        });
        saveHistory(history);

        if (downloadBtn instanceof HTMLAnchorElement) downloadBtn.href = result.imageUrl;
        const refinePanel = root.querySelector('[data-refine-panel]');
        if (refinePanel) refinePanel.hidden = false;
        setBusy(false, '再绘一次');
      } catch (error) {
        const message = error instanceof Error ? error.message : '请稍后再试';
        if (statusTitle) statusTitle.textContent = '这次没有完成';
        if (statusText) statusText.textContent = message;
        setBusy(false, '重新绘神');
        if (retryBtn) retryBtn.hidden = false;
        const actions = root.querySelector('[data-preview-actions]');
        const footer = root.querySelector('[data-preview-footer]');
        if (actions) actions.hidden = false;
        if (footer) footer.hidden = false;
      } finally {
        status.classList.remove('is-generating');
      }
    };

    root.querySelector('[data-generate]')?.addEventListener('click', () => runGenerate(false));
    root.querySelector('[data-retry]')?.addEventListener('click', () => runGenerate(true));
    root.querySelectorAll('[data-refine]').forEach((button) => button.addEventListener('click', () => runGenerate(false, button.title || '')));

    root.querySelector('[data-favorite]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      if (!button || !state.lastJobId) return;
      try {
        const response = await fetch('/api/favorite', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ targetType: 'generation', targetId: state.lastJobId }),
        });
        const result = await response.json();
        if (response.ok && result.favorited) {
          button.setAttribute('aria-pressed', 'true');
          button.textContent = '已收藏';
        } else if (response.status === 401) {
          const redirect = `${window.location.pathname}${window.location.search}`;
          window.location.href = `${result.loginUrl || '/login/'}?redirect=${encodeURIComponent(redirect)}`;
        } else button.textContent = result.message || '收藏失败';
      } catch { button.textContent = '收藏失败'; }
    });

    root.querySelector('[data-publish]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      if (!state.lastJobId) return;
      const defaultTitle = `${state.entity} · ${state.variant} · ${state.style}`;
      const title = window.prompt('为这幅作品起个标题（审核通过后进入探索页）', defaultTitle);
      if (title === null || !title.trim()) return;
      button.disabled = true;
      try {
        const response = await fetch('/api/submission', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ generationId: state.lastJobId, title: title.trim(), name: state.entity }),
        });
        const result = await response.json();
        alert(result.message || '操作完成');
      } catch { alert('网络错误，请重试'); }
      finally { button.disabled = false; }
    });

    emitChange(root.querySelector('[data-output-select]'));
    resetCharacterChoices();
    refresh();
    preselectFromQuery();
  })();
</script>


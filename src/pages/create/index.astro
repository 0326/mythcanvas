---
import { Landmark, Monitor, Smartphone, Sparkles } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCharacters, getWorlds, getStyles } from '../../lib/content/repositories';
import { listCharacterVariantProfiles, listCreatorOutputSpecs } from '../../lib/generation/creator-config';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const [allCharacters, allWorlds, styles, outputSpecs] = await Promise.all([
  getCharacters(db),
  getWorlds(db),
  getStyles(db),
  listCreatorOutputSpecs(db),
]);

const creatorCharacters = allCharacters.slice(0, 5);
const creatorWorlds = allWorlds.slice(0, 5);
const variants = await listCharacterVariantProfiles(db, creatorCharacters.map((character) => character.id));
const variantsByCharacter = new Map(creatorCharacters.map((character) => [
  character.id,
  variants.filter((variant) => variant.characterId === character.id),
]));

const scenes = ['云海', '月夜', '星空', '神殿', '山海', '遗迹', '深渊'];
const compositions = ['人物居中', '环境叙事', '近景肖像', '史诗远景'];
const quickRefines = [
  { key: 'epic', label: '更史诗', hint: '宏大构图、史诗氛围，画面更辽阔壮丽' },
  { key: 'dreamy', label: '更梦幻', hint: '梦幻光晕、柔和空气透视，增强神话缥缈感' },
  { key: 'realistic', label: '更写实', hint: '写实光影与材质，减少塑料感与通用 AI 质感' },
  { key: 'bright', label: '更明亮', hint: '提高亮度与通透感，保留层次而不过曝' },
  { key: 'far-shot', label: '拉远镜头', hint: '扩大环境占比，强化世界与空间层次' },
  { key: 'divine-glow', label: '强化神光', hint: '增强克制的神性光源，不使用泛滥粒子特效' },
];
const variantTypeLabels = {
  age: '年龄',
  costume: '服装',
  form: '形态',
  composite: '综合',
} as const;

const initialCharacter = creatorCharacters[0];
const initialStyle = styles[0];
const initialOutput = outputSpecs.find((spec) => spec.deviceType === 'mobile') ?? outputSpecs[0];
const initialImage = initialCharacter?.portrait?.src ?? '/media/content/art-moon-palace.jpg';
---

<BaseLayout
  title="AI 绘神"
  description="MythCanvas AI 绘神：组合神话神灵、年龄服装形态、独立画风、场景与 PC/手机壁纸规格，生成可持续复用的神话视觉。"
>
  <section class="creator-hero">
    <div class="container-wide creator-hero-inner">
      <div>
        <span class="eyebrow">AI Creator · Structured Recipe</span>
        <h1>神灵不变，形态与画风自由组合</h1>
        <p>选择神话神灵或神域，再独立组合神灵形态、画风、场景与设备规格。MythCanvas 会自动带入 Canonical Design 与神话体系 Visual DNA。</p>
      </div>
      <div class="recipe-principle" aria-label="绘神生成规则">
        <span>神灵</span><b>×</b><span>形态</span><b>×</b><span>画风</span><b>×</b><span>壁纸规格</span>
      </div>
    </div>
  </section>

  <section class="creator-section section-compact">
    <div
      class="container-wide creator-grid"
      data-creator
      data-initial-entity-id={initialCharacter?.id ?? ''}
      data-initial-entity-name={initialCharacter?.name ?? ''}
      data-initial-image={initialImage}
      data-initial-style-id={initialStyle?.id ?? 'canonical'}
      data-initial-style-name={initialStyle?.name ?? '经典神话'}
      data-initial-output-id={initialOutput?.id ?? 'mobile-wallpaper'}
      data-initial-output-name={initialOutput?.name ?? '手机壁纸'}
      data-initial-ratio={initialOutput?.ratio ?? '9:16'}
      data-initial-width={String(initialOutput?.width ?? 1440)}
      data-initial-height={String(initialOutput?.height ?? 2560)}
    >
      <form class="creator-panel surface" onsubmit="return false;">
        <div class="step-block">
          <div class="step-head"><span>01</span><div><h2>选择创作对象</h2><p>神灵会锁定 Canonical Design；神域会锁定核心空间与建筑锚点。</p></div></div>
          <div class="segmented" role="group" aria-label="创作对象类型">
            <button class="is-active" type="button" data-entity-tab="character" aria-pressed="true">神灵</button>
            <button type="button" data-entity-tab="world" aria-pressed="false">神域</button>
          </div>
          <div class="entity-options" data-entity-group="character">
            {creatorCharacters.map((character, index) => (
              <button
                class:list={{ 'entity-option': true, 'is-active': index === 0 }}
                type="button"
                data-entity
                data-entity-id={character.id}
                data-entity-type="character"
                data-name={character.name}
                data-image={character.portrait?.src ?? '/media/content/chinese-celestial.svg'}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span class="entity-glyph" aria-hidden="true">{character.symbols[0]}</span>
                <span><strong>{character.name}</strong><small>{character.role}</small></span>
              </button>
            ))}
          </div>
          <div class="entity-options" data-entity-group="world" hidden>
            {creatorWorlds.map((world) => (
              <button
                class="entity-option"
                type="button"
                data-entity
                data-entity-id={world.id}
                data-entity-type="world"
                data-entity-slug={world.slug}
                data-name={world.name}
                data-image={world.heroImage.src}
                aria-pressed="false"
              >
                <span class="entity-glyph" aria-hidden="true"><Landmark size={18} strokeWidth={1.8} /></span>
                <span><strong>{world.name}</strong><small>{world.nameEn}</small></span>
              </button>
            ))}
          </div>
        </div>

        <div class="step-block" data-variant-step>
          <div class="step-head"><span>02</span><div><h2>选择角色形态</h2><p>年龄、服装和神性形态属于角色 Variant，不属于画风。</p></div></div>
          {creatorCharacters.map((character, characterIndex) => (
            <div class="variant-options" data-variant-group={character.id} hidden={characterIndex !== 0}>
              <button
                class="variant-option is-active"
                type="button"
                data-variant-id=""
                data-variant-name="经典设定"
                data-variant-type="canonical"
                aria-pressed="true"
              >
                <span class="variant-meta"><small>BASE</small><strong>经典设定</strong></span>
                <span>使用角色主设，不叠加年龄、服装或形态变化。</span>
              </button>
              {(variantsByCharacter.get(character.id) ?? []).map((variant) => (
                <button
                  class="variant-option"
                  type="button"
                  data-variant-id={variant.id}
                  data-variant-name={variant.name}
                  data-variant-type={variant.variantType}
                  aria-pressed="false"
                >
                  <span class="variant-meta"><small>{variantTypeLabels[variant.variantType]}</small><strong>{variant.name}</strong></span>
                  <span>{variant.description}</span>
                </button>
              ))}
            </div>
          ))}
          {variants.length === 0 && (
            <p class="variant-fallback">当前环境尚未应用角色形态数据迁移，将使用经典设定生成。</p>
          )}
        </div>

        <div class="step-block">
          <div class="step-head"><span data-step-style>03</span><div><h2>选择独立画风</h2><p>画风只定义“怎么画”，不会静默改写角色年龄、服装或身份。</p></div></div>
          <div class="style-options">
            {styles.map((style, index) => (
              <button
                class:list={{ 'style-option': true, 'is-active': index === 0 }}
                type="button"
                data-style-id={style.id}
                data-style-name={style.name}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span class:list={{ 'style-swatch': true, [`tone-${(index % 4) + 1}`]: true }} aria-hidden="true"></span>
                <span><strong>{style.name}</strong><small>{style.nameEn}</small></span>
              </button>
            ))}
          </div>
        </div>

        <div class="step-block">
          <div class="step-head"><span data-step-scene>04</span><div><h2>场景与镜头</h2><p>场景、镜头和临时氛围只影响这一张作品，不写回角色主设。</p></div></div>
          <div class="field-label">场景</div>
          <div class="chip-options">
            {scenes.map((scene, index) => <button class:list={{ chip: true, 'is-active': index === 0 }} type="button" data-scene={scene} aria-pressed={index === 0 ? 'true' : 'false'}>{scene}</button>)}
          </div>
          <div class="field-label composition-label">镜头构图</div>
          <div class="chip-options">
            {compositions.map((composition, index) => <button class:list={{ chip: true, 'is-active': index === 0 }} type="button" data-composition={composition} aria-pressed={index === 0 ? 'true' : 'false'}>{composition}</button>)}
          </div>
          <label class="advanced-input">
            <span>补充描述 <small>可选 · 不会覆盖角色和画风约束</small></span>
            <textarea rows="3" maxlength="300" placeholder="例如：远处有巨大的月轮，风吹动披风，晨光穿过云层……" data-description></textarea>
          </label>
        </div>

        <div class="step-block">
          <div class="step-head"><span data-step-output>05</span><div><h2>选择壁纸规格</h2><p>只提供主流 PC 与手机规格，并自动加入对应安全区和构图约束。</p></div></div>
          <div class="output-options">
            {outputSpecs.map((spec, index) => (
              <button
                class:list={{ 'output-option': true, 'is-active': spec.id === initialOutput?.id || (!initialOutput && index === 0) }}
                type="button"
                data-output-spec-id={spec.id}
                data-output-name={spec.name}
                data-output-device={spec.deviceType}
                data-ratio={spec.ratio}
                data-width={String(spec.width)}
                data-height={String(spec.height)}
                aria-pressed={spec.id === initialOutput?.id ? 'true' : 'false'}
              >
                <span class="device-icon" aria-hidden="true">
                  {spec.deviceType === 'mobile' ? <Smartphone size={22} strokeWidth={1.65} /> : <Monitor size={24} strokeWidth={1.65} />}
                </span>
                <span class="output-copy">
                  <strong>{spec.name}</strong>
                  <small>{spec.ratio} · {spec.width}×{spec.height}</small>
                </span>
                <span class="output-note">{spec.deviceType === 'mobile' ? '预留锁屏顶部安全区' : '适合横向环境叙事'}</span>
              </button>
            ))}
          </div>
        </div>

        <button class="btn btn-primary generate-button" type="button" data-generate>
          <span data-generate-label>开始绘神</span><Sparkles size={17} strokeWidth={1.8} aria-hidden="true" />
        </button>
      </form>

      <aside class="preview-column">
        <div class="recipe-card surface">
          <div class="recipe-head"><span class="small-caps">Generation Recipe</span><strong>本次绘神配方</strong></div>
          <div class="recipe-grid">
            <div><span>对象</span><strong data-summary-entity>{initialCharacter?.name ?? '神灵'}</strong></div>
            <div data-summary-variant-wrap><span>形态</span><strong data-summary-variant>经典设定</strong></div>
            <div><span>画风</span><strong data-summary-style>{initialStyle?.name ?? '经典神话'}</strong></div>
            <div><span>场景</span><strong data-summary-scene>云海</strong></div>
            <div><span>镜头</span><strong data-summary-composition>人物居中</strong></div>
            <div><span>规格</span><strong data-summary-output>{initialOutput?.name ?? '手机壁纸'}</strong></div>
          </div>
          <div class="identity-lock"><span class="lock-dot"></span><span data-identity-message>Canonical Design 已锁定，画风不会覆盖角色身份。</span></div>
        </div>

        <div class="preview-card surface">
          <div class="preview-stage" data-preview-stage data-device={initialOutput?.deviceType ?? 'mobile'}>
            <div class="preview-frame" data-preview-frame>
              <img src={initialImage} alt="AI 绘神预览" width="720" height="1280" data-preview-image />
              <div class="preview-overlay"></div>
              <div class="mobile-safe-zone" data-mobile-safe-zone aria-hidden="true"></div>
              <div class="preview-status" data-preview-status>
                <span class="small-caps">Creation Preview</span>
                <strong data-preview-title>{initialCharacter?.name ?? '神灵'} · {initialStyle?.name ?? '经典神话'}</strong>
                <p data-preview-subtitle>经典设定 · 云海 · {initialOutput?.name ?? '手机壁纸'}</p>
              </div>
            </div>
          </div>
          <div class="resolution-line"><span>输出尺寸</span><strong data-resolution>{initialOutput?.width ?? 1440} × {initialOutput?.height ?? 2560}</strong></div>
          <div class="preview-actions" data-preview-actions hidden>
            <a class="btn btn-secondary" data-download href="#" download>下载</a>
            <button class="btn btn-secondary" type="button" data-publish>申请公开</button>
            <button class="btn btn-secondary" type="button" data-retry hidden>重试</button>
            <button class="btn btn-secondary" type="button" data-favorite aria-pressed="false">收藏</button>
          </div>
        </div>

        <div class="refine-card surface" data-refine-panel hidden>
          <div class="refine-head"><span class="small-caps">Quick Refine</span><strong>保持配方，只微调结果</strong></div>
          <div class="refine-options">
            {quickRefines.map((item) => (
              <button class="refine-option" type="button" data-refine={item.key} title={item.hint}>{item.label}</button>
            ))}
          </div>
        </div>

        <div class="history-card surface" data-history>
          <div class="history-head"><span><span class="small-caps">Recent</span><strong>最近的绘神</strong></span><button type="button" class="history-clear" data-history-clear>清空</button></div>
          <div class="history-list" data-history-list></div>
          <div class="history-empty" data-history-empty>还没有生成记录。完成第一张后，可在这里快速回看配方。</div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-creator]');
    if (!root) return;

    const state = {
      entityType: 'character',
      entityId: root.dataset.initialEntityId || '',
      entity: root.dataset.initialEntityName || '',
      image: root.dataset.initialImage || '',
      variantId: '',
      variant: '经典设定',
      styleId: root.dataset.initialStyleId || 'canonical',
      style: root.dataset.initialStyleName || '经典神话',
      scene: '云海',
      composition: '人物居中',
      outputSpecId: root.dataset.initialOutputId || 'mobile-wallpaper',
      outputName: root.dataset.initialOutputName || '手机壁纸',
      ratio: root.dataset.initialRatio || '9:16',
      width: Number(root.dataset.initialWidth || 1440),
      height: Number(root.dataset.initialHeight || 2560),
      device: 'mobile',
      lastJobId: null,
      lastImageUrl: null,
    };

    const HISTORY_KEY = 'mythcanvas-generations-v2';
    const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const loadHistory = () => { try { return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]'); } catch { return []; } };
    const saveHistory = (list) => { try { localStorage.setItem(HISTORY_KEY, JSON.stringify(list.slice(0, 8))); } catch { /* ignore */ } };

    const preselectWorld = () => {
      try {
        const worldSlug = new URLSearchParams(window.location.search).get('world');
        if (!worldSlug) return;
        const match = root.querySelector(`[data-entity-type="world"][data-entity-slug="${CSS.escape(worldSlug)}"]`);
        if (!match) return;
        const tab = root.querySelector('[data-entity-tab="world"]');
        if (tab) tab.click();
        match.click();
      } catch { /* ignore malformed query */ }
    };

    const setPressed = (selector, active) => {
      root.querySelectorAll(selector).forEach((item) => {
        const selected = item === active;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
    };

    const selectBaseVariant = () => {
      state.variantId = '';
      state.variant = '经典设定';
      const group = root.querySelector(`[data-variant-group="${state.entityId}"]`);
      const base = group?.querySelector('[data-variant-id=""]');
      if (base) setPressed(`[data-variant-group="${state.entityId}"] [data-variant-id]`, base);
    };

    const refresh = () => {
      const image = root.querySelector('[data-preview-image]');
      if (image && !state.lastImageUrl && image.getAttribute('src') !== state.image) image.setAttribute('src', state.image);
      root.querySelector('[data-preview-title]').textContent = `${state.entity} · ${state.style}`;
      root.querySelector('[data-preview-subtitle]').textContent = `${state.entityType === 'character' ? state.variant + ' · ' : ''}${state.scene} · ${state.outputName}`;
      root.querySelector('[data-summary-entity]').textContent = state.entity;
      root.querySelector('[data-summary-style]').textContent = state.style;
      root.querySelector('[data-summary-scene]').textContent = state.scene;
      root.querySelector('[data-summary-composition]').textContent = state.composition;
      root.querySelector('[data-summary-output]').textContent = `${state.outputName} · ${state.ratio}`;
      root.querySelector('[data-summary-variant]').textContent = state.variant;
      const variantWrap = root.querySelector('[data-summary-variant-wrap]');
      if (variantWrap) variantWrap.hidden = state.entityType !== 'character';
      const identityMessage = root.querySelector('[data-identity-message]');
      if (identityMessage) identityMessage.textContent = state.entityType === 'character'
        ? `Canonical Design 已锁定；${state.variant} 与 ${state.style} 正交组合。`
        : '神域 Canonical Design 与文明 Visual DNA 已锁定。';
      const stage = root.querySelector('[data-preview-stage]');
      if (stage) stage.dataset.device = state.device;
      const safeZone = root.querySelector('[data-mobile-safe-zone]');
      if (safeZone) safeZone.hidden = state.device !== 'mobile';
      root.querySelector('[data-resolution]').textContent = `${state.width} × ${state.height}`;
    };

    root.querySelectorAll('[data-entity-tab]').forEach((button) => {
      button.addEventListener('click', () => {
        const type = button.dataset.entityTab;
        if (!type) return;
        state.entityType = type;
        state.lastImageUrl = null;
        setPressed('[data-entity-tab]', button);
        root.querySelectorAll('[data-entity-group]').forEach((group) => { group.hidden = group.dataset.entityGroup !== type; });
        const variantStep = root.querySelector('[data-variant-step]');
        if (variantStep) variantStep.hidden = type !== 'character';
        root.querySelector('[data-step-style]').textContent = type === 'character' ? '03' : '02';
        root.querySelector('[data-step-scene]').textContent = type === 'character' ? '04' : '03';
        root.querySelector('[data-step-output]').textContent = type === 'character' ? '05' : '04';
        const first = root.querySelector(`[data-entity-group="${type}"] [data-entity]`);
        if (first) first.click();
      });
    });

    root.querySelectorAll('[data-entity]').forEach((button) => {
      button.addEventListener('click', () => {
        state.entityId = button.dataset.entityId || state.entityId;
        state.entity = button.dataset.name || state.entity;
        state.image = button.dataset.image || state.image;
        state.lastImageUrl = null;
        setPressed(`[data-entity-type="${button.dataset.entityType}"]`, button);
        root.querySelectorAll('[data-variant-group]').forEach((group) => { group.hidden = group.dataset.variantGroup !== state.entityId; });
        if (state.entityType === 'character') selectBaseVariant();
        refresh();
      });
    });

    root.querySelectorAll('[data-variant-id]').forEach((button) => {
      button.addEventListener('click', () => {
        if (state.entityType !== 'character') return;
        state.variantId = button.dataset.variantId || '';
        state.variant = button.dataset.variantName || '经典设定';
        setPressed(`[data-variant-group="${state.entityId}"] [data-variant-id]`, button);
        refresh();
      });
    });

    root.querySelectorAll('[data-style-id]').forEach((button) => {
      button.addEventListener('click', () => {
        state.styleId = button.dataset.styleId || state.styleId;
        state.style = button.dataset.styleName || state.style;
        setPressed('[data-style-id]', button);
        refresh();
      });
    });

    root.querySelectorAll('[data-scene]').forEach((button) => {
      button.addEventListener('click', () => {
        state.scene = button.dataset.scene || state.scene;
        setPressed('[data-scene]', button);
        refresh();
      });
    });

    root.querySelectorAll('[data-composition]').forEach((button) => {
      button.addEventListener('click', () => {
        state.composition = button.dataset.composition || state.composition;
        setPressed('[data-composition]', button);
        refresh();
      });
    });

    root.querySelectorAll('[data-output-spec-id]').forEach((button) => {
      button.addEventListener('click', () => {
        state.outputSpecId = button.dataset.outputSpecId || state.outputSpecId;
        state.outputName = button.dataset.outputName || state.outputName;
        state.device = button.dataset.outputDevice || state.device;
        state.ratio = button.dataset.ratio || state.ratio;
        state.width = Number(button.dataset.width || state.width);
        state.height = Number(button.dataset.height || state.height);
        setPressed('[data-output-spec-id]', button);
        refresh();
      });
    });

    const setBusy = (busy, label) => {
      const button = root.querySelector('[data-generate]');
      const actions = root.querySelector('[data-preview-actions]');
      if (!button) return;
      button.disabled = busy;
      const labelNode = button.querySelector('[data-generate-label]');
      if (labelNode) labelNode.textContent = label;
      if (actions) actions.hidden = busy || !state.lastImageUrl;
    };

    const runGenerate = async (isRetry, refineHint) => {
      const status = root.querySelector('[data-preview-status]');
      const image = root.querySelector('[data-preview-image]');
      const retryBtn = root.querySelector('[data-retry]');
      const favoriteBtn = root.querySelector('[data-favorite]');
      const downloadBtn = root.querySelector('[data-download]');
      const description = root.querySelector('[data-description]');
      if (!status || !image) return;

      const statusTitle = status.querySelector('strong');
      const statusText = status.querySelector('p');
      setBusy(true, '正在绘神…');
      status.classList.add('is-generating');
      if (retryBtn) retryBtn.hidden = true;
      if (favoriteBtn) favoriteBtn.setAttribute('aria-pressed', 'false');
      if (statusTitle) statusTitle.textContent = isRetry ? '正在重新构筑' : '正在组合绘神配方';
      if (statusText) statusText.textContent = `${state.entity}${state.entityType === 'character' ? ' · ' + state.variant : ''} · ${state.style} · ${state.outputName}`;

      const baseDescription = description?.value || '';
      const body = {
        entityType: state.entityType,
        entityId: state.entityId,
        variantId: state.entityType === 'character' && state.variantId ? state.variantId : undefined,
        styleId: state.styleId,
        scene: state.scene,
        composition: state.composition,
        ratio: state.ratio,
        outputSpecId: state.outputSpecId,
        description: [baseDescription, refineHint].filter(Boolean).join('，'),
        sourceGenerationId: state.lastJobId || undefined,
      };

      try {
        const response = await fetch('/api/generate', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const result = await response.json();
        if (response.status === 429) throw new Error(result.error?.message || '绘神次数已达上限，请稍后再试。');
        if (result.status === 'moderated') throw new Error(result.error?.message || '生成内容未通过安全审核。');
        if (!response.ok || result.status !== 'succeeded' || !result.imageUrl) throw new Error(result.error?.message || '生成失败');

        state.lastJobId = result.id;
        state.lastImageUrl = result.imageUrl;
        image.setAttribute('src', result.imageUrl);
        image.setAttribute('alt', `${state.entity} · ${state.variant} · ${state.style} · ${state.scene}`);
        if (statusTitle) statusTitle.textContent = `${state.entity} · ${state.style}`;
        if (statusText) statusText.textContent = result.persisted ? '神迹已完成，并保存生成配方与资产溯源。' : '神迹已完成 · 当前环境使用临时生成结果。';

        const history = loadHistory();
        history.unshift({
          jobId: result.id,
          entityType: state.entityType,
          entityId: state.entityId,
          entity: state.entity,
          variantId: state.variantId,
          variant: state.variant,
          styleId: state.styleId,
          style: state.style,
          scene: state.scene,
          composition: state.composition,
          outputSpecId: state.outputSpecId,
          outputName: state.outputName,
          ratio: state.ratio,
          width: state.width,
          height: state.height,
          device: state.device,
          imageUrl: result.imageUrl,
          createdAt: new Date().toISOString(),
        });
        saveHistory(history);
        renderHistory();

        if (downloadBtn instanceof HTMLAnchorElement) downloadBtn.href = result.imageUrl;
        const refinePanel = root.querySelector('[data-refine-panel]');
        if (refinePanel) refinePanel.hidden = false;
        setBusy(false, '再绘一次');
      } catch (error) {
        const message = error instanceof Error ? error.message : '请稍后再试';
        if (statusTitle) statusTitle.textContent = '这次神迹没有完成';
        if (statusText) statusText.textContent = message;
        setBusy(false, '重新绘神');
        if (retryBtn) retryBtn.hidden = false;
      } finally {
        status.classList.remove('is-generating');
      }
    };

    const renderHistory = () => {
      const list = loadHistory();
      const listEl = root.querySelector('[data-history-list]');
      const emptyEl = root.querySelector('[data-history-empty]');
      if (!listEl) return;
      listEl.innerHTML = '';
      if (emptyEl) emptyEl.hidden = list.length !== 0;
      list.forEach((item) => {
        const row = document.createElement('button');
        row.type = 'button';
        row.className = 'history-item';
        row.setAttribute('aria-label', `查看 ${item.entity} 的生成`);
        const img = document.createElement('img');
        img.src = item.imageUrl;
        img.alt = '';
        img.loading = 'lazy';
        const span = document.createElement('span');
        span.innerHTML = `<strong>${escapeHtml(item.entity)} · ${escapeHtml(item.style)}</strong><small>${escapeHtml(item.variant || '经典设定')} · ${escapeHtml(item.outputName || item.ratio)}</small>`;
        row.appendChild(img);
        row.appendChild(span);
        row.addEventListener('click', () => {
          state.lastJobId = item.jobId || null;
          state.lastImageUrl = item.imageUrl;
          const preview = root.querySelector('[data-preview-image]');
          if (preview) preview.setAttribute('src', item.imageUrl);
        });
        listEl.appendChild(row);
      });
    };

    root.querySelector('[data-generate]')?.addEventListener('click', () => runGenerate(false));
    root.querySelector('[data-retry]')?.addEventListener('click', () => runGenerate(true));
    root.querySelectorAll('[data-refine]').forEach((button) => button.addEventListener('click', () => runGenerate(false, button.title || '')));

    root.querySelector('[data-favorite]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      if (!button || !state.lastJobId) return;
      try {
        const response = await fetch('/api/favorite', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ targetType: 'generation', targetId: state.lastJobId }),
        });
        const result = await response.json();
        if (response.ok && result.favorited) {
          button.setAttribute('aria-pressed', 'true');
          button.textContent = '已收藏';
        } else if (response.status === 401) {
          const redirect = `${window.location.pathname}${window.location.search}`;
          window.location.href = `${result.loginUrl || '/login/'}?redirect=${encodeURIComponent(redirect)}`;
        } else button.textContent = result.message || '收藏失败';
      } catch { button.textContent = '收藏失败'; }
    });

    root.querySelector('[data-publish]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      if (!state.lastJobId) return;
      const defaultTitle = `${state.entity} · ${state.variant} · ${state.style}`;
      const title = window.prompt('为这幅作品起个标题（审核通过后进入探索页）', defaultTitle);
      if (title === null || !title.trim()) return;
      button.disabled = true;
      try {
        const response = await fetch('/api/submission', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ generationId: state.lastJobId, title: title.trim(), name: state.entity }),
        });
        const result = await response.json();
        alert(result.message || '操作完成');
      } catch { alert('网络错误，请重试'); }
      finally { button.disabled = false; }
    });

    root.querySelector('[data-history-clear]')?.addEventListener('click', () => { saveHistory([]); renderHistory(); });

    const initialOutputButton = root.querySelector(`[data-output-spec-id="${state.outputSpecId}"]`);
    if (initialOutputButton) state.device = initialOutputButton.dataset.outputDevice || 'mobile';
    refresh();
    renderHistory();
    preselectWorld();
  })();
</script>


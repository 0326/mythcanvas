---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import MythologyCard from '../../../../components/mythology/MythologyCard.astro';
import { getLocalizedMythologies } from '../../../../lib/content/repositories';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const mythologies = await getLocalizedMythologies(db, 'en', { limit: 100 });
const indexable = mythologies.length > 0;
const heroImage = '/media/content/mythology-civilizations-banner.webp';
---

<BaseLayout
  title="World Mythologies"
  description="Explore Chinese, Greek, Norse, Egyptian, Indian, Japanese, Celtic, Maya, Aztec, and Mesopotamian mythology through gods, realms, and original visual interpretations."
  immersiveHeader
  fullBleed
  localizedIndexable={indexable}
>
  <section class="mythology-hero" aria-labelledby="mythology-title">
    <div class="mythology-hero-art" style={`--mythology-hero-image:url("${heroImage}")`} aria-hidden="true"></div>
    <div class="mythology-hero-overlay" aria-hidden="true"></div>
    <div class="container-wide mythology-hero-inner">
      <div class="mythology-hero-copy">
        <span class="eyebrow">Mythologies · Visual Civilizations</span>
        <h1 id="mythology-title">Explore the world through myth</h1>
        <p>Follow gods, sacred realms, heroes, monsters, and foundational stories across ten mythological traditions.</p>
      </div>
    </div>
  </section>

  <section class="mythology-collection" aria-label="Mythology collection">
    <div class="container-wide">
      {mythologies.length > 0 ? (
        <div class="collection-grid">
          {mythologies.map((mythology, index) => (
            <MythologyCard
              mythology={mythology}
              index={index}
              featured={index === 0 || index === mythologies.length - 1}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state surface">
          <h2>English mythology content is being prepared</h2>
          <p>Only reviewed, published translations are shown here. The Chinese edition remains available while English content is completed.</p>
          <a class="btn btn-secondary" href="/mythology/">Open the Chinese edition</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .mythology-hero {
    position: relative;
    min-height: clamp(520px, 64svh, 680px);
    isolation: isolate;
    overflow: hidden;
  }
  .mythology-hero-art,
  .mythology-hero-overlay { position: absolute; inset: 0; pointer-events: none; }
  .mythology-hero-art {
    z-index: -3;
    background-image: var(--mythology-hero-image);
    background-repeat: no-repeat;
    background-position: 66% 48%;
    background-size: cover;
    transform: scale(1.025);
  }
  .mythology-hero-overlay {
    z-index: -2;
    background:
      linear-gradient(to right, color-mix(in srgb, var(--bg-primary) 94%, transparent), color-mix(in srgb, var(--bg-primary) 64%, transparent) 38%, color-mix(in srgb, var(--bg-primary) 18%, transparent) 72%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg-primary) 45%, transparent), transparent 48%, var(--bg-primary));
  }
  .mythology-hero-inner { display: flex; min-height: inherit; align-items: center; padding-block: 7rem 4rem; }
  .mythology-hero-copy { width: min(760px, 70%); }
  .mythology-hero h1 {
    max-width: 760px;
    margin: .6rem 0 0;
    font-family: var(--font-display, var(--font-serif));
    font-size: clamp(3.8rem, 7.2vw, 7rem);
    font-weight: 620;
    line-height: .96;
    letter-spacing: -.05em;
    text-wrap: balance;
  }
  .mythology-hero p { max-width: 650px; margin: 1.6rem 0 0; color: var(--text-secondary); font-size: clamp(1rem, 1.25vw, 1.16rem); line-height: 1.8; }
  .mythology-collection { padding-block: clamp(2rem, 5vw, 4rem) clamp(5rem, 10vw, 9rem); }
  .collection-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.75rem); }
  .empty-state { max-width: 760px; margin-inline: auto; padding: clamp(2rem, 5vw, 4rem); text-align: center; border-radius: var(--radius-xl); }
  .empty-state p { color: var(--text-secondary); }
  @media (max-width: 900px) {
    .mythology-hero-copy { width: min(680px, 88%); }
    .collection-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .mythology-hero-copy { width: 100%; }
    .mythology-hero h1 { font-size: clamp(3rem, 15vw, 4.8rem); }
  }
</style>

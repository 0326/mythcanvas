---
import { ArrowRight, Landmark, UserRound } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedCharacters, getLocalizedMythologyBySlug, getLocalizedWorlds } from '../../../lib/content/repositories';
import { localizedPath } from '../../../lib/i18n/url';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const { slug } = Astro.params;
const mythology = await getLocalizedMythologyBySlug(db, slug ?? '', 'en');
if (!mythology) return Astro.redirect(localizedPath('en', '/mythology/'));

const [allCharacters, allWorlds] = await Promise.all([
  getLocalizedCharacters(db, 'en', { limit: 1000 }),
  getLocalizedWorlds(db, 'en', { limit: 1000 }),
]);
const characters = allCharacters.filter((item) => item.mythologyId === mythology.id);
const worlds = allWorlds.filter((item) => item.mythologyId === mythology.id);
const heroImage = mythology.heroImage;
---

<BaseLayout
  title={mythology.name}
  description={mythology.summary}
  image={heroImage.src}
  fullBleed
  immersiveHeader
  localizedIndexable
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: mythology.name,
        description: mythology.summary,
        image: new URL(heroImage.src, Astro.site).toString(),
        inLanguage: 'en',
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(localizedPath('en', '/'), Astro.site).toString() },
          { '@type': 'ListItem', position: 2, name: 'Mythology', item: new URL(localizedPath('en', '/mythology/'), Astro.site).toString() },
          { '@type': 'ListItem', position: 3, name: mythology.name },
        ],
      },
    ])} />
  </Fragment>

  <section class="detail-hero">
    <img src={heroImage.src} alt={heroImage.alt} width={heroImage.width} height={heroImage.height} fetchpriority="high" />
    <div class="hero-overlay" aria-hidden="true"></div>
    <nav class="container-wide breadcrumb" aria-label="Breadcrumb">
      <a href={localizedPath('en', '/')}>Home</a><span>/</span>
      <a href={localizedPath('en', '/mythology/')}>Mythology</a><span>/</span>
      <span aria-current="page">{mythology.name}</span>
    </nav>
    <div class="container-wide hero-copy">
      <span class="eyebrow">Mythology · {mythology.tagline}</span>
      <h1>{mythology.name}</h1>
      <p>{mythology.summary}</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container-wide">
      <header class="section-heading">
        <span class="eyebrow">Explore the tradition</span>
        <h2>Gods, heroes, and sacred realms</h2>
        <p>This English edition only surfaces entities whose translations have been reviewed and published.</p>
      </header>

      <div class="entity-columns">
        <div class="entity-panel surface">
          <div class="panel-title"><UserRound size={20} strokeWidth={1.8} /><span>Characters</span><small>{characters.length}</small></div>
          {characters.length > 0 ? characters.slice(0, 12).map((character) => (
            <a href={localizedPath('en', `/character/${character.slug}/`)}>
              <span><strong>{character.name}</strong><small>{character.role}</small></span>
              <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
            </a>
          )) : <p class="empty-copy">Reviewed English character profiles are still being prepared.</p>}
          {characters.length > 0 && <a class="panel-more" href={`${localizedPath('en', '/character/')}?mythology=${mythology.slug}`}>View all translated characters <ArrowRight size={16} /></a>}
        </div>

        <div class="entity-panel surface">
          <div class="panel-title"><Landmark size={20} strokeWidth={1.8} /><span>Realms</span><small>{worlds.length}</small></div>
          {worlds.length > 0 ? worlds.map((world) => (
            <a href={localizedPath('en', `/world/${world.slug}/`)}>
              <span><strong>{world.name}</strong><small>{world.summary}</small></span>
              <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
            </a>
          )) : <p class="empty-copy">Reviewed English realm pages are still being prepared for this tradition.</p>}
        </div>
      </div>

      <div class="localization-note surface-muted">
        <span class="eyebrow">English Edition</span>
        <h2>Stories will open after editorial localization</h2>
        <p>MythCanvas does not expose Chinese story prose under an English URL. Long-form stories will appear here only after the full article, source notes, captions, and metadata are localized together.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .detail-hero { position: relative; min-height: max(680px, 82vh); display: grid; grid-template-rows: auto 1fr; overflow: hidden; color: white; background: #101923; }
  .detail-hero > img, .hero-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
  .detail-hero > img { object-fit: cover; }
  .hero-overlay { background: linear-gradient(180deg, rgba(4,8,14,.25), rgba(4,8,14,.1) 36%, rgba(4,8,14,.82)), linear-gradient(90deg, rgba(4,8,14,.62), transparent 68%); }
  .breadcrumb, .hero-copy { position: relative; z-index: 1; }
  .breadcrumb { display: flex; gap: .55rem; align-items: center; padding-top: calc(var(--header-height) + 2rem); color: rgba(255,255,255,.7); font-size: .76rem; }
  .breadcrumb a { color: inherit; }
  .hero-copy { align-self: end; max-width: 1100px; padding-bottom: clamp(4rem, 8vw, 7rem); }
  .hero-copy h1 { max-width: 900px; margin: .5rem 0 1.2rem; color: white; font-size: clamp(4rem, 8vw, 8rem); line-height: .95; letter-spacing: -.045em; }
  .hero-copy p { max-width: 760px; margin: 0; color: rgba(255,255,255,.82); font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.8; }
  .content-section { padding-block: clamp(4rem, 8vw, 7rem); }
  .section-heading { max-width: 760px; margin-bottom: 2rem; }
  .section-heading h2 { margin: .35rem 0 .7rem; font-size: clamp(2.2rem, 4vw, 4rem); }
  .section-heading p, .localization-note p { color: var(--text-secondary); line-height: 1.75; }
  .entity-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; }
  .entity-panel { padding: clamp(1.3rem, 3vw, 2rem); border-radius: var(--radius-xl); }
  .panel-title { display: flex; align-items: center; gap: .6rem; margin-bottom: 1rem; font-weight: 700; }
  .panel-title small { margin-left: auto; color: var(--text-muted); }
  .entity-panel > a:not(.panel-more) { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: .85rem; border-top: 1px solid var(--border); color: inherit; }
  .entity-panel a span { display: grid; gap: .18rem; min-width: 0; }
  .entity-panel a small { color: var(--text-muted); line-height: 1.45; overflow: hidden; text-overflow: ellipsis; }
  .panel-more { display: inline-flex; align-items: center; gap: .4rem; margin-top: 1rem; color: var(--accent-strong); font-size: .84rem; font-weight: 700; }
  .empty-copy { color: var(--text-muted); line-height: 1.7; }
  .localization-note { margin-top: 2rem; padding: clamp(1.8rem, 4vw, 3rem); border-radius: var(--radius-xl); }
  .localization-note h2 { margin: .3rem 0 .7rem; }
  @media (max-width: 780px) { .entity-columns { grid-template-columns: 1fr; } .hero-copy h1 { font-size: clamp(3.4rem, 17vw, 6rem); } }
</style>

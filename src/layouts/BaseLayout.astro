---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { DEFAULT_LOCALE, getLocaleConfig } from '../lib/i18n/config';
import { getUiMessages } from '../lib/i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  fullBleed?: boolean;
  immersiveHeader?: boolean;
  hideFooter?: boolean;
  localizedIndexable?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  fullBleed = false,
  immersiveHeader = false,
  hideFooter = false,
  localizedIndexable = false,
} = Astro.props;

const locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const localeConfig = getLocaleConfig(locale);
const messages = getUiMessages(locale);
const localizedSiteTitle = locale === 'en' ? messages.brand.name : SITE_TITLE;
const localizedSiteDescription = locale === 'en' ? messages.brand.tagline : SITE_DESCRIPTION;
const pageTitle = title ? `${title} · ${localizedSiteTitle}` : localizedSiteTitle;
---

<!doctype html>
<html lang={localeConfig.htmlLang} dir={localeConfig.direction}>
  <head>
    <BaseHead title={pageTitle} description={description} image={image} siteName={localizedSiteTitle} localizedIndexable={localizedIndexable} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: localizedSiteTitle,
      url: Astro.site?.toString(),
      description: localizedSiteDescription,
      inLanguage: localeConfig.htmlLang,
    })} />
    <slot name="head" />
  </head>
  <body>
    <Header immersive={immersiveHeader} />
    <main class:list={{ 'page-main': true, 'page-main--contained': !fullBleed }}>
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>

<style>
  .page-main--contained {
    width: 100%;
  }
</style>

---
import type { Character, Mythology } from '../../lib/content/types';

interface Props {
  character: Character;
  mythology?: Mythology;
}

const { character, mythology } = Astro.props;
const primarySymbol = character.symbols[0] ?? '✦';
---

<article class="character-card surface" data-character-card>
  <a href={`/character/${character.slug}/`} aria-label={`${character.name} · ${character.nameEn}`}>
    <div class="portrait">
      {character.portrait ? (
        <img
          src={character.portrait.src}
          alt={`${character.name} 角色肖像`}
          width={character.portrait.width}
          height={character.portrait.height}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="portrait-fallback" aria-hidden="true">
          <div class="moon-ring"></div>
          <span>{primarySymbol}</span>
        </div>
      )}
      <span class="enter-hint" aria-hidden="true">进入角色 →</span>
    </div>
    <div class="copy">
      {mythology && <span class="mythology">{mythology.name}</span>}
      <h3>{character.name}</h3>
      <p class="en">{character.nameEn}</p>
      <span class="role">{character.role}</span>
    </div>
  </a>
</article>

<style>
  .character-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-base), border-color var(--transition-fast), box-shadow var(--transition-base);
  }

  .character-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  a {
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  .portrait {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform var(--transition-slow);
  }

  .portrait-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent-strong);
    background:
      radial-gradient(circle at 52% 38%, color-mix(in srgb, var(--moon-white) 80%, transparent), transparent 24%),
      linear-gradient(155deg, var(--cloud-blue), var(--jade-soft));
  }

  .moon-ring {
    position: absolute;
    width: 78px;
    height: 78px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .portrait-fallback span {
    position: relative;
    z-index: 1;
    max-width: 90px;
    padding: var(--space-2);
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
  }

  .enter-hint {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-pill);
    color: #fff;
    background: rgba(5, 12, 20, 0.42);
    backdrop-filter: blur(8px);
    font-size: 0.72rem;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .character-card:hover .portrait img,
  .character-card:focus-within .portrait img {
    transform: scale(1.035);
  }

  .character-card:hover .enter-hint,
  .character-card:focus-within .enter-hint {
    opacity: 1;
    transform: translateY(0);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .mythology {
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  h3 {
    margin: 0.15rem 0 0;
    font-size: 1.4rem;
    line-height: 1.2;
  }

  .en {
    margin: 0;
    color: var(--text-muted);
    font-family: Georgia, serif;
    font-size: 0.78rem;
  }

  .role {
    margin-top: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.78rem;
  }
</style>

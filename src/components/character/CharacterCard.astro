---
import { Flame } from '@lucide/astro';
import type { Character, Mythology } from '../../lib/content/types';
import {
  cloudflareImageUrl,
  shouldUseCloudflareImageTransformations,
} from '../../lib/media/cloudflare-images';

interface Props {
  character: Character;
  mythology?: Mythology;
}

const { character, mythology } = Astro.props;
const primarySymbol = character.symbols[0] ?? '✦';
const clickCount = Math.max(0, Math.floor(character.clickCount ?? 0));
const useImageTransformations = shouldUseCloudflareImageTransformations(Astro.url, Astro.site);
const portraitImage = character.portrait
  ? cloudflareImageUrl(
      character.portrait.src,
      {
        width: 480,
        height: 853,
        fit: 'cover',
        quality: 78,
        format: 'auto',
        // Cards keep the subject's face toward the upper part of the portrait.
        focalPoint: { x: 0.5, y: 0.2 },
      },
      useImageTransformations,
    )
  : undefined;
---

<article class="character-card surface" data-character-card data-character-id={character.id}>
  <a href={`/character/${character.slug}/`} aria-label={`${character.name} · 进入角色`}>
    <div class="portrait">
      {character.portrait ? (
        <img
          src={portraitImage ?? character.portrait.src}
          alt={`${character.name} 角色肖像`}
          width="480"
          height="853"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="portrait-fallback" aria-hidden="true">
          <div class="moon-ring"></div>
          <span>{primarySymbol}</span>
        </div>
      )}
      <span class="portrait-shade" aria-hidden="true"></span>
      {mythology && <span class="badge badge-mythology">{mythology.name}</span>}
      <span class="badge badge-heat" aria-label={`热度 ${clickCount} 次点击`}>
        <Flame size={14} strokeWidth={1.8} aria-hidden="true" />
        <span>{clickCount}</span>
      </span>
      <div class="copy">
        <h3>{character.name}</h3>
        <span class="role">{character.role}</span>
      </div>
    </div>
  </a>
</article>

<script>
  import { trackClick } from '../../lib/analytics/track';

  document.querySelectorAll<HTMLElement>('[data-character-card]').forEach((card) => {
    card.addEventListener('click', () => {
      const characterId = card.dataset.characterId;
      if (characterId) trackClick('character_click', characterId);
    });
  });
</script>

<style>
  .character-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 9 / 16;
    transition: transform var(--transition-base), border-color var(--transition-fast), box-shadow var(--transition-base);
  }

  .character-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  a {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
  }

  .portrait {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform var(--transition-slow);
  }

  .portrait-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--card-overlay) 12%, transparent) 0%,
      transparent 48%,
      var(--card-overlay) 100%
    );
    pointer-events: none;
  }

  .portrait-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent-strong);
    background:
      radial-gradient(circle at 52% 38%, color-mix(in srgb, var(--moon-white) 80%, transparent), transparent 24%),
      linear-gradient(155deg, var(--cloud-blue), var(--jade-soft));
  }

  .moon-ring {
    position: absolute;
    width: 78px;
    height: 78px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .portrait-fallback span {
    position: relative;
    z-index: 1;
    max-width: 90px;
    padding: var(--space-2);
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
  }

  .badge {
    position: absolute;
    top: 0.75rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--moon-white);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .badge-mythology {
    left: 0.75rem;
  }

  .badge-heat {
    right: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .character-card:hover .portrait img,
  .character-card:focus-within .portrait img {
    transform: scale(1.035);
  }

  .copy {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--moon-white);
    text-shadow: 0 1px 12px color-mix(in srgb, var(--bg-primary) 78%, transparent);
  }

  h3 {
    margin: 0;
    color: var(--moon-white);
    font-size: clamp(1.3rem, 1.5vw, 1.8rem);
    line-height: 1.2;
  }

  .role {
    margin-top: 0.15rem;
    color: color-mix(in srgb, var(--moon-white) 78%, transparent);
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait img {
      transition: none;
    }
  }
</style>

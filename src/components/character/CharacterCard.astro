---
import type { Character } from '../../lib/content/types';

interface Props {
  character: Character;
}

const { character } = Astro.props;
const primarySymbol = character.symbols[0] ?? '✦';
---

<article class="character-card surface">
  <a href={`/character/${character.slug}/`}>
    {character.portrait ? (
      <div class="portrait portrait-image">
        <img
          src={character.portrait.src}
          alt=""
          width={character.portrait.width}
          height={character.portrait.height}
          loading="lazy"
        />
      </div>
    ) : (
      <div class="portrait" aria-hidden="true">
        <div class="moon-ring"></div>
        <span>{primarySymbol}</span>
      </div>
    )}
    <div class="copy">
      <span class="role">{character.role}</span>
      <h3>{character.name}</h3>
      <p class="en">{character.nameEn}</p>
      <p class="summary">{character.summary}</p>
      <div class="symbols">
        {character.symbols.slice(0, 4).map((symbol) => <span>{symbol}</span>)}
      </div>
    </div>
  </a>
</article>

<style>
  .character-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-base), border-color var(--transition-fast), box-shadow var(--transition-base);
  }

  .character-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  a {
    display: grid;
    grid-template-columns: 120px 1fr;
    min-height: 220px;
    color: inherit;
  }

  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--accent-strong);
    background:
      radial-gradient(circle at 52% 38%, color-mix(in srgb, var(--moon-white) 80%, transparent), transparent 24%),
      linear-gradient(155deg, var(--cloud-blue), var(--jade-soft));
  }

  .portrait::before,
  .portrait::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 58px;
    border: 1px solid color-mix(in srgb, var(--accent) 36%, transparent);
    border-radius: 50%;
    transform: rotate(-22deg);
  }

  .portrait::after {
    transform: rotate(42deg);
  }

  .portrait > span {
    position: relative;
    z-index: 1;
    max-width: 90px;
    padding: var(--space-2);
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
  }

  .portrait-image {
    background: var(--surface-muted);
  }

  .portrait-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .character-card:hover .portrait-image img {
    transform: scale(1.045);
  }

  .moon-ring {
    position: absolute;
    width: 78px;
    height: 78px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .copy {
    padding: var(--space-5);
  }

  .role {
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 700;
  }

  h3 {
    margin: var(--space-2) 0 0;
    font-size: 1.55rem;
  }

  .en {
    margin: 0 0 var(--space-3);
    color: var(--text-muted);
    font-family: Georgia, serif;
    font-size: 0.8rem;
  }

  .summary {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.83rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .symbols {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .symbols span {
    padding: 0.18rem 0.42rem;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    background: var(--surface-muted);
    font-size: 0.7rem;
  }

  @media (max-width: 520px) {
    a {
      grid-template-columns: 96px 1fr;
    }
  }
</style>

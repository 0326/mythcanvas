---
import { Flame } from '@lucide/astro';
import type { Character, Mythology } from '../../lib/content/types';
import { DEFAULT_LOCALE } from '../../lib/i18n/config';
import { localizedPath } from '../../lib/i18n/url';
import {
  cloudflareImageUrl,
  shouldUseCloudflareImageTransformations,
} from '../../lib/media/cloudflare-images';

interface Props {
  character: Character;
  mythology?: Mythology;
}

const { character, mythology } = Astro.props;
const locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const isEnglish = locale === 'en';
const fallbackSymbols = isEnglish ? [] : character.symbols.slice(0, 3);
const clickCount = Math.max(0, Math.floor(character.clickCount ?? 0));
const useImageTransformations = shouldUseCloudflareImageTransformations(Astro.url, Astro.site);
const portraitImage = character.portrait
  ? cloudflareImageUrl(
      character.portrait.src,
      {
        width: 480,
        height: 853,
        fit: 'cover',
        quality: 78,
        format: 'auto',
        // Cards keep the subject's face toward the upper part of the portrait.
        focalPoint: { x: 0.5, y: 0.2 },
      },
      useImageTransformations,
    )
  : undefined;
const characterHref = localizedPath(locale, `/character/${character.slug}/`);
const enterLabel = isEnglish ? `Explore ${character.name}` : `${character.name} · 进入角色`;
const portraitAlt = character.portrait?.alt || (isEnglish ? `Portrait of ${character.name}` : `${character.name} 角色肖像`);
const heatLabel = isEnglish ? `Popularity: ${clickCount} clicks` : `热度 ${clickCount} 次点击`;
---

<article class="character-card surface" data-character-card data-character-id={character.id}>
  <a href={characterHref} aria-label={enterLabel}>
    <div class="portrait">
      {character.portrait ? (
        <img
          src={portraitImage ?? character.portrait.src}
          alt={portraitAlt}
          width="480"
          height="853"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="portrait-fallback" role="img" aria-label={`${character.name} Canonical symbol fallback`}>
          <div class="moon-ring" aria-hidden="true"></div>
          <div class="fallback-copy">
            <span class="fallback-kicker">Canonical symbol set</span>
            <strong>{fallbackSymbols.length > 0 ? fallbackSymbols.join(' · ') : character.name}</strong>
            <span class="fallback-role">{character.role}</span>
          </div>
        </div>
      )}
      <span class="portrait-shade" aria-hidden="true"></span>
      {mythology && <span class="badge badge-mythology">{mythology.name}</span>}
      <span class="badge badge-heat" aria-label={heatLabel}>
        <Flame size={14} strokeWidth={1.8} aria-hidden="true" />
        <span>{clickCount}</span>
      </span>
      <div class="copy">
        <h3>{character.name}</h3>
        <span class="role">{character.role}</span>
      </div>
    </div>
  </a>
</article>

<script>
  import { trackClick } from '../../lib/analytics/track';

  document.querySelectorAll<HTMLElement>('[data-character-card]').forEach((card) => {
    card.addEventListener('click', () => {
      const characterId = card.dataset.characterId;
      if (characterId) trackClick('character_click', characterId);
    });
  });
</script>

<style>
  .character-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 9 / 16;
    transition: transform var(--transition-base), border-color var(--transition-fast), box-shadow var(--transition-base);
  }

  .character-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  a {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
  }

  .portrait {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform var(--transition-slow);
  }

  .portrait-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--card-overlay) 12%, transparent) 0%,
      transparent 48%,
      var(--card-overlay) 100%
    );
    pointer-events: none;
  }

  .portrait-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    color: var(--accent-strong);
    background:
      radial-gradient(circle at 52% 38%, color-mix(in srgb, var(--moon-white) 80%, transparent), transparent 24%),
      linear-gradient(155deg, var(--cloud-blue), var(--jade-soft));
  }

  .moon-ring {
    position: absolute;
    width: 78px;
    height: 78px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .fallback-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.65rem;
    max-width: 13rem;
    text-align: center;
  }

  .fallback-kicker {
    color: var(--text-muted);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .fallback-copy strong {
    position: relative;
    z-index: 1;
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    font-weight: 700;
    line-height: 1.5;
  }

  .fallback-role {
    color: var(--text-secondary);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .badge {
    position: absolute;
    z-index: 2;
    top: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--border-strong) 58%, transparent);
    border-radius: var(--radius-pill);
    color: var(--text-primary);
    background: color-mix(in srgb, var(--surface) 74%, transparent);
    backdrop-filter: blur(10px);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .badge-mythology {
    left: var(--space-3);
    padding: 0.28rem 0.55rem;
  }

  .badge-heat {
    right: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: .22rem;
    padding: 0.24rem 0.45rem;
  }

  .copy {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: .25rem;
    padding: var(--space-4);
    color: white;
  }

  .copy h3 {
    margin: 0;
    color: white;
    font-size: 1.2rem;
    text-shadow: 0 2px 16px rgba(0, 0, 0, .5);
  }

  .role {
    color: rgba(255, 255, 255, .78);
    font-size: .72rem;
    line-height: 1.45;
    text-shadow: 0 2px 12px rgba(0, 0, 0, .45);
  }

  .character-card:hover img,
  .character-card:focus-within img {
    transform: scale(1.035);
  }
</style>

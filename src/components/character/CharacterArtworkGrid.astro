---
import {
  X, ChevronLeft, ChevronRight, Download, Sparkles, Flashlight, Camera,
  Wifi, Signal, BatteryFull,
} from '@lucide/astro';
import type { Character, ImageAsset } from '../../lib/content/types';
import { getCharacterStyle, type CharacterStyleId } from '../../lib/content/character-styles';
import {
  cloudflareArtworkListImage,
  cloudflareImageUrl,
  shouldUseCloudflareImageTransformations,
} from '../../lib/media/cloudflare-images';

export type WallpaperDevice = 'pc' | 'mobile';
export type StyleFilter = CharacterStyleId | 'all';

export type ArtworkCard = {
  id: string;
  styleId: CharacterStyleId;
  device: WallpaperDevice;
  title: string;
  styleName: string;
  styleNameEn: string;
  image: ImageAsset;
  href: string;
  recreateHref: string;
};

interface Props {
  character: Character;
  artworkCards: ArtworkCard[];
  selectedStyle: StyleFilter;
  selectedStyleName: string;
  selectedDevice: WallpaperDevice;
  selectedInterpretationSlug?: string;
  selectedVariantSlug: string;
  emptyCreateHref: string;
}

const {
  character,
  artworkCards,
  selectedStyle,
  selectedStyleName,
  selectedDevice,
  selectedInterpretationSlug = '',
  selectedVariantSlug,
  emptyCreateHref,
} = Astro.props;

const cardMatchesStyle = (card: ArtworkCard, style: StyleFilter) =>
  style === 'all' || card.styleId === style;

const hasVisible = artworkCards.some(
  (card) => cardMatchesStyle(card, selectedStyle) && card.device === selectedDevice,
);

const styleOptionIds: CharacterStyleId[] = [];
for (const card of artworkCards) {
  if (!styleOptionIds.includes(card.styleId)) styleOptionIds.push(card.styleId);
}
const styleOptions = [
  { id: 'all' as const, name: '全部', description: '所有艺术风格' },
  ...styleOptionIds.map((id) => {
    const def = getCharacterStyle(id);
    return { id, name: def.name, description: def.description };
  }),
];

const filterHref = (style: StyleFilter, device: WallpaperDevice) => {
  const params = new URLSearchParams();
  if (selectedInterpretationSlug) params.set('interpretation', selectedInterpretationSlug);
  if (selectedVariantSlug) params.set('variant', selectedVariantSlug);
  if (style && style !== 'all') params.set('style', style);
  if (device !== 'pc') params.set('device', device);
  const query = params.toString();
  return `/character/${character.slug}/${query ? `?${query}` : ''}#wallpapers`;
};

const deviceLabels: Record<WallpaperDevice, string> = {
  pc: 'PC',
  mobile: 'Mobile',
};
const useImageTransformations = shouldUseCloudflareImageTransformations(Astro.url, Astro.site);
const artworkCardsWithListImages = artworkCards.map((card) => ({
  card,
  listImage: cloudflareArtworkListImage(
    card.image.src,
    card.image.width,
    card.image.height,
    'tile',
    useImageTransformations,
  ),
  previewSrc: cloudflareImageUrl(
    card.image.src,
    {
      width: card.device === 'mobile' ? 480 : 1280,
      height: card.device === 'mobile' ? 990 : 720,
      fit: 'cover',
      quality: 72,
      format: 'auto',
      focalPoint: { x: 0.5, y: 0.34 },
    },
    useImageTransformations,
  ) ?? card.image.src,
}));
---

{artworkCards.length > 0 && (
  <div class="wallpaper-filter-bar">
    <div class="filter-group" role="group" aria-label="筛选艺术风格">
      <span class="filter-label">风格</span>
      <div class="filter-options">
        {styleOptions.map((opt) => (
          <a
            class:list={{ 'filter-option': true, 'is-active': opt.id === selectedStyle }}
            href={filterHref(opt.id, selectedDevice)}
            data-style-filter={opt.id}
            data-style-label={opt.name}
            data-style-description={opt.description}
            aria-current={opt.id === selectedStyle ? 'true' : 'false'}
          >{opt.name}</a>
        ))}
      </div>
    </div>
    <div class="filter-group filter-group-device" role="group" aria-label="选择壁纸设备">
      <span class="filter-label">设备</span>
      <div class="filter-options">
        {(['pc', 'mobile'] as const).map((device) => (
          <a
            class:list={{ 'filter-option': true, 'is-active': device === selectedDevice }}
            href={filterHref(selectedStyle, device)}
            data-device-filter={device}
            aria-current={device === selectedDevice ? 'true' : 'false'}
          >{deviceLabels[device]}</a>
        ))}
      </div>
    </div>
  </div>
)}

{artworkCards.length > 0 ? (
  <div class="wallpaper-grid" data-wallpaper-grid data-active-device={selectedDevice}>
    {artworkCardsWithListImages.map(({ card, listImage, previewSrc }) => (
      <article
        class:list={{ 'wallpaper-card': true, [`wallpaper-style-${card.styleId}`]: true }}
        data-wallpaper-card
        data-style={card.styleId}
        data-device={card.device}
        data-artwork-id={card.id}
        data-artwork-title={card.title}
        data-artwork-style={card.styleName}
        data-artwork-device={card.device}
        data-artwork-width={card.image.width}
        data-artwork-height={card.image.height}
        data-artwork-src={card.image.src}
        data-artwork-preview-src={previewSrc}
        data-artwork-alt={card.image.alt}
        data-artwork-recreate={card.recreateHref}
        hidden={!cardMatchesStyle(card, selectedStyle) || card.device !== selectedDevice}
      >
        <a
          href={card.href}
          class="wallpaper-trigger"
          data-wallpaper-trigger
          aria-label={`${card.title} · ${card.styleName} · 预览壁纸`}
        >
          <div class="wallpaper-visual">
            <img
              src={listImage.src ?? card.image.src}
              alt={card.image.alt}
              width={listImage.width}
              height={listImage.height}
              loading="lazy"
              decoding="async"
            />
            <span class="wallpaper-shade" aria-hidden="true"></span>
            <span class="wallpaper-style-badge">{card.styleName}</span>
            <span class="wallpaper-open">查看壁纸 ↗</span>
          </div>
        </a>
      </article>
    ))}
  </div>
) : null}

<div class="wallpaper-empty" data-wallpaper-empty hidden={hasVisible}>
  <p class="wallpaper-empty-title">暂无「<span data-empty-style-name>{selectedStyleName}</span>」风格的 {character.name} 作品</p>
  <a class="btn btn-outline wallpaper-empty-cta" href={emptyCreateHref} data-empty-create>生成第一张</a>
</div>

<div class="wallpaper-lightbox" data-wallpaper-lightbox role="dialog" aria-modal="true" aria-label="{character.name} 壁纸预览" hidden>
  <div class="lightbox-layout">
    <div class="lightbox-phone-preview" aria-hidden="true">
      <div class="phone-device">
        <div class="phone-screen">
          <img class="phone-wallpaper" data-lightbox-preview-image alt="" />
          <div class="phone-status-bar">
            <span>9:41</span>
            <span class="phone-status-icons"><Signal size={10} /><Wifi size={10} /><BatteryFull size={13} /></span>
          </div>
          <div class="phone-lock-content">
            <span class="phone-lock-date">星期二，八月二十</span>
            <strong>9:41</strong>
          </div>
          <div class="phone-lock-actions"><Flashlight size={15} /><Camera size={15} /></div>
          <img class="phone-home-overlay" src="/media/ui/iphone-home-screen.png" alt="" />
          <span class="phone-home-indicator"></span>
        </div>
      </div>
    </div>
    <div class="lightbox-stage" data-lightbox-stage tabindex="0" aria-label="壁纸原图，可上下滚动查看">
      <img class="lightbox-image" data-lightbox-image alt="" />
    </div>
    <aside class="lightbox-info">
      <div class="lightbox-panel-controls">
        <button class="lightbox-icon-btn lightbox-close" type="button" data-lightbox-close aria-label="关闭预览"><X size={20} strokeWidth={1.8} aria-hidden="true" /></button>
      </div>
      <div class="lightbox-meta">
        <h3 data-lightbox-title></h3>
        <p class="lightbox-sub"><span data-lightbox-style></span><span class="dot">·</span><span data-lightbox-device></span><span class="dot">·</span><span data-lightbox-size></span></p>
      </div>
      <div class="phone-preview-switch" role="group" aria-label="选择手机预览效果">
        <button type="button" class="is-active" data-preview-mode="lock" aria-pressed="true">锁屏效果</button>
        <button type="button" data-preview-mode="home" aria-pressed="false">主屏效果</button>
      </div>
      <div class="lightbox-actions">
        <a class="btn btn-primary lightbox-download" data-lightbox-download href="#" download><Download size={16} strokeWidth={1.9} aria-hidden="true" /> 下载原图</a>
        <a class="btn btn-secondary lightbox-recreate" data-lightbox-recreate href="/create/" target="_blank" rel="noopener noreferrer"><Sparkles size={16} strokeWidth={1.9} aria-hidden="true" /> AI 重绘</a>
      </div>
      <div class="lightbox-nav-group" aria-label="切换壁纸">
        <button class="lightbox-icon-btn lightbox-prev" type="button" data-lightbox-prev aria-label="上一张"><ChevronLeft size={18} strokeWidth={1.8} aria-hidden="true" /><span>上一张</span></button>
        <button class="lightbox-icon-btn lightbox-next" type="button" data-lightbox-next aria-label="下一张"><span>下一张</span><ChevronRight size={18} strokeWidth={1.8} aria-hidden="true" /></button>
      </div>
    </aside>
  </div>
</div>

<script>
  const grid = document.querySelector('[data-wallpaper-grid]');
  const lightbox = document.querySelector('[data-wallpaper-lightbox]');
  if (grid && lightbox) {
    const imgEl = lightbox.querySelector('[data-lightbox-image]') as HTMLImageElement | null;
    const previewImgEl = lightbox.querySelector('[data-lightbox-preview-image]') as HTMLImageElement | null;
    const titleEl = lightbox.querySelector('[data-lightbox-title]');
    const styleEl = lightbox.querySelector('[data-lightbox-style]');
    const deviceEl = lightbox.querySelector('[data-lightbox-device]');
    const sizeEl = lightbox.querySelector('[data-lightbox-size]');
    const downloadEl = lightbox.querySelector('[data-lightbox-download]') as HTMLAnchorElement | null;
    const recreateEl = lightbox.querySelector('[data-lightbox-recreate]') as HTMLAnchorElement | null;
    const closeEl = lightbox.querySelector('[data-lightbox-close]');
    const prevEl = lightbox.querySelector('[data-lightbox-prev]');
    const nextEl = lightbox.querySelector('[data-lightbox-next]');
    const stageEl = lightbox.querySelector('[data-lightbox-stage]') as HTMLElement | null;
    const previewModeButtons = Array.from(lightbox.querySelectorAll<HTMLButtonElement>('[data-preview-mode]'));

    let currentId: string | null = null;
    let lastFocused: HTMLElement | null = null;
    let prevOverflow = '';
    let closing = false;

    const visibleCards = (): HTMLElement[] =>
      Array.from(grid!.querySelectorAll<HTMLElement>('[data-wallpaper-card]:not([hidden])'));

    const deviceLabel = (d: string) => (d === 'mobile' ? 'Mobile 壁纸' : 'PC 壁纸');

    const setPreviewMode = (mode: 'lock' | 'home') => {
      lightbox!.dataset.previewMode = mode;
      previewModeButtons.forEach((button) => {
        const isActive = button.dataset.previewMode === mode;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });
    };

    const render = (card: HTMLElement) => {
      const ds = card.dataset;
      currentId = ds.artworkId ?? null;
      if (imgEl) {
        imgEl.src = ds.artworkSrc ?? '';
        imgEl.alt = ds.artworkAlt || ds.artworkTitle || '';
      }
      if (previewImgEl) previewImgEl.src = ds.artworkPreviewSrc || ds.artworkSrc || '';
      stageEl?.scrollTo({ top: 0 });
      lightbox!.dataset.device = ds.artworkDevice ?? 'pc';
      setPreviewMode('lock');
      if (titleEl) titleEl.textContent = ds.artworkTitle ?? '';
      if (styleEl) styleEl.textContent = ds.artworkStyle ?? '';
      if (deviceEl) deviceEl.textContent = deviceLabel(ds.artworkDevice ?? 'pc');
      if (sizeEl) sizeEl.textContent = `${ds.artworkWidth} × ${ds.artworkHeight}`;
      if (downloadEl) downloadEl.href = ds.artworkSrc ?? '';
      if (recreateEl) recreateEl.href = ds.artworkRecreate || '/create/';
    };

    const open = (card: HTMLElement, trigger: HTMLElement) => {
      lastFocused = trigger;
      prevOverflow = document.body.style.overflow;
      render(card);
      closing = false;
      lightbox!.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => lightbox!.classList.add('is-open'));
      closeEl?.focus();
      document.addEventListener('keydown', onKey);
    };

    const close = () => {
      if (closing) return;
      closing = true;
      lightbox!.classList.remove('is-open');
      document.body.style.overflow = prevOverflow;
      document.removeEventListener('keydown', onKey);
      const cleanup = () => {
        lightbox!.hidden = true;
        if (imgEl) imgEl.src = '';
        if (previewImgEl) previewImgEl.src = '';
        if (lastFocused && document.contains(lastFocused)) lastFocused.focus();
        currentId = null;
      };
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        cleanup();
      } else {
        lightbox!.addEventListener('transitionend', function done() {
          lightbox!.removeEventListener('transitionend', done);
          cleanup();
        });
        window.setTimeout(cleanup, 450);
      }
    };

    const nav = (dir: number) => {
      const cards = visibleCards();
      const idx = cards.findIndex((c) => c.dataset.artworkId === currentId);
      if (idx < 0 || cards.length === 0) return;
      const nextIdx = (idx + dir + cards.length) % cards.length;
      render(cards[nextIdx]);
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') nav(-1);
      else if (e.key === 'ArrowRight') nav(1);
    };

    grid!.querySelectorAll('[data-wallpaper-trigger]').forEach((node) => {
      const a = node as HTMLAnchorElement;
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        const card = a.closest<HTMLElement>('[data-wallpaper-card]');
        if (card) open(card, a);
      });
    });

    closeEl?.addEventListener('click', close);
    prevEl?.addEventListener('click', () => nav(-1));
    nextEl?.addEventListener('click', () => nav(1));
    previewModeButtons.forEach((button) => {
      button.addEventListener('click', () => setPreviewMode(button.dataset.previewMode === 'home' ? 'home' : 'lock'));
    });
    lightbox!.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === stageEl) close();
    });
  }
</script>

<style>
  .wallpaper-filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .filter-group { display: flex; min-width: 0; align-items: center; gap: 0.8rem; }
  .filter-group-device { margin-left: auto; }
  .filter-label { color: var(--text-muted); font-size: 0.76rem; white-space: nowrap; }
  .filter-options { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .filter-option {
    display: inline-flex; min-height: 34px; align-items: center; justify-content: center;
    padding-inline: 0.85rem; border: 1px solid transparent; border-radius: 6px;
    color: var(--text-secondary); cursor: pointer; font-size: 0.78rem; white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  }
  .filter-option:hover, .filter-option:focus-visible, .filter-option.is-active {
    color: var(--text-primary); border-color: var(--border-strong);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .wallpaper-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.8rem 1.35rem; margin-top: 1.5rem; }
  .wallpaper-grid[data-active-device="mobile"] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .wallpaper-card[hidden] { display: none; }
  .wallpaper-card { min-width: 0; }
  .wallpaper-trigger { display: block; color: inherit; cursor: pointer; }
  .wallpaper-visual {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    border: 1px solid var(--border); border-radius: var(--radius-md);
    background: var(--surface-muted); box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-base);
  }
  .wallpaper-card[data-device="mobile"] .wallpaper-visual { aspect-ratio: 9 / 16; }
  .wallpaper-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-slow); }
  .wallpaper-card:hover .wallpaper-visual, .wallpaper-card:focus-within .wallpaper-visual { border-color: var(--border-strong); box-shadow: var(--shadow-md); }
  .wallpaper-card:hover .wallpaper-visual img, .wallpaper-card:focus-within .wallpaper-visual img { transform: scale(1.035); }
  .wallpaper-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to top, rgba(5, 12, 20, .58), transparent 46%); }
  .wallpaper-style-badge {
    position: absolute; left: .7rem; bottom: .7rem; padding: .3rem .48rem;
    border: 1px solid rgba(255,255,255,.32); border-radius: 4px;
    color: #fff; background: rgba(5, 12, 20, .28); backdrop-filter: blur(8px); font-size: .66rem;
  }
  .wallpaper-open {
    position: absolute; top: .7rem; right: .7rem; padding: .3rem .48rem;
    border: 1px solid rgba(255,255,255,.32); border-radius: 4px;
    color: #fff; background: rgba(5, 12, 20, .32); font-size: .66rem;
    opacity: 0; transition: opacity var(--transition-fast);
  }
  .wallpaper-card:hover .wallpaper-open, .wallpaper-card:focus-within .wallpaper-open { opacity: 1; }

  .wallpaper-empty[hidden] { display: none; }
  .wallpaper-empty { display: flex; flex-direction: column; align-items: center; gap: 1rem; margin: 3rem 0; color: var(--text-secondary); text-align: center; }
  .wallpaper-empty-title { margin: 0; }
  .wallpaper-empty-cta { margin-top: .4rem; }

  .wallpaper-lightbox[hidden] { display: none; }
  .wallpaper-lightbox {
    position: fixed; inset: 0; z-index: 1000;
    background: rgba(6, 10, 18, 0.94);
    -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
    opacity: 0; transition: opacity 0.28s ease;
  }
  .wallpaper-lightbox.is-open { opacity: 1; }
  .lightbox-layout { display: grid; width: 100%; height: 100%; min-height: 0; }
  .lightbox-phone-preview { display: none; }

  .lightbox-stage {
    min-height: 0; display: grid; place-items: center;
    padding: clamp(4rem, 7vh, 5rem) clamp(4rem, 6vw, 6rem) clamp(1rem, 3vh, 2rem);
    overflow: hidden;
  }
  .lightbox-image {
    max-width: 100%; max-height: 100%;
    width: auto; height: auto;
    object-fit: contain; border-radius: var(--radius-md);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
  }

  .lightbox-icon-btn {
    display: grid; place-items: center;
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08); color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .lightbox-icon-btn:hover, .lightbox-icon-btn:focus-visible {
    background: rgba(255, 255, 255, 0.2); border-color: rgba(255, 255, 255, 0.4); outline: none;
  }
  .lightbox-panel-controls { display: flex; align-items: center; justify-content: flex-end; gap: .5rem; }
  .lightbox-nav-group { display: flex; gap: .5rem; }

  .lightbox-info {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1rem clamp(1.25rem, 4vw, 2.5rem);
    background: rgba(6, 10, 18, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .lightbox-meta { min-width: 0; display: flex; align-items: baseline; gap: .55rem; }
  .lightbox-meta h3 { margin: 0; font-size: 1.05rem; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lightbox-sub { margin: 0; color: rgba(255, 255, 255, 0.66); font-size: 0.76rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .lightbox-sub .dot { opacity: 0.5; }
  .lightbox-actions { display: flex; gap: 0.6rem; flex-shrink: 0; }
  .lightbox-actions .btn { display: inline-flex; align-items: center; gap: 0.4rem; }
  .phone-preview-switch { display: none; }
  .wallpaper-lightbox[data-device="pc"] .lightbox-layout { grid-template-rows: minmax(0, 1fr) auto; }
  .wallpaper-lightbox[data-device="pc"] .lightbox-stage { grid-row: 1; }
  .wallpaper-lightbox[data-device="pc"] .lightbox-info { grid-row: 2; }
  .wallpaper-lightbox[data-device="pc"] .lightbox-panel-controls { display: contents; }
  .wallpaper-lightbox[data-device="pc"] .lightbox-nav-group { display: contents; }
  .wallpaper-lightbox[data-device="pc"] .lightbox-nav-group span { display: none; }
  .wallpaper-lightbox[data-device="pc"] .lightbox-close,
  .wallpaper-lightbox[data-device="pc"] .lightbox-prev,
  .wallpaper-lightbox[data-device="pc"] .lightbox-next { position: absolute; z-index: 2; }
  .wallpaper-lightbox[data-device="pc"] .lightbox-close { top: 1rem; right: 1rem; }
  .wallpaper-lightbox[data-device="pc"] .lightbox-prev,
  .wallpaper-lightbox[data-device="pc"] .lightbox-next { top: 50%; width: 48px; height: 48px; transform: translateY(-50%); }
  .wallpaper-lightbox[data-device="pc"] .lightbox-prev { left: clamp(.5rem, 2vw, 1.5rem); }
  .wallpaper-lightbox[data-device="pc"] .lightbox-next { right: clamp(.5rem, 2vw, 1.5rem); }
  .wallpaper-lightbox[data-device="pc"] .lightbox-prev:hover,
  .wallpaper-lightbox[data-device="pc"] .lightbox-next:hover { transform: translateY(-50%) scale(1.06); }

  @media (min-width: 769px) {
  .wallpaper-lightbox[data-device="mobile"] .lightbox-layout {
    grid-template-columns: minmax(168px, .72fr) minmax(260px, 1.18fr) minmax(250px, 290px);
    gap: clamp(1rem, 2vw, 2rem); align-items: center;
    padding: clamp(1rem, 3vh, 2.25rem) clamp(1.25rem, 3.5vw, 4rem);
  }
  .wallpaper-lightbox[data-device="mobile"] .lightbox-phone-preview { display: grid; place-items: center; min-width: 0; }
  .phone-device { position: relative; width: min(100%, 280px); aspect-ratio: 322 / 662; container-type: inline-size; filter: drop-shadow(0 22px 34px rgba(0, 0, 0, .48)); }
  .phone-device::after {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: url('/media/ui/iphone-17-pro-frame.png') center / contain no-repeat;
  }
  .phone-screen { position: absolute; z-index: 3; inset: 1.15% 1.9%; overflow: hidden; border-radius: 16% / 7.8%; background: #111827; color: #fff; }
  .phone-wallpaper { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

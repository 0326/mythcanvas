---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/media/content/mythology-civilizations-banner.webp' } = Astro.props;

const matchesRoute = (pathname: string, route: string) =>
  pathname === route || pathname.startsWith(`${route}/`);

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const privateNoindexRoutes = ['/admin', '/my'];
const utilityNoindexRoutes = ['/login', '/register', '/password', '/search'];
const isPrivateNoindex = privateNoindexRoutes.some((route) => matchesRoute(pathname, route));
const isUtilityNoindex = utilityNoindexRoutes.some((route) => matchesRoute(pathname, route));
const isThinFilterPage = Astro.url.searchParams.size > 0 && (
  matchesRoute(pathname, '/character') ||
  matchesRoute(pathname, '/explore') ||
  matchesRoute(pathname, '/wallpaper')
);
const robots = isPrivateNoindex
  ? 'noindex,nofollow'
  : isUtilityNoindex || isThinFilterPage
    ? 'noindex,follow'
    : 'index,follow';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#fbf7ed" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#08131f" media="(prefers-color-scheme: dark)" />
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="generator" content={Astro.generator} />

<script is:inline>
  (() => {
    const storageKey = 'mythcanvas-theme';
    try {
      const stored = localStorage.getItem(storageKey);
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored === 'light' || stored === 'dark' ? stored : systemDark ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    } catch {
      document.documentElement.dataset.theme = 'light';
    }
  })();
</script>

<script is:inline>
  (() => {
    if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost')) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  })();
</script>

<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="application-name" content="MythCanvas" />
<meta name="apple-mobile-web-app-title" content="MythCanvas" />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:site_name" content="绘世神话 MythCanvas" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />

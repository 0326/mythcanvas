---
import type { Artwork, Style } from '../../lib/content/types';
import ArtworkCard from '../artwork/ArtworkCard.astro';

interface Props {
  artworks: readonly Artwork[];
  styles: readonly Style[];
}

const { artworks, styles } = Astro.props;
const styleById = new Map(styles.map((style) => [style.id, style]));
const uniqueStyleIds = [...new Set(artworks.map((artwork) => artwork.styleId))];
---

<section class="section-compact section-tint">
  <div class="container-wide">
    <div class="section-heading">
      <div><span class="eyebrow">Visual Interpretations</span><h2>同一个神域，不同演绎</h2><p>演绎只来自真实作品，绝不制造假图。</p></div>
    </div>
    {uniqueStyleIds.length > 0 ? (
      <>
        <ul class="style-chips" aria-label="视觉演绎画风">
          {uniqueStyleIds.map((styleId) => (
            <li>{styleById.get(styleId)?.name ?? styleId.replace('-', ' ')}</li>
          ))}
        </ul>
        <div class="artwork-grid">
          {artworks.map((artwork) => (
            <ArtworkCard artwork={artwork} key={artwork.id} />
          ))}
        </div>
      </>
    ) : (
      <div class="empty-state">
        <p>还没有这个神域不同画风的真实作品。</p>
        <a class="btn btn-secondary" href={`/create/`}>绘制一个版本</a>
      </div>
    )}
  </div>
</section>

<style>
  .style-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .style-chips li {
    padding: 0.34rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: 0.78rem;
  }

  .artwork-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .empty-state {
    padding: var(--space-10);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    text-align: center;
    color: var(--text-secondary);
  }

  .empty-state .btn {
    margin-top: var(--space-5);
  }

  @media (max-width: 820px) {
    .artwork-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
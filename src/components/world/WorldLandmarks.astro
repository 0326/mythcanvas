---
import { ArrowRight } from '@lucide/astro';
import type { Scene } from '../../lib/content/types';

interface Props {
  scenes: readonly Scene[];
}

const { scenes } = Astro.props;
---

<section class="section-compact section-tint" id="landmarks">
  <div class="container-wide">
    <div class="section-heading">
      <div><span class="eyebrow">Landmarks</span><h2>探索神域</h2><p>这个神域不是一张图，而是由多个可以进入的地点组成。</p></div>
    </div>
    <div class="landmark-feed">
      {scenes.map((scene, index) => (
        <a
          class:list={['landmark', { 'is-alt': index % 2 === 1 }]}
          href="/explore/"
          aria-label={`${scene.name} · ${scene.nameEn}`}
        >
          <div class="landmark-media">
            {scene.heroImage ? (
              <img
                src={scene.heroImage.src}
                alt={scene.heroImage.alt}
                width={scene.heroImage.width}
                height={scene.heroImage.height}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="landmark-fallback" aria-hidden="true"></div>
            )}
            <span class="landmark-count">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="landmark-copy">
            <span class="small-caps">Scene · {scene.nameEn}</span>
            <h3>{scene.name}</h3>
            <p>{scene.summary}</p>
            <span class="landmark-action">进入 <ArrowRight size={15} strokeWidth={1.8} aria-hidden="true" /></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .landmark-feed {
    display: grid;
    gap: var(--space-10);
  }

  .landmark {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    color: inherit;
  }

  .landmark.is-alt {
    grid-template-columns: 0.85fr 1.15fr;
  }

  .landmark.is-alt .landmark-media {
    order: 2;
  }

  .landmark.is-alt .landmark-copy {
    order: 1;
  }

  .landmark-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-muted);
    box-shadow: var(--shadow-sm);
  }

  .landmark-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .landmark:hover .landmark-media img,
  .landmark:focus-within .landmark-media img {
    transform: scale(1.03);
  }

  .landmark-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, var(--cloud-blue), var(--jade-soft));
  }

  .landmark-count {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    padding: 0.28rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: var(--radius-pill);
    color: white;
    background: rgba(7, 17, 27, 0.22);
    backdrop-filter: blur(10px);
    font-family: var(--font-serif);
    font-size: 0.78rem;
  }

  .landmark-copy .small-caps {
    color: var(--accent-strong);
  }

  .landmark-copy h3 {
    margin: var(--space-2) 0 0;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
  }

  .landmark-copy p {
    max-width: 34rem;
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .landmark-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-5);
    color: var(--text-secondary);
    font-weight: 700;
  }

  .landmark:hover .landmark-action,
  .landmark:focus-within .landmark-action {
    color: var(--accent-strong);
  }

  @media (max-width: 820px) {
    .landmark,
    .landmark.is-alt {
      grid-template-columns: 1fr;
    }

    .landmark.is-alt .landmark-media,
    .landmark.is-alt .landmark-copy {
      order: 0;
    }
  }
</style>
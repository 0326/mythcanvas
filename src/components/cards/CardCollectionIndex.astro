---
import { ArrowRight, Layers3, Sparkles } from '@lucide/astro';
import { formatCardNumber } from '../../lib/cards/catalog';
import { getApprovedCardCount } from '../../lib/cards/validation';
import { localizedPath } from '../../lib/i18n/url';
import type { CardSeries } from '../../lib/cards/types';

interface Props {
  series: readonly CardSeries[];
  locale?: 'zh-Hans' | 'en';
}

const { series, locale = 'zh-Hans' } = Astro.props;
const isEnglish = locale === 'en';
const firstSeries = series[0];
---

<section class="cards-hero" aria-labelledby="cards-page-title">
  <div class="cards-hero-glow" aria-hidden="true"></div>
  <div class="container-wide cards-hero-inner">
    <div class="cards-hero-copy">
      <span class="eyebrow"><Layers3 size={15} strokeWidth={1.8} aria-hidden="true" /> {isEnglish ? 'Mythic Cards · Collections' : 'Mythic Cards · 神话典藏'}</span>
      <h1 id="cards-page-title">
        {isEnglish ? 'Collect the stories behind the gods.' : <>收藏神话，<br />从一张卡开始。</>}
      </h1>
      <p>{isEnglish ? 'Explore curated card collections built from mythology, story, character, and world. Every card belongs to a larger universe.' : '从神话体系、故事、角色与神域出发，进入一套真正有叙事的神话收藏卡。每张卡，都属于一个更大的世界。'}</p>
      {firstSeries && (
        <a class="btn btn-primary" href={localizedPath(locale, `/cards/${firstSeries.mythologySlug}/${firstSeries.slug}/`)}>
          {isEnglish ? 'Enter the Norse collection' : '进入北欧创世系列'} <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
        </a>
      )}
    </div>

    {firstSeries && (
      <a class="deck-preview" href={localizedPath(locale, `/cards/${firstSeries.mythologySlug}/${firstSeries.slug}/`)} aria-label={isEnglish ? `Open ${firstSeries.nameEn}` : `打开${firstSeries.name}`}>
        <div class="deck-preview-back" aria-hidden="true"></div>
        {firstSeries.cards.filter((card) => card.hasArtwork).slice(0, 3).map((card, index) => (
          <div class="deck-preview-card" style={`--deck-index: ${index};`}>
            {card.imageUrl && <img src={card.imageUrl} alt="" width={card.output.width} height={card.output.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}
            <span>{formatCardNumber(card.cardNumber, firstSeries.cardCount)}</span>
          </div>
        ))}
        <div class="deck-preview-caption">
          <span>{firstSeries.name}</span>
          <small>{getApprovedCardCount(firstSeries.cards)} / {firstSeries.cardCount} {isEnglish ? 'artworks ready' : '张已出图'}</small>
        </div>
      </a>
    )}
  </div>
</section>

<section class="cards-collections section-compact" aria-labelledby="collection-list-title">
  <div class="container-wide">
    <div class="section-heading">
      <div>
        <span class="eyebrow"><Sparkles size={15} strokeWidth={1.8} aria-hidden="true" /> {isEnglish ? 'Collection Atlas' : '套卡图鉴'}</span>
        <h2 id="collection-list-title">{isEnglish ? 'Enter a mythic collection' : '进入一套神话世界'}</h2>
      </div>
      <p>{isEnglish ? 'Series are published as their content and visual direction become ready.' : '系列内容与视觉资产逐步完成后开放，先看见世界，再收藏卡片。'}</p>
    </div>

    <div class="series-grid">
      {series.map((item) => {
        const readyCount = getApprovedCardCount(item.cards);
        const href = localizedPath(locale, `/cards/${item.mythologySlug}/${item.slug}/`);
        return (
          <a class="series-tile surface" href={href} data-series-tile data-mythology={item.mythologySlug}>
            <div class="series-tile-art">
              {item.cards.filter((card) => card.hasArtwork).slice(0, 3).map((card, index) => (
                card.imageUrl && <img class:list={{ 'series-art-main': index === 0, 'series-art-side': index !== 0 }} src={card.imageUrl} alt="" width={card.output.width} height={card.output.height} loading="lazy" decoding="async" />
              ))}
              <span class="series-status">{item.status === 'in-progress' ? (isEnglish ? 'In progress' : '制作中') : (isEnglish ? 'Planned' : '规划中')}</span>
            </div>
            <div class="series-tile-copy">
              <div>
                <span class="series-kicker">{item.mythologySlug === 'norse' ? (isEnglish ? 'Norse Mythology' : '北欧神话') : item.mythologySlug}</span>
                <h3>{isEnglish ? item.nameEn : item.name}</h3>
                <p>{isEnglish ? item.summaryEn : item.summary}</p>
              </div>
              <div class="series-tile-footer">
                <span>{readyCount} / {item.cardCount} {isEnglish ? 'ready' : '已出图'}</span>
                <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .cards-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(120deg, var(--bg-primary), color-mix(in srgb, var(--bg-secondary) 88%, var(--bg-primary)) 64%, var(--bg-primary));
    isolation: isolate;
  }

  .cards-hero-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(circle at 76% 44%, color-mix(in srgb, #91c5d5 20%, transparent), transparent 28%), radial-gradient(circle at 16% 18%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 28%);
  }

  .cards-hero-inner {
    display: grid;
    min-height: min(710px, 75svh);
    grid-template-columns: minmax(0, 1fr) minmax(330px, .78fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 9rem);
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .cards-hero-copy { max-width: 650px; }
  .cards-hero-copy .eyebrow { display: inline-flex; }
  .cards-hero-copy h1 { margin: 0; font-size: clamp(3.1rem, 7vw, 6.8rem); line-height: .96; letter-spacing: -.06em; text-wrap: balance; }
  .cards-hero-copy p { max-width: 39rem; margin: var(--space-6) 0 0; color: var(--text-secondary); font-family: var(--font-literary); font-size: clamp(1rem, 1.35vw, 1.16rem); line-height: 1.85; }
  .cards-hero-copy .btn { margin-top: var(--space-8); }

  .deck-preview {
    position: relative;
    display: block;
    min-height: 440px;
    isolation: isolate;
  }

  .deck-preview::before {
    position: absolute;
    inset: 10% -12% 5% 4%;
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 50%;
    content: '';
    transform: rotate(-16deg);
    opacity: .8;
  }

  .deck-preview-back {
    position: absolute;
    inset: 9% 12% 3% 9%;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 16px;
    background: linear-gradient(145deg, #07131d, #18303a 52%, #6e542e);
    box-shadow: 0 35px 70px rgba(0, 0, 0, .28);
    transform: rotate(9deg);
  }

  .deck-preview-card {
    position: absolute;
    top: calc(var(--deck-index) * 2.2%);
    right: calc(22% + var(--deck-index) * 4%);
    bottom: calc(8% - var(--deck-index) * 1%);
    left: calc(11% + var(--deck-index) * 6%);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 64%, #fff);
    border-radius: 15px;
    background: #0b151e;
    box-shadow: 0 26px 50px rgba(0, 0, 0, .32);
    transform: rotate(calc((var(--deck-index) - 1) * 7deg));
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .deck-preview-card img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.85) contrast(1.06); }
  .deck-preview-card::after { position: absolute; inset: 0; content: ''; background: linear-gradient(to top, rgba(4, 9, 12, .7), transparent 45%); }
  .deck-preview-card span { position: absolute; right: 8%; bottom: 5%; z-index: 1; color: #fff; font-size: .68rem; letter-spacing: .1em; }
  .deck-preview:hover .deck-preview-card { box-shadow: 0 34px 68px rgba(0, 0, 0, .38); }
  .deck-preview:hover .deck-preview-card:nth-child(3) { transform: rotate(-9deg) translate(-5px, -10px); }
  .deck-preview:hover .deck-preview-card:nth-child(4) { transform: rotate(9deg) translate(5px, -16px); }

  .deck-preview-caption { position: absolute; right: 3%; bottom: 0; left: 12%; display: flex; align-items: end; justify-content: space-between; gap: 1rem; color: var(--text-primary); }
  .deck-preview-caption span { font-family: var(--font-display); font-size: 1.05rem; }
  .deck-preview-caption small { color: var(--text-muted); font-size: .7rem; }

  .series-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .series-tile { display: grid; grid-template-columns: minmax(190px, .82fr) minmax(0, 1.18fr); min-height: 300px; overflow: hidden; border-radius: var(--radius-lg); transition: transform var(--transition-base), border-color var(--transition-fast), box-shadow var(--transition-base); }
  .series-tile:hover { border-color: var(--border-strong); box-shadow: var(--shadow-md); transform: translateY(-4px); }
  .series-tile-art { position: relative; overflow: hidden; min-height: 300px; background: #0a141b; }
  .series-tile-art::after { position: absolute; inset: 0; content: ''; background: linear-gradient(110deg, transparent 20%, rgba(194, 161, 91, .2), transparent 70%); mix-blend-mode: screen; }
  .series-art-main { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .series-art-side { position: absolute; right: -8%; bottom: -10%; width: 48%; height: 68%; border: 1px solid rgba(255, 255, 255, .25); border-radius: 9px; object-fit: cover; box-shadow: -12px 14px 28px rgba(0, 0, 0, .32); transform: rotate(10deg); }
  .series-status { position: absolute; top: 1rem; left: 1rem; z-index: 1; padding: .32rem .52rem; border: 1px solid rgba(255,255,255,.32); border-radius: 999px; color: #fff; background: rgba(4, 11, 16, .45); backdrop-filter: blur(8px); font-size: .66rem; font-weight: 720; }
  .series-tile-copy { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-6); padding: clamp(1.2rem, 2vw, 2rem); }
  .series-kicker { color: var(--accent-strong); font-size: .68rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .series-tile h3 { margin: .7rem 0 0; font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.85rem); line-height: 1.1; }
  .series-tile p { margin: .8rem 0 0; color: var(--text-secondary); font-size: .84rem; line-height: 1.75; }
  .series-tile-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: var(--space-4); border-top: 1px solid var(--border); color: var(--text-muted); font-size: .72rem; }
  .series-tile-footer svg { color: var(--accent-strong); transition: transform var(--transition-fast); }
  .series-tile:hover .series-tile-footer svg { transform: translateX(3px); }

  @media (max-width: 900px) {
    .cards-hero-inner { grid-template-columns: 1fr; min-height: auto; gap: var(--space-8); }
    .deck-preview { width: min(470px, 100%); min-height: 390px; margin-inline: auto; }
    .series-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .cards-hero-copy h1 { font-size: clamp(2.75rem, 15vw, 4.5rem); }
    .deck-preview { min-height: 330px; }
    .series-tile { grid-template-columns: 1fr; }
    .series-tile-art { min-height: 240px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-preview-card, .series-tile, .series-tile-footer svg { transition: none; }
  }
</style>

---
import { norseM01CardBack } from '../../lib/cards/assets';
import type { CardType, MythicCard } from '../../lib/cards/types';

interface Props {
  card: MythicCard;
  locale?: 'zh-Hans' | 'en';
  hrefBase?: string;
  interactive?: boolean;
}

const { card, locale = 'zh-Hans', hrefBase = '/cards/norse/m01-norse-genesis/', interactive = true } = Astro.props;
const isEnglish = locale === 'en';
const title = isEnglish ? card.titleEn : card.titleZh;
const description = card.display.short;
const identity = card.display.identity;
const isLandscape = card.orientation === 'landscape';
const isCardComplete = Boolean(card.imageUrl && card.generation?.status === 'approved');
const statusLabel = isCardComplete
  ? (isEnglish ? 'Artwork ready' : '已出图')
  : (isEnglish ? 'In production' : '制作中');
const detailHref = `${hrefBase}${card.cardId}/`;
const cardLabel = isEnglish
  ? `${title}, ${statusLabel}`
  : `${title}，${statusLabel}`;
const foilByType: Record<CardType, string> = {
  character: 'gold',
  scene: 'aurora',
  story: 'prism',
  'mythic-object': 'metal',
  ensemble: 'cosmos',
};
const foil = foilByType[card.type];
---

<article
  class:list={['mythic-card', `card-type-${card.type}`, { 'is-planned': !isCardComplete, 'is-landscape': isLandscape }]}
  data-card-tilt
  data-card-status={isCardComplete ? 'ready' : 'planned'}
  data-card-effect={foil}
  data-card-id={card.cardId}
>
  <a class="card-stage" href={interactive ? detailHref : undefined} aria-label={cardLabel}>
    <div class="card-tilt-layer">
      <div class="card-face">
        <div class="card-art" aria-hidden="true">
          {isCardComplete && card.imageUrl ? (
            <img
              src={card.imageUrl}
              alt=""
              width={card.output.width}
              height={card.output.height}
              loading="lazy"
              decoding="async"
            />
          ) : <img class="card-back-image" src={norseM01CardBack.src} alt="" width={norseM01CardBack.width} height={norseM01CardBack.height} loading="lazy" decoding="async" />}
        </div>

        {isCardComplete && <div class="card-atmosphere" aria-hidden="true"></div>}
        <div class="card-holo" aria-hidden="true"></div>
        <div class="card-glare" aria-hidden="true"></div>

        {isCardComplete && (
          <div class="card-content">
            <div class="card-info">
              <div class="card-info-heading">
                <h3 class="card-identity">{title}</h3>
                <p class="card-subtitle">{identity}</p>
              </div>
              <p class="card-description" data-card-description>{description}</p>
            </div>
            <div class="card-footer-line">
              <span class="card-id">{card.cardId}</span>
              <span class="card-brand">@mythcanvas</span>
            </div>
          </div>
        )}
      </div>
    </div>
  </a>
</article>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const fitCardDescriptions = () => {
    document.querySelectorAll<HTMLElement>('[data-card-description]').forEach((description) => {
      const isLandscape = description.closest('.mythic-card')?.classList.contains('is-landscape') ?? false;
      const maxSize = isLandscape ? 1.8 : 3.1;
      const minSize = isLandscape ? 1.05 : 1.6;
      let low = minSize;
      let high = maxSize;

      description.classList.add('is-measuring');

      const fitsInTwoLines = (size: number) => {
        description.style.setProperty('--card-description-size', `${size}cqi`);
        const lineHeight = Number.parseFloat(getComputedStyle(description).lineHeight);
        return description.scrollHeight <= lineHeight * 2 + 1;
      };

      if (!fitsInTwoLines(maxSize)) {
        for (let index = 0; index < 8; index += 1) {
          const candidate = (low + high) / 2;
          if (fitsInTwoLines(candidate)) low = candidate;
          else high = candidate;
        }
        description.style.setProperty('--card-description-size', `${low.toFixed(3)}cqi`);
      }

      description.classList.remove('is-measuring');
    });
  };

  if (document.fonts) {
    void document.fonts.ready.then(fitCardDescriptions);
  } else {
    requestAnimationFrame(fitCardDescriptions);
  }

  document.querySelectorAll<HTMLElement>('[data-card-tilt]').forEach((card) => {
    const stage = card.querySelector<HTMLElement>('.card-stage');
    if (!stage) return;

    const reset = () => {
      card.style.setProperty('--card-rotate-x', '0deg');
      card.style.setProperty('--card-rotate-y', '0deg');
      card.style.setProperty('--card-pointer-x', '50%');
      card.style.setProperty('--card-pointer-y', '50%');
      card.classList.remove('is-hovered');
    };

    const move = (event: PointerEvent) => {
      if (reduceMotion.matches || event.pointerType !== 'mouse') return;
      const rect = stage.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;
      const rotateY = (x - 50) * 0.07;
      const rotateX = (50 - y) * 0.055;
      card.style.setProperty('--card-rotate-x', `${rotateX.toFixed(2)}deg`);
      card.style.setProperty('--card-rotate-y', `${rotateY.toFixed(2)}deg`);
      card.style.setProperty('--card-pointer-x', `${x.toFixed(2)}%`);
      card.style.setProperty('--card-pointer-y', `${y.toFixed(2)}%`);
      card.classList.add('is-hovered');
    };

    stage.addEventListener('pointermove', move);
    stage.addEventListener('pointerleave', reset);
    stage.addEventListener('focusout', (event) => {
      if (!stage.contains(event.relatedTarget as Node | null)) reset();
    });
    stage.addEventListener('focusin', () => card.classList.add('is-focused'));
    stage.addEventListener('focusout', () => card.classList.remove('is-focused'));
  });
</script>

<style>
  .mythic-card {
    --card-rotate-x: 0deg;
    --card-rotate-y: 0deg;
    --card-pointer-x: 50%;
    --card-pointer-y: 50%;
    --card-ink: #071019;
    --card-snow: #f3ead4;
    --card-ice: #91c5d5;
    --card-ember: #c77f47;
    --card-accent: #d8bd78;
    --card-accent-soft: #f0dc9b;
    --card-frame: color-mix(in srgb, var(--card-accent-soft) 74%, var(--card-ink));
    --card-foil: linear-gradient(115deg, transparent 18%, rgba(255, 231, 151, .22) 40%, rgba(255, 255, 255, .1) 50%, transparent 75%);
    min-width: 0;
  }

  .mythic-card[data-card-effect='aurora'] {
    --card-accent: #93d9e1;
    --card-accent-soft: #d1f1ee;
    --card-foil: linear-gradient(115deg, transparent 18%, rgba(98, 229, 219, .2) 35%, rgba(163, 137, 255, .22) 50%, rgba(255, 230, 148, .18) 66%, transparent 82%);
  }

  .mythic-card[data-card-effect='prism'] {
    --card-accent: #c6a7ef;
    --card-accent-soft: #eee1ff;
    --card-foil: linear-gradient(115deg, transparent 15%, rgba(94, 217, 255, .16) 30%, rgba(246, 167, 255, .25) 45%, rgba(255, 229, 157, .2) 58%, rgba(116, 228, 205, .16) 72%, transparent 88%);
  }

  .mythic-card[data-card-effect='metal'] {
    --card-accent: #abbcc0;
    --card-accent-soft: #e4eeee;
    --card-foil: repeating-linear-gradient(105deg, transparent 0 12%, rgba(236, 248, 247, .1) 13% 15%, transparent 16% 27%);
  }

  .mythic-card[data-card-effect='cosmos'] {
    --card-accent: #9fbae8;
    --card-accent-soft: #e1e5ff;
    --card-foil: radial-gradient(circle at 22% 28%, rgba(255, 255, 255, .34) 0 1px, transparent 2px), radial-gradient(circle at 78% 64%, rgba(231, 207, 255, .28) 0 1px, transparent 2px), linear-gradient(115deg, transparent 20%, rgba(102, 170, 255, .18) 45%, rgba(205, 144, 255, .2) 58%, transparent 82%);
  }

  .mythic-card.is-planned {
    --card-accent: #a8ced8;
    --card-accent-soft: #e7edf0;
    --card-foil: linear-gradient(115deg, transparent 18%, rgba(168, 220, 232, .18) 42%, rgba(255, 255, 255, .24) 52%, transparent 78%);
  }

  .card-stage {
    display: block;
    perspective: 1100px;
    color: inherit;
  }

  .card-tilt-layer {
    position: relative;
    overflow: hidden;
    aspect-ratio: 5 / 7;
    container-type: inline-size;
    box-sizing: border-box;
    border-radius: 4.67% / 3.34%;
    background: linear-gradient(145deg, #30414a, #0c151d 34%, #080d13 100%);
    box-shadow: 0 22px 46px color-mix(in srgb, var(--card-ink) 44%, transparent);
    transform: rotateX(var(--card-rotate-x)) rotateY(var(--card-rotate-y));
    transform-style: preserve-3d;
    transition: transform 420ms cubic-bezier(.2,.7,.2,1);
    will-change: transform;
  }

  .card-tilt-layer::before,
  .card-tilt-layer::after {
    position: absolute;
    z-index: 12;
    box-sizing: border-box;
    content: '';
    pointer-events: none;
  }

  .mythic-card.is-planned .card-tilt-layer::before,
  .mythic-card.is-planned .card-tilt-layer::after {
    opacity: 0;
  }

  .card-tilt-layer::before {
    inset: 2.4cqi;
    border: .34cqi solid var(--card-frame);
    border-radius: calc(4.67cqi - 2.4cqi);
  }

  .card-tilt-layer::after {
    inset: 0;
    border: 1.25cqi solid var(--card-frame);
    border-radius: 4.67cqi;
  }

  .card-face {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
    box-sizing: border-box;
    border-radius: 4.67cqi;
    background: var(--card-ink);
    isolation: isolate;
  }

  .card-face::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: '';
    pointer-events: none;
    opacity: .14;
    background: repeating-linear-gradient(115deg, transparent 0 12px, rgba(255,255,255,.045) 13px, transparent 14px 28px);
    mix-blend-mode: screen;
  }

  .mythic-card.is-planned .card-face::before {
    opacity: 0;
  }

  .card-art {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    background: #0b151e;
  }

  .card-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: saturate(.88) contrast(1.06);
  }

  /* Cover cards keep the same vertical physical card template. Their
   * landscape source artwork stays horizontal and fully visible inside it. */
  .mythic-card.is-landscape .card-art img:not(.card-back-image) {
    object-fit: contain;
    object-position: top center;
    background: #0b151e;
  }

  .card-art img.card-back-image {
    object-fit: cover;
    object-position: center;
    filter: none;
  }

  .card-atmosphere {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(3, 11, 17, .42) 0%, rgba(3, 8, 12, .08) 38%, rgba(3, 7, 11, .84) 100%);
  }

  .card-holo,
  .card-glare,
  .card-content {
    position: absolute;
    inset: 0;
  }

  .card-holo {
    z-index: 3;
    opacity: 0;
    background: var(--card-foil);
    background-position: var(--card-pointer-x) var(--card-pointer-y);
    background-size: 230% 230%;
    mix-blend-mode: screen;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .mythic-card:hover .card-holo,
  .mythic-card.is-hovered .card-holo,
  .mythic-card.is-focused .card-holo {
    opacity: .76;
  }

  .card-glare {
    z-index: 6;
    opacity: 0;
    background: radial-gradient(circle at var(--card-pointer-x) var(--card-pointer-y), rgba(255, 255, 255, .55), transparent 19%);
    mix-blend-mode: soft-light;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .mythic-card:hover .card-glare,
  .mythic-card.is-hovered .card-glare,
  .mythic-card.is-focused .card-glare {
    opacity: .8;
  }

  .card-content {
    z-index: 8;
    padding: 0;
    color: var(--card-snow);
    pointer-events: none;
  }

  /*
   * The card face is a fixed collectible-card template. The cqi values below
   * scale the complete template with the card, but never let its content
   * determine the position or height of another slot.
   */
  .card-info {
    position: absolute;
    right: 4.8%;
    bottom: 6.5%;
    left: 4.8%;
    height: 21.5%;
    box-sizing: border-box;
    overflow: hidden;
    border: .34cqi solid var(--card-frame);
    border-radius: 2.67cqi;
    background: linear-gradient(145deg, rgba(7, 22, 29, .5), rgba(5, 12, 17, .5));
    box-shadow: 0 4cqi 8cqi rgba(0,0,0,.2);
    /* backdrop-filter: blur(4.67cqi) saturate(115%); */
  }

  .card-info-heading {
    position: absolute;
    top: 11.4%;
    right: 4.2%;
    left: 4.2%;
    height: 33%;
    min-width: 0;
    text-align: center;
  }

  .card-identity,
  .card-subtitle,
  .card-description {
    margin: 0;
  }

  .card-identity {
    display: block;
    overflow: hidden;
    color: var(--card-accent-soft);
    font-family: var(--font-display);
    font-size: 5.2cqi;
    font-weight: 740;
    line-height: 1.12;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-subtitle {
    display: block;
    overflow: hidden;
    margin-top: .7cqi;
    color: color-mix(in srgb, var(--card-snow) 62%, transparent);
    font-size: 3.1cqi;
    letter-spacing: .04em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .card-description {
    position: absolute;
    right: 4.2%;
    bottom: 9%;
    left: 4.2%;
    height: 2.8em;
    display: -webkit-box;
    overflow: hidden;
    color: color-mix(in srgb, var(--card-snow) 78%, transparent);
    font-size: var(--card-description-size, 3.1cqi);
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-description.is-measuring {
    display: block;
    height: auto;
    overflow: visible;
    -webkit-line-clamp: unset;
  }

  .card-footer-line {
    position: absolute;
    right: 8.6%;
    bottom: 2.5%;
    left: 8.6%;
    height: 3.1%;
    display: flex;
    align-items: center;
    gap: 2.13cqi;
    color: color-mix(in srgb, var(--card-snow) 68%, var(--card-accent));
    font-size: 2.67cqi;
    font-weight: 760;
    letter-spacing: .08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .card-id,
  .card-brand {
    color: color-mix(in srgb, var(--card-snow) 74%, var(--card-accent));
    font-size: 2.3cqi;
    letter-spacing: .05em;
  }

  .card-brand {
    margin-inline-start: auto;
    color: color-mix(in srgb, var(--card-snow) 58%, transparent);
    text-transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-tilt-layer,
    .card-holo,
    .card-glare { transition: none; }
    .mythic-card:hover .card-tilt-layer,
    .mythic-card.is-focused .card-tilt-layer { transform: none; }
  }
</style>

---
import { ArrowUpRight } from '@lucide/astro';
import type { Artwork } from '../../lib/content/types';
import {
  cloudflareImageSrcSet,
  cloudflareImageUrl,
  shouldUseCloudflareImageTransformations,
} from '../../lib/media/cloudflare-images';

interface Props {
  artwork: Artwork;
  mythologyName?: string;
  worldName?: string;
}

const { artwork, mythologyName, worldName } = Astro.props;
const useImageTransformations = shouldUseCloudflareImageTransformations(Astro.url, Astro.site);
const imageOptions = { quality: 78, format: 'auto' as const };
const imageSrc = cloudflareImageUrl(
  artwork.image.src,
  { ...imageOptions, width: 720 },
  useImageTransformations,
) ?? artwork.image.src;
const imageSrcSet = cloudflareImageSrcSet(
  artwork.image.src,
  [320, 480, 720],
  imageOptions,
  useImageTransformations,
);
---

<article
  class="artwork-card"
  data-artwork-card
  data-mythology={artwork.mythologyId}
  data-type={artwork.type}
  data-style={artwork.styleId}
>
  <a href={`/wallpaper/${artwork.slug}/`}>
    <div class="image-wrap">
      <img
        src={imageSrc}
        srcset={imageSrcSet}
        sizes="(max-width: 680px) 50vw, (max-width: 900px) 33vw, 25vw"
        alt={artwork.image.alt}
        width={artwork.image.width}
        height={artwork.image.height}
        loading="lazy"
        decoding="async"
      />
      <div class="image-sheen"></div>
      <span class="style-chip">{artwork.styleId.replace('-', ' ')}</span>
    </div>
    <div class="copy">
      <div>
        <h3>{artwork.title}</h3>
        <p>{worldName ?? mythologyName}</p>
      </div>
      <span class="arrow" aria-hidden="true"><ArrowUpRight size={17} strokeWidth={1.8} /></span>
    </div>
  </a>
</article>

<style>
  .artwork-card {
    min-width: 0;
  }

  a {
    display: block;
    color: inherit;
  }

  .image-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-muted);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), border-color var(--transition-fast), box-shadow var(--transition-base);
  }

  .artwork-card:hover .image-wrap {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .artwork-card:hover img {
    transform: scale(1.035);
  }

  .image-sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(5, 12, 20, 0.34), transparent 38%);
  }

  .style-chip {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    padding: 0.32rem 0.56rem;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: var(--radius-pill);
    color: #fff;
    background: rgba(7, 17, 27, 0.24);
    backdrop-filter: blur(10px);
    font-size: 0.68rem;
    text-transform: capitalize;
  }

  .copy {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-1) 0;
  }

  h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    font-weight: 720;
  }

  p {
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .arrow {
    display: grid;
    place-items: center;
    color: var(--text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .artwork-card:hover .arrow {
    color: var(--accent-strong);
    transform: translate(2px, -2px);
  }
</style>

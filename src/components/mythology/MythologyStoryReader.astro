---
import { ArrowRight, BookOpenText, Landmark, UserRound } from '@lucide/astro';
import type { Character, MythStoryKind, Mythology, World } from '../../lib/content/types';
import type { MythStoryVolume } from '../../lib/content/stories';
import { getStoryIllustrationById } from '../../data/story-illustrations';

interface Props {
  mythology: Mythology;
  volumes: MythStoryVolume[];
  characters: Character[];
  worlds: World[];
  storyDetailRoutes?: boolean;
}

const { mythology, volumes, characters, worlds, storyDetailRoutes = false } = Astro.props;
const storyHref = (slug: string) => storyDetailRoutes ? `/mythology/${mythology.slug}/${slug}/` : `#story-${slug}`;
const charactersById = new Map(characters.map((item) => [item.id, item]));
const worldsById = new Map(worlds.map((item) => [item.id, item]));
const volumeNumerals = ['壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌'];
const storyKindLabels: Record<MythStoryKind, string> = {
  myth: '神话传统',
  'folk-legend': '民间传说',
  'religious-tradition': '宗教传统',
  'literary-fantasy': '文学幻想',
};

const sourceTypeLabels = {
  'primary-text': '原始文本',
  translation: '译本',
  'scholarly-reference': '学术参考',
  'oral-tradition': '口传传统',
} as const;
---

<section class="mythology-reader" aria-labelledby="story-reader-title">
  <div class="container-wide reader-grid">
    <aside class="reader-nav" aria-label={`${mythology.name}故事卷目`}>
      <details class="reader-nav-disclosure">
        <summary>
          <span>故事目录</span>
          <span aria-hidden="true">展开</span>
        </summary>
        <div class="reader-nav-inner">
          <span class="eyebrow">Story Index</span>
          <h2>神话长卷</h2>
          <p>按主题成卷，不强造一条不存在的统一时间线。</p>

          <nav class="volume-list">
            {volumes.map((volume, volumeIndex) => (
              <div class="volume-nav-group">
                <a class="volume-nav-title" href={`#volume-${volume.id}`}>
                  <span>{volumeNumerals[volumeIndex] ?? String(volumeIndex + 1).padStart(2, '0')}</span>
                  <strong>{volume.title}</strong>
                </a>
                <div class="story-nav-list">
                  {volume.stories.map((story) => (
                    <a href={storyHref(story.slug)}>{story.title}</a>
                  ))}
                </div>
              </div>
            ))}
          </nav>
        </div>
      </details>
    </aside>

    <div class="reader-content">
      <header class="reader-intro">
        <span class="eyebrow">Illustrated Mythology</span>
        <h2 id="story-reader-title">从故事进入 {mythology.name}</h2>
        <p class="literary-copy">
          {storyDetailRoutes
            ? '故事已按卷目拆分为独立阅读页面。先选择一篇进入，再沿着上一篇、下一篇和相关神灵、神域继续探索。'
            : '神话不是一组人物卡片，也不是一条被整理得过分整齐的年表。这里以传说、典籍与后世流变为线索，用图像辅助叙事，再从故事自然进入相关神灵与神域。'}
        </p>
      </header>

      {volumes.map((volume, volumeIndex) => (
        <section class:list={['story-volume', { 'story-volume--index': storyDetailRoutes, 'story-volume--reader': !storyDetailRoutes }]} id={`volume-${volume.id}`} aria-labelledby={`volume-title-${volume.id}`}>
          <header class="volume-heading">
            <span class="volume-number">卷{volumeNumerals[volumeIndex] ?? volumeIndex + 1}</span>
            <h2 id={`volume-title-${volume.id}`}>{volume.title}</h2>
            <div class="volume-rule" aria-hidden="true"></div>
          </header>

          <details class="volume-disclosure" open={!storyDetailRoutes || volumeIndex === 0}>
            <summary class="volume-toggle">
              <span>本卷故事 · {volume.stories.length} 篇</span>
              <span aria-hidden="true"></span>
            </summary>
            <div class:list={['volume-stories', { 'volume-stories--index': storyDetailRoutes }]}>
            {volume.stories.map((story, storyIndex) => {
              const relatedCharacters = story.characterIds
                .map((id) => charactersById.get(id))
                .filter((item): item is Character => Boolean(item));
              const relatedWorlds = story.worldIds
                .map((id) => worldsById.get(id))
                .filter((item): item is World => Boolean(item));
              const storyIllustration = story.heroAssetId ? getStoryIllustrationById(story.heroAssetId) : undefined;

              return (
                <article class:list={['story-entry', { 'story-entry--index': storyDetailRoutes }]} id={`story-${story.slug}`}>
                  <header class="story-header">
                    <div class="story-order" aria-hidden="true">{String(storyIndex + 1).padStart(2, '0')}</div>
                    <div>
                      <div class="story-classification">
                        <span class="story-kind">{storyKindLabels[story.kind]}</span>
                        <span class="story-tradition">{story.tradition ?? '神话与传说传统'}</span>
                      </div>
                      <h3>{storyDetailRoutes ? <a href={storyHref(story.slug)}>{story.title}</a> : story.title}</h3>
                      {story.titleEn && <p class="story-title-en">{story.titleEn}</p>}
                      {story.subtitle && <p class="story-subtitle literary-copy">{story.subtitle}</p>}
                      <p class="story-summary literary-copy">{story.summary}</p>
                      <div class="story-meta">
                        <span><BookOpenText size={16} strokeWidth={1.8} aria-hidden="true" />约 {story.readingMinutes ?? 4} 分钟</span>
                        <span>{story.sources.length} 条参考来源</span>
                      </div>
                    </div>
                  </header>

                  {storyDetailRoutes ? (
                    <div class="story-preview">
                      {storyIllustration && (
                        <figure class="story-preview-figure">
                          <img
                            src={storyIllustration.image.src}
                            alt={storyIllustration.image.alt}
                            width={storyIllustration.image.width}
                            height={storyIllustration.image.height}
                            loading="lazy"
                          />
                        </figure>
                      )}
                      <div class="story-preview-footer">
                        <span>独立故事页 · 约 {story.readingMinutes ?? 4} 分钟</span>
                        <a class="story-read-link" href={storyHref(story.slug)}>
                          <span>阅读全文</span>
                          <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
                        </a>
                      </div>
                    </div>
                  ) : (
                    <>
                  <div class="story-body">
                    {story.blocks.map((block) => {
                      if (block.type === 'paragraph') {
                        return <p class="story-paragraph literary-copy">{block.text}</p>;
                      }

                      if (block.type === 'heading') {
                        return block.level === 2
                          ? <h4 id={block.id} class="story-section-heading">{block.text}</h4>
                          : <h5 id={block.id} class="story-subsection-heading">{block.text}</h5>;
                      }

                      if (block.type === 'quote') {
                        return (
                          <blockquote class="story-quote">
                            <p>{block.text}</p>
                            {block.source && <cite>{block.source}</cite>}
                          </blockquote>
                        );
                      }

                      const asset = getStoryIllustrationById(block.assetId);
                      if (!asset) return null;

                      return (
                        <figure class:list={['story-figure', `story-figure--${block.layout ?? 'wide'}`]}>
                          <img
                            src={asset.image.src}
                            alt={asset.image.alt}
                            width={asset.image.width}
                            height={asset.image.height}
                            loading="lazy"
                          />
                          {block.caption && <figcaption>{block.caption}</figcaption>}
                        </figure>
                      );
                    })}
                  </div>

                  {(relatedCharacters.length > 0 || relatedWorlds.length > 0) && (
                    <div class="story-relations" aria-label={`${story.title}相关神灵和神域`}>
                      <div class="story-relations-copy">
                        <span class="small-caps">继续进入故事中的世界</span>
                        <p>故事负责讲述，神灵与神域负责继续展开人物和空间。</p>
                      </div>
                      <div class="relation-links">
                        {relatedCharacters.map((character) => (
                          <a href={`/character/${character.slug}/`} class="relation-link">
                            <UserRound size={18} strokeWidth={1.7} aria-hidden="true" />
                            <span><small>神灵</small><strong>{character.name}</strong></span>
                            <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
                          </a>
                        ))}
                        {relatedWorlds.map((world) => (
                          <a href={`/world/${world.slug}/`} class="relation-link">
                            <Landmark size={18} strokeWidth={1.7} aria-hidden="true" />
                            <span><small>神域</small><strong>{world.name}</strong></span>
                            <ArrowRight size={17} strokeWidth={1.8} aria-hidden="true" />
                          </a>
                        ))}
                      </div>
                    </div>
                  )}

                  <details class="source-notes">
                    <summary>来源与版本说明</summary>
                    <div>
                      <ol class="story-source-list">
                        {story.sources.map((source) => (
                          <li>
                            <strong>{source.title}</strong>
                            <span>{sourceTypeLabels[source.sourceType]}</span>
                            {[source.tradition, source.period].filter(Boolean).join(' · ') && <small>{[source.tradition, source.period].filter(Boolean).join(' · ')}</small>}
                            {source.note && <p>{source.note}</p>}
                            {source.url && <a href={source.url} rel="noreferrer">查看来源</a>}
                          </li>
                        ))}
                      </ol>
                      {story.sourceNotes.map((note) => <p>{note}</p>)}
                    </div>
                  </details>
                    </>
                  )}
                </article>
              );
            })}
            </div>
          </details>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .mythology-reader {
    padding: clamp(5rem, 8vw, 8rem) 0 9rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--bg-primary) 92%, transparent), var(--bg-primary) 9rem),
      var(--page-glow);
  }

  .reader-grid {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: clamp(4.5rem, 7vw, 7.5rem);
    align-items: start;
  }

  .reader-nav {
    position: relative;
    min-width: 0;
  }

  .reader-nav-disclosure {
    margin: 0;
  }

  .reader-nav-disclosure > summary {
    display: none;
  }

  .reader-nav-disclosure:not([open]) > .reader-nav-inner {
    display: block;
  }

  .reader-nav-inner {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    max-height: calc(100svh - var(--header-height) - 3.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 1.75rem;
    border-right: 1px solid var(--border);
  }

  .reader-nav h2 {
    margin-bottom: .9rem;
    font-size: 2rem;
  }

  .reader-nav > *,
  .reader-nav-inner > p {
    color: var(--text-secondary);
  }

  .reader-nav-inner > p {
    margin-bottom: 2.4rem;
    font-family: var(--font-literary);
    font-size: .92rem;
    line-height: 1.8;
  }

  .volume-list {
    display: grid;
    gap: 1.6rem;
  }

  .volume-nav-group {
    display: grid;
    gap: .7rem;
  }

  .volume-nav-title {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: .65rem;
    align-items: baseline;
  }

  .volume-nav-title span {
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: .82rem;
  }

  .volume-nav-title strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: .95rem;
    font-weight: 600;
  }

  .story-nav-list {
    display: grid;
    gap: .42rem;
    padding-left: 2.65rem;
  }

  .story-nav-list a {
    color: var(--text-muted);
    font-size: .82rem;
    line-height: 1.45;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .story-nav-list a:hover {
    color: var(--accent-strong);
    transform: translateX(3px);
  }

  .reader-content {
    min-width: 0;
  }

  .reader-intro {
    max-width: 820px;
    margin-bottom: 7rem;
  }

  .reader-intro h2 {
    max-width: 720px;
    margin-bottom: 1.6rem;
    font-size: clamp(3rem, 4.6vw, 4.8rem);
  }

  .reader-intro p {
    max-width: 720px;
    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 2;
  }

  .story-volume {
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .story-volume + .story-volume {
    margin-top: 9rem;
  }

  .volume-heading {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 1.1rem;
    align-items: center;
    margin-bottom: 4.8rem;
  }

  .volume-number {
    color: var(--accent-strong);
    font-family: var(--font-literary);
    font-size: .84rem;
    letter-spacing: .1em;
  }

  .volume-heading h2 {
    margin: 0;
    font-size: 2.15rem;
    white-space: nowrap;
  }

  .volume-rule {
    height: 1px;
    background: linear-gradient(90deg, var(--border-strong), transparent);
  }

  .volume-disclosure > summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    width: fit-content;
    margin-bottom: 1.25rem;
    color: var(--text-muted);
    cursor: pointer;
    font-size: .78rem;
    list-style: none;
  }

  .volume-disclosure > summary::-webkit-details-marker {
    display: none;
  }

  .volume-disclosure > summary::after {
    content: '展开';
    color: var(--accent-strong);
    font-weight: 700;
  }

  .volume-disclosure[open] > summary::after {
    content: '收起';
  }

  .story-volume--reader .volume-toggle {
    display: none;
  }

  .story-volume--reader .volume-stories {
    margin-top: 0;
  }

  .story-volume--index + .story-volume--index {
    margin-top: 4.5rem;
  }

  .volume-stories {
    display: grid;
    gap: 9rem;
  }

  .volume-stories--index {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .story-entry {
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .story-entry--index {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), transform var(--transition-fast), background var(--transition-fast);
  }

  .story-entry--index:hover {
    border-color: var(--border-strong);
    background: var(--surface);
    transform: translateY(-2px);
  }

  .story-header {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 760px);
    gap: 1.4rem;
    margin-bottom: 3.4rem;
  }

  .story-order {
    padding-top: .25rem;
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: .88rem;
    letter-spacing: .12em;
  }

  .story-tradition {
    display: inline;
    color: var(--text-muted);
    font-size: .76rem;
    font-weight: 650;
    letter-spacing: .08em;
  }

  .story-classification {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem .85rem;
    align-items: center;
    margin-bottom: .8rem;
  }

  .story-kind {
    color: var(--accent-strong);
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .1em;
  }

  .story-header h3 {
    margin-bottom: .5rem;
    font-size: clamp(2.6rem, 4vw, 4.35rem);
    line-height: 1.08;
  }

  .story-entry--index .story-header {
    grid-template-columns: 2.1rem minmax(0, 1fr);
    gap: .85rem;
    margin-bottom: 1.35rem;
  }

  .story-entry--index .story-header h3 {
    font-size: clamp(1.55rem, 2.3vw, 2.25rem);
    line-height: 1.18;
  }

  .story-entry--index .story-title-en {
    margin-bottom: .9rem;
  }

  .story-entry--index .story-summary {
    margin-bottom: 0;
    font-size: .96rem;
    line-height: 1.8;
  }

  .story-title-en {
    margin-bottom: 1.55rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: .92rem;
    letter-spacing: .08em;
  }

  .story-subtitle {
    margin-bottom: .9rem;
    color: var(--accent-strong);
    font-size: 1.12rem;
  }

  .story-summary {
    max-width: 690px;
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
    font-size: 1.08rem;
    line-height: 1.95;
  }

  .story-meta {
    display: flex;
    gap: 1.35rem;
    color: var(--text-muted);
    font-size: .78rem;
  }

  .story-meta span {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
  }

  .story-preview {
    display: grid;
    gap: 1rem;
    margin-top: auto;
  }

  .story-preview-figure {
    overflow: hidden;
    margin: 0;
    border-radius: var(--radius-md);
    background: var(--surface-muted);
  }

  .story-preview-figure img {
    width: 100%;
    aspect-ratio: 16 / 8.5;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .story-entry--index:hover .story-preview-figure img {
    transform: scale(1.025);
  }

  .story-preview-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-muted);
    font-size: .76rem;
  }

  .story-read-link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: .35rem;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .story-read-link:hover {
    color: var(--text-primary);
  }

  .story-body {
    display: grid;
    grid-template-columns: minmax(0, 760px);
    margin-left: 4.65rem;
  }

  .story-paragraph {
    max-width: 720px;
    margin: 0 0 1.6rem;
    color: var(--text-primary);
    font-size: 1.08rem;
    line-height: 2.08;
    text-align: justify;
    text-wrap: pretty;
  }

  .story-paragraph:first-child::first-letter {
    float: left;
    margin: .16em .16em 0 0;
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: 3.5em;
    line-height: .82;
  }

  .story-section-heading,
  .story-subsection-heading {
    max-width: 720px;
    margin: 3.6rem 0 1.15rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    line-height: 1.25;
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .story-section-heading {
    font-size: clamp(1.45rem, 2.3vw, 2rem);
  }

  .story-subsection-heading {
    font-size: 1.2rem;
  }

  .story-figure {
    margin: 2.5rem 0 3.2rem;
  }

  .story-figure img {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    object-fit: cover;
  }

  .story-figure--wide {
    width: min(980px, 100%);
  }

  .story-figure--wide img {
    aspect-ratio: 16 / 8.6;
  }

  .story-figure--portrait {
    width: min(470px, 64%);
    margin-left: 5.5rem;
  }

  .story-figure--portrait img {
    aspect-ratio: 3 / 4;
  }

  .story-figure--inset {
    width: min(650px, 88%);
    margin-left: 2.8rem;
  }

  .story-figure--inset img {
    max-height: 520px;
  }

  .story-figure figcaption {
    max-width: 640px;
    margin-top: .85rem;
    color: var(--text-muted);
    font-family: var(--font-literary);
    font-size: .82rem;
    line-height: 1.65;
  }

  .story-quote {
    max-width: 680px;
    margin: 2.6rem 0 3rem 2rem;
    padding: .6rem 0 .6rem 1.6rem;
    border-left: 2px solid var(--accent);
  }

  .story-quote p {
    margin-bottom: .7rem;
    color: var(--text-secondary);
    font-family: var(--font-literary);
    font-size: 1.15rem;
    line-height: 1.9;
  }

  .story-quote cite {
    color: var(--text-muted);
    font-size: .78rem;
    font-style: normal;
  }

  .story-relations {
    display: grid;
    grid-template-columns: minmax(220px, .8fr) 1.2fr;
    gap: 2rem;
    margin: 3.4rem 0 0 4.65rem;
    padding: 1.5rem 0;
    border-block: 1px solid var(--border);
  }

  .story-relations-copy p {
    max-width: 320px;
    margin: .55rem 0 0;
    color: var(--text-muted);
    font-family: var(--font-literary);
    font-size: .84rem;
    line-height: 1.7;
  }

  .relation-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .8rem;
  }

  .relation-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: .75rem;
    align-items: center;
    min-height: 68px;
    padding: .85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    transition: border-color var(--transition-fast), transform var(--transition-fast), background var(--transition-fast);
  }

  .relation-link:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    background: var(--surface);
  }

  .relation-link span {
    display: grid;
    gap: .1rem;
  }

  .relation-link small {
    color: var(--text-muted);
    font-size: .68rem;
  }

  .relation-link strong {
    font-family: var(--font-display);
    font-size: .95rem;
  }

  .source-notes {
    margin: 1.2rem 0 0 4.65rem;
    color: var(--text-muted);
  }

  .source-notes summary {
    width: fit-content;
    cursor: pointer;
    font-size: .8rem;
    font-weight: 650;
  }

  .source-notes > div {
    max-width: 720px;
    padding-top: .85rem;

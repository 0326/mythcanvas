---
import { ArrowUpRight } from '@lucide/astro';
import type { Mythology } from '../../lib/content/types';
import { DEFAULT_LOCALE } from '../../lib/i18n/config';
import { localizedPath } from '../../lib/i18n/url';
import {
  cloudflareImageUrl,
  focalPointToCss,
  shouldUseCloudflareImageTransformations,
} from '../../lib/media/cloudflare-images';

interface Props {
  mythology: Mythology;
  index: number;
  featured?: boolean;
}

const { mythology, index, featured = false } = Astro.props;
const locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const isEnglish = locale === 'en';
const useImageTransformations = shouldUseCloudflareImageTransformations(Astro.url, Astro.site);
const focalPoint = mythology.homeHero?.focalPoint;
const focalCss = focalPointToCss(focalPoint);
const fallbackSrc = mythology.heroImage.src;
const lightSrc = mythology.homeHero?.lightSrc ?? fallbackSrc;
const darkSrc = mythology.homeHero?.darkSrc ?? lightSrc;
const imageWidth = featured ? 1800 : 1200;
const imageHeight = featured ? 960 : 760;
const transformOptions = {
  width: imageWidth,
  height: imageHeight,
  fit: 'cover' as const,
  quality: 84,
  format: 'auto' as const,
  focalPoint,
};
const lightImage = cloudflareImageUrl(lightSrc, transformOptions, useImageTransformations) ?? lightSrc;
const darkImage = cloudflareImageUrl(darkSrc, transformOptions, useImageTransformations) ?? darkSrc;
const hasDarkImage = darkImage !== lightImage;
const imageStyle = `--myth-focal-x:${focalCss.x};--myth-focal-y:${focalCss.y}`;
const mythologyHref = localizedPath(locale, `/mythology/${mythology.slug}/`);
---

<article class:list={{ 'myth-card': true, 'myth-card--featured': featured }}>
  <a href={mythologyHref} aria-label={isEnglish ? `Explore ${mythology.name}` : `进入${mythology.name}`}>
    <div class="myth-card-media" style={imageStyle}>
      <img
        class:list={{
          'myth-card-image': true,
          'myth-card-image--light': true,
          'myth-card-image--has-dark': hasDarkImage,
        }}
        src={lightImage}
        alt={mythology.heroImage.alt || (isEnglish ? `${mythology.name} mythology cover` : `${mythology.name}神话世界封面`)}
        width={imageWidth}
        height={imageHeight}
        loading={featured && index === 0 ? 'eager' : 'lazy'}
        fetchpriority={featured && index === 0 ? 'high' : 'auto'}
      />
      {hasDarkImage && (
        <img
          class="myth-card-image myth-card-image--dark"
          src={darkImage}
          alt=""
          width={imageWidth}
          height={imageHeight}
          loading="lazy"
          aria-hidden="true"
        />
      )}
      <div class="myth-card-shade" aria-hidden="true"></div>
    </div>

    <div class="myth-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>

    <div class="myth-card-copy">
      <div class="myth-card-kicker">
        <span>{isEnglish ? 'Mythology' : mythology.nameEn}</span>
        <span class="myth-card-line" aria-hidden="true"></span>
        <span>{mythology.tagline}</span>
      </div>
      <h2>{mythology.name}</h2>
      <p>{mythology.summary}</p>
      <div class="myth-card-footer">
        {!isEnglish && (
          <div class="myth-card-dna" aria-label={`${mythology.name}视觉 DNA`}>
            {mythology.visualDna.motifs.slice(0, 3).map((motif) => <span>{motif}</span>)}
          </div>
        )}
        <span class="myth-card-action" aria-hidden="true">
          {isEnglish ? 'Explore mythology' : '进入神域'}
          <ArrowUpRight size={17} strokeWidth={1.8} />
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .myth-card {
    position: relative;
    min-width: 0;
    min-height: clamp(360px, 34vw, 500px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border-strong) 74%, transparent);
    border-radius: var(--radius-lg);
    background: var(--surface-muted);
    box-shadow: 0 22px 64px color-mix(in srgb, var(--bg-primary) 20%, transparent);
    isolation: isolate;
  }

  .myth-card--featured {
    grid-column: 1 / -1;
    min-height: clamp(480px, 48vw, 700px);
  }

  .myth-card > a {
    position: absolute;
    inset: 0;
    display: block;
    color: white;
  }

  .myth-card > a:hover { color: white; }

  .myth-card-media,
  .myth-card-shade,
  .myth-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .myth-card-media {
    z-index: -2;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .myth-card-image {
    object-fit: cover;
    object-position: var(--myth-focal-x, 50%) var(--myth-focal-y, 50%);
    transition: transform 1.15s cubic-bezier(.2, .7, .2, 1), opacity var(--transition-base), filter var(--transition-base);
  }

  .myth-card-image--dark { opacity: 0; }
  :global([data-theme='dark']) .myth-card-image--light.myth-card-image--has-dark { opacity: 0; }
  :global([data-theme='dark']) .myth-card-image--dark { opacity: 1; }

  .myth-card-shade {
    background:
      linear-gradient(to top, rgba(5, 8, 13, .9) 0%, rgba(5, 8, 13, .56) 30%, rgba(5, 8, 13, .08) 68%, rgba(5, 8, 13, .02) 100%),
      linear-gradient(to right, rgba(5, 8, 13, .36), transparent 58%);
  }

  .myth-card-index {
    position: absolute;
    top: clamp(1.25rem, 2.5vw, 2rem);
    right: clamp(1.25rem, 2.5vw, 2rem);
    color: rgba(255, 255, 255, .76);
    font-family: var(--font-serif);
    font-size: clamp(.78rem, 1vw, .92rem);
    letter-spacing: .18em;
  }

  .myth-card-copy {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: .8rem;
    padding: clamp(1.45rem, 3vw, 2.5rem);
    text-shadow: 0 2px 18px rgba(0, 0, 0, .4);
  }

  .myth-card--featured .myth-card-copy { padding: clamp(1.75rem, 4vw, 3.5rem); }

  .myth-card-kicker {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: .75rem;
    color: rgba(255, 255, 255, .72);
    font-size: .7rem;
    font-weight: 650;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .myth-card-kicker span:first-child,
  .myth-card-kicker span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .myth-card-line { width: 28px; height: 1px; flex: 0 0 auto; background: color-mix(in srgb, white 54%, var(--accent)); }

  h2 {
    margin: 0;
    color: white;
    font-family: var(--font-display, var(--font-serif));
    font-size: clamp(2rem, 3.2vw, 3.45rem);
    font-weight: 620;
    line-height: 1.02;
  }

  .myth-card-copy > p {
    max-width: 48rem;
    margin: 0;
    color: rgba(255, 255, 255, .78);
    line-height: 1.75;
  }

  .myth-card-footer { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .myth-card-dna { display: flex; flex-wrap: wrap; gap: .45rem; }
  .myth-card-dna span { padding: .28rem .56rem; border: 1px solid rgba(255,255,255,.24); border-radius: var(--radius-pill); font-size: .68rem; }
  .myth-card-action { display: inline-flex; align-items: center; gap: .4rem; margin-left: auto; font-size: .82rem; font-weight: 700; }

  .myth-card:hover .myth-card-image,
  .myth-card:focus-within .myth-card-image { transform: scale(1.03); }

  @media (max-width: 680px) {
    .myth-card, .myth-card--featured { min-height: 430px; }
    .myth-card-footer { align-items: flex-start; flex-direction: column; }
    .myth-card-action { margin-left: 0; }
  }
</style>

---
import { ArrowRight } from '@lucide/astro';
import type { Mythology, World, Character } from '../../lib/content/types';
import type { MythStoryVolume } from '../../lib/content/stories';
import { getStoryIllustrationById } from '../../data/story-illustrations';

interface Props {
  mythology: Mythology;
  volume: MythStoryVolume;
  volumeIndex: number;
  characters: Character[];
  worlds: World[];
}

const { mythology, volume, volumeIndex } = Astro.props;
const volumeNumerals = ['壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌'];
const storyHref = (slug: string) => `/mythology/${mythology.slug}/${slug}/`;
---

<section class="norse-volume-panel" data-volume-panel={volume.id} id={`volume-${volume.id}`} aria-labelledby={`volume-title-${volume.id}`}>
  <header class="norse-volume-heading">
    <div class="norse-volume-kicker">
      <span>卷{volumeNumerals[volumeIndex] ?? volumeIndex + 1}</span>
      <span>{String(volumeIndex + 1).padStart(2, '0')}</span>
    </div>
    <h3 id={`volume-title-${volume.id}`}>{volume.title}</h3>
    <p>{volume.stories.length} 篇故事 · 选择左侧章节快速浏览</p>
  </header>

  <div class="norse-story-grid">
    {volume.stories.map((story, storyIndex) => {
      const illustration = story.heroAssetId ? getStoryIllustrationById(story.heroAssetId) : undefined;
      return (
        <article class="norse-story-card">
          <div class="norse-story-card-topline">
            <span>{String(storyIndex + 1).padStart(2, '0')}</span>
            <span>{story.tradition ?? '神话与传说传统'}</span>
          </div>
          <h4><a href={storyHref(story.slug)}>{story.title}</a></h4>
          {story.titleEn && <p class="norse-story-title-en">{story.titleEn}</p>}
          <p class="norse-story-summary">{story.summary}</p>
          <div class="norse-story-card-meta">
            <span>约 {story.readingMinutes ?? 4} 分钟</span>
            <span>{story.sources.length} 条参考来源</span>
          </div>
          {illustration && (
            <a class="norse-story-art" href={storyHref(story.slug)} aria-label={`阅读${story.title}`}>
              <img
                src={illustration.image.src}
                alt={illustration.image.alt}
                width={illustration.image.width}
                height={illustration.image.height}
                loading={volumeIndex === 0 && storyIndex === 0 ? 'eager' : 'lazy'}
              />
              <span class="norse-story-art-link">阅读全文 <ArrowRight size={16} strokeWidth={1.8} aria-hidden="true" /></span>
            </a>
          )}
        </article>
      );
    })}
  </div>
</section>

<style>
  .norse-volume-panel {
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .norse-volume-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: end;
    margin-bottom: 2.25rem;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--border);
  }

  .norse-volume-kicker {
    display: grid;
    gap: .25rem;
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: .82rem;
    letter-spacing: .12em;
    line-height: 1.1;
  }

  .norse-volume-kicker span:last-child {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: .62rem;
    letter-spacing: .16em;
  }

  .norse-volume-heading h3 {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    font-weight: 520;
    line-height: 1.08;
  }

  .norse-volume-heading p {
    margin: 0 0 .2rem;
    color: var(--text-muted);
    font-size: .78rem;
    white-space: nowrap;
  }

  .norse-story-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .norse-story-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1rem, 1.6vw, 1.35rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast);
  }

  .norse-story-card:hover {
    border-color: var(--border-strong);
    background: var(--surface);
    transform: translateY(-2px);
  }

  .norse-story-card-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: var(--text-muted);
    font-size: .68rem;
    letter-spacing: .06em;
  }

  .norse-story-card-topline span:first-child {
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: .86rem;
  }

  .norse-story-card h4 {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.8vw, 1.85rem);
    font-weight: 520;
    line-height: 1.18;
  }

  .norse-story-card h4 a:hover {
    color: var(--accent-strong);
  }

  .norse-story-title-en {
    margin: .45rem 0 .8rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: .76rem;
    letter-spacing: .04em;
  }

  .norse-story-summary {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 0 .9rem;
    color: var(--text-secondary);
    font-family: var(--font-literary);
    font-size: .9rem;
    line-height: 1.75;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .norse-story-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem .9rem;
    margin-top: auto;
    color: var(--text-muted);
    font-size: .7rem;
  }

  .norse-story-art {
    display: block;
    overflow: hidden;
    margin-top: 1rem;
    border-radius: var(--radius-md);
    background: var(--surface-muted);
  }

  .norse-story-art img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8.6;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .norse-story-art:hover img {
    transform: scale(1.025);
  }

  .norse-story-art-link {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: .3rem;
    padding: .7rem .1rem 0;
    color: var(--accent-strong);
    font-size: .76rem;
    font-weight: 700;
  }

  @media (max-width: 1180px) {
    .norse-volume-heading {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .norse-volume-heading p {
      grid-column: 2;
      margin-top: -.8rem;
    }
  }

  @media (max-width: 680px) {
    .norse-volume-heading {
      grid-template-columns: auto 1fr;
      gap: .8rem;
    }

    .norse-volume-heading h3 {
      font-size: 2rem;
    }

    .norse-volume-heading p {
      grid-column: 2;
      white-space: normal;
    }

    .norse-story-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

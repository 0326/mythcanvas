---
import { DEFAULT_LOCALE } from '../lib/i18n/config';
import { localizedPath } from '../lib/i18n/url';
import { getUiMessages } from '../lib/i18n/ui';

const year = new Date().getFullYear();
const locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const messages = getUiMessages(locale);
---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <div class="footer-brand-line">
        <span class="footer-mark" aria-hidden="true">✦</span>
        <strong class="brand-serif">{messages.brand.name}</strong>
      </div>
      <p>{messages.footer.description}</p>
      <nav class="footer-legal" aria-label={messages.footer.legalAria}>
        <a href={localizedPath(locale, '/privacy/')}>{messages.footer.privacy}</a>
        <a href={localizedPath(locale, '/terms/')}>{messages.footer.terms}</a>
        <a href={localizedPath(locale, '/copyright/')}>{messages.footer.copyright}</a>
      </nav>
    </div>

    <nav class="footer-nav" aria-label={messages.footer.navAria}>
      <a href={localizedPath(locale, '/explore/')}>{messages.nav.explore}</a>
      <a href={localizedPath(locale, '/mythology/')}>{messages.nav.mythology}</a>
      <a href={localizedPath(locale, '/world/')}>{messages.nav.worlds}</a>
      <a href={localizedPath(locale, '/character/')}>{messages.nav.characters}</a>
      <a href={localizedPath(locale, '/create/')}>{messages.nav.create}</a>
      <a href={localizedPath(locale, '/my/')}>{messages.nav.my}</a>
    </nav>

    <div class="footer-meta">
      <span>© {year} MythCanvas</span>
      <span>{messages.footer.meta}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-20);
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-secondary) 82%, transparent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(260px, 1.4fr) 1fr auto;
    gap: var(--space-10);
    padding-block: var(--space-12);
    align-items: start;
  }

  .footer-brand-line {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-mark {
    color: var(--accent);
  }

  .footer-brand strong {
    font-size: 1.12rem;
  }

  .footer-brand p {
    max-width: 34rem;
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .footer-legal { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-4); }
  .footer-legal a { color: var(--text-muted); font-size: 0.76rem; }
  .footer-legal a:hover { color: var(--text-primary); }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(80px, 1fr));
    gap: var(--space-3) var(--space-6);
  }

  .footer-nav a {
    color: var(--text-secondary);
    font-size: 0.88rem;
  }

  .footer-meta {
    display: grid;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: 0.78rem;
    text-align: right;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-meta {
      grid-column: 1 / -1;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-meta {
      grid-column: auto;
    }
  }
</style>
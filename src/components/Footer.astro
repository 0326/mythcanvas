---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <div class="footer-brand-line">
        <span class="footer-mark" aria-hidden="true">✦</span>
        <strong class="brand-serif">绘神宇宙 MythCanvas</strong>
      </div>
      <p>用 AI 重现神话世界。探索诸神、神域与传说中的视觉想象。</p>
      <nav class="footer-legal" aria-label="法律与政策">
        <a href="/privacy/">隐私政策</a>
        <a href="/terms/">服务条款</a>
        <a href="/copyright/">版权政策</a>
      </nav>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      <a href="/explore/">探索</a>
      <a href="/mythology/">神话文明</a>
      <a href="/realm/">神域</a>
      <a href="/character/">角色</a>
      <a href="/create/">AI 绘神</a>
      <a href="/my/">我的宇宙</a>
    </nav>

    <div class="footer-meta">
      <span>© {year} MythCanvas</span>
      <span>神话原型 · 原创视觉 · AI 重绘</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-20);
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-secondary) 82%, transparent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(260px, 1.4fr) 1fr auto;
    gap: var(--space-10);
    padding-block: var(--space-12);
    align-items: start;
  }

  .footer-brand-line {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-mark {
    color: var(--accent);
  }

  .footer-brand strong {
    font-size: 1.12rem;
  }

  .footer-brand p {
    max-width: 34rem;
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .footer-legal { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-4); }
  .footer-legal a { color: var(--text-muted); font-size: 0.76rem; }
  .footer-legal a:hover { color: var(--text-primary); }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(80px, 1fr));
    gap: var(--space-3) var(--space-6);
  }

  .footer-nav a {
    color: var(--text-secondary);
    font-size: 0.88rem;
  }

  .footer-meta {
    display: grid;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: 0.78rem;
    text-align: right;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-meta {
      grid-column: 1 / -1;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-meta {
      grid-column: auto;
    }
  }
</style>

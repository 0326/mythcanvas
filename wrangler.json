{
	"name": "mythcanvas",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {
		"AI_GENERATION_MODE": "mock"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mythcanvas-db",
			"database_id": "b6e7fe36-755c-4ec7-a768-855af0a583d7",
			"migrations_dir": "migrations",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "ARTWORKS",
			"bucket_name": "mythcanvas-artworks",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "493f439abeef47b6827f479061d20f6f",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
